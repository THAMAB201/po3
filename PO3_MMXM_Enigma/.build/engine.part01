// @description PO3 MMXM Enigma 1.8 full execution engine with a separate 1,008-case catalog audit resolver. Catalog gating is optional and disabled by default.
library("PO3MMXMEnigmaLib18", overlay = true, dynamic_requests = true)

// Keep the proven 1.5 series-OB / inverse-IMB and management engine on its immutable /1 path.
import SunovaBeach/PO3MMXMEnigmaLib15/1 as enigmaCore
// Publish MMXMCatalogResolver privately as version 1 before publishing this library.
import SunovaBeach/MMXMCatalogResolver/1 as catalog

const string TZ = "America/New_York"
const string NY_SESSION = "0930-1700"
const string ORDER_ID = " "
const string PROTECTION_ID = "PROTECTION"
const int SESSION_OPEN_MINUTE = 570
const int WINDOW_START_MINUTE = 570
const int SESSION_END_MINUTE = 1020
const int FORCE_FLAT_MINUTE = 1010  // 4:50 PM New York; close on the 4:49 bar with process_orders_on_close.
const int PERIOD_MINUTES = 30
const int LAST_WINDOW_START_MINUTE = 990
const int LAST_WINDOW_ID = int(math.floor((LAST_WINDOW_START_MINUTE - WINDOW_START_MINUTE) / float(PERIOD_MINUTES)))
const int MACRO_950_START_MINUTE = 590
const int MACRO_950_END_MINUTE = 610
const int MACRO_950_AUTHORITY_START = 590
const int MACRO_950_TRADE_START = 600
const int NY_AM_END_MINUTE = 690
const int NY_PM_START_MINUTE = 810
const int MACRO_950_TRADE_END = NY_AM_END_MINUTE
const int SESSION_PHASE_NONE = 0
const int SESSION_PHASE_AM = 1
const int SESSION_PHASE_LUNCH = 2
const int SESSION_PHASE_PM = 3
const int MAX_VISUAL_TIMEFRAME_MINUTES = 15
const float BREAK_EVEN_TRIGGER_POINTS = 80.0
const float FIXED_TARGET_POINTS = 500.0
const float PROFITABLE_HOLD_THRESHOLD_POINTS = 50.0
const float FAILED_RECOVERY_PROFIT_POINTS = 100.0
const int FAILED_RECOVERY_CONFIRMATION_BARS = 5
const int REVERSAL_FIRST_WINDOW = 1
const int REVERSAL_SECOND_WINDOW = 2
const int SOURCE_NONE = 0
const int SOURCE_FPI = 1
const int SOURCE_BGOB = 2
const int SOURCE_MACRO_950 = 3
const int SOURCE_FPI_REQUALIFICATION = 4
const int SOURCE_DELAYED_FPI = 5
const int SOURCE_ORDER_BLOCK = 6
const int SOURCE_REVERSAL_FOUNDATION = 7
const int SOURCE_PRIOR_FPI_RETEST = 8
const int SESSION_REGIME_UNRESOLVED = 0
const int SESSION_REGIME_ALIGNED = 1
const int SESSION_REGIME_JUDAS = -1
const int MAX_LEDGER_ROWS = 3

