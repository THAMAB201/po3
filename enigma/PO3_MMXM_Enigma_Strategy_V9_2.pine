//@version=6
strategy(
    "PO3 MMXM Enigma V9.2",
    shorttitle = "PO3ENV92",
    overlay = true,
    max_labels_count = 500,
    max_boxes_count = 500,
    max_lines_count = 500,
    max_bars_back = 150,
    initial_capital = 100000,
    pyramiding = 0,
    process_orders_on_close = true,
    calc_on_order_fills = false,
    calc_on_every_tick = false,
    use_bar_magnifier = true,
    fill_orders_on_standard_ohlc = true,
    default_qty_type = strategy.fixed,
    default_qty_value = 5,
    margin_long = 1,
    margin_short = 1,
    commission_type = strategy.commission.cash_per_contract,
    commission_value = 0
)

import SunovaBeach/PO3MMXMMarketModel/2 as market
import SunovaBeach/PO3MMXMDecisionModel/2 as decision

// =============================================================================
// Inputs
// =============================================================================
string G_ENGINE = "Engine"
bool enableBot = input.bool(true, "Enable Strategy Orders", group = G_ENGINE)
float orderQuantity = input.float(5.0, "Order Quantity", minval = 1.0, step = 1.0, group = G_ENGINE)
bool tradeDecisionSessionsOnly = input.bool(true, "Orders Only During Decision Sessions", group = G_ENGINE)
bool forceFlat = input.bool(true, "Force Flat", group = G_ENGINE)
int forceFlatHour = input.int(16, "Force-Flat Hour", minval = 9, maxval = 17, group = G_ENGINE)
int forceFlatMinute = input.int(50, "Force-Flat Minute", minval = 0, maxval = 59, group = G_ENGINE)

string G_SESSION = "Decision Sessions (New York)"
int amStartHour = input.int(9, "AM Hour", minval = 0, maxval = 23, group = G_SESSION, inline = "AM")
int amStartMinute = input.int(30, "Minute", minval = 0, maxval = 59, group = G_SESSION, inline = "AM")
int lunchStartHour = input.int(11, "Lunch Hour", minval = 0, maxval = 23, group = G_SESSION, inline = "L")
int lunchStartMinute = input.int(30, "Minute", minval = 0, maxval = 59, group = G_SESSION, inline = "L")
int pmStartHour = input.int(13, "PM Hour", minval = 0, maxval = 23, group = G_SESSION, inline = "PM")
int pmStartMinute = input.int(30, "Minute", minval = 0, maxval = 59, group = G_SESSION, inline = "PM")
bool ignoreSessionBoundaryGapFpi = input.bool(false, "Stocks/RTH: Ignore FPI Crossing Session Start", group = G_SESSION)
int macroStartOffsetMinutes = input.int(20, "First Macro Start Offset", minval = 1, maxval = 60, group = G_SESSION)
int macroWindowMinutes = input.int(20, "First Macro Duration", minval = 1, maxval = 60, group = G_SESSION)

string G_RISK = "Risk / Campaign Management"
float maximumStopPoints = input.float(50.0, "Maximum Stop (points)", minval = 0.25, step = 0.25, group = G_RISK)
float deliveryTargetPoints = input.float(150.0, "Delivery Target (points)", minval = 0.25, step = 0.25, group = G_RISK)
bool judasUsesNoFixedTarget = input.bool(true, "Judas Trade Holds Until Later-Window Reversal", group = G_RISK)
bool deliveryUsesFixedTarget = input.bool(true, "Delivery Trade Uses Fixed Target", group = G_RISK)
int structuralBufferTicks = input.int(1, "Structure Stop Buffer (ticks)", minval = 0, maxval = 20, group = G_RISK)

string G_STRUCTURE = "One-Minute Structure Model"
int obSearchBars = input.int(6, "OB Search Bars", minval = 2, maxval = 20, group = G_STRUCTURE)
bool enablePrimaryOb = input.bool(true, "Primary OB Retest", group = G_STRUCTURE)
bool enableGenericImb = input.bool(true, "IMB Retest", group = G_STRUCTURE)
bool enablePostObImb = input.bool(true, "Post-OB IMB Retest", group = G_STRUCTURE)
bool enableBgob = input.bool(true, "BGOB Retest", group = G_STRUCTURE)
bool rejectBgobBeyondMidpoint = input.bool(true, "Reject BGOB Retest Beyond 50%", group = G_STRUCTURE)

string G_PROTOCOL = "Judas / Delivery Protocol"
bool enableJudasTrades = input.bool(true, "Allow Judas Trade Against Session FPI", group = G_PROTOCOL)
bool requireLaterWindowForJudasEnd = input.bool(true, "Judas Ends Only In Later 30m Window", group = G_PROTOCOL)
bool requireValidatedFoundationAndImb = input.bool(true, "Judas End Requires Foundation + IMB Support", group = G_PROTOCOL)
bool allowObAsReversalFoundation = input.bool(true, "OB Can End Judas", group = G_PROTOCOL)
bool allowBgobAsReversalFoundation = input.bool(true, "BGOB Can End Judas", group = G_PROTOCOL)
bool allowPostObAsReversalFoundation = input.bool(true, "Post-OB IMB Can End Judas", group = G_PROTOCOL)
bool allowImbAsReversalFoundation = input.bool(true, "IMB Can End Judas", group = G_PROTOCOL)
bool prioritizeRangeExtreme = input.bool(true, "Prefer Highest Sell / Lowest Buy Structure", group = G_PROTOCOL)
float rangeBandPercent = input.float(50.0, "Extreme Band (%)", minval = 10.0, maxval = 50.0, step = 1.0, group = G_PROTOCOL)

string G_VISUAL = "Visuals"
bool showFpiBoxes = input.bool(true, "Show FPI Boxes", group = G_VISUAL)
bool showStructureBoxes = input.bool(true, "Show OB / IMB / BGOB", group = G_VISUAL)
bool showSignals = input.bool(true, "Show Entry / Exit Labels", group = G_VISUAL)
bool showWindowDividers = input.bool(true, "Show 30m Dividers", group = G_VISUAL)
int zoneTransparency = input.int(86, "Zone Transparency", minval = 60, maxval = 95, group = G_VISUAL)

// =============================================================================
// Constants and helpers
// =============================================================================
int PHASE_WAIT = 0
int PHASE_SESSION = 1
int PHASE_JUDAS = 2
int PHASE_DELIVERY = 3

minuteValue(int h, int m) => h * 60 + m
amStart() => minuteValue(amStartHour, amStartMinute)
lunchStart() => minuteValue(lunchStartHour, lunchStartMinute)
pmStart() => minuteValue(pmStartHour, pmStartMinute)

sessionId(int minuteOfDay) =>
    minuteOfDay >= amStart() and minuteOfDay < lunchStart() ? 0 :
     minuteOfDay >= lunchStart() and minuteOfDay < pmStart() ? 1 :
     minuteOfDay >= pmStart() and minuteOfDay < market.SESSION_END_MINUTE ? 2 : -1

sessionStartMinute(int id) => id == 0 ? amStart() : id == 1 ? lunchStart() : id == 2 ? pmStart() : -1
sessionEndMinute(int id) => id == 0 ? lunchStart() : id == 1 ? pmStart() : id == 2 ? market.SESSION_END_MINUTE : -1
sessionName(int id) => id == 0 ? "AM" : id == 1 ? "LUNCH" : id == 2 ? "PM" : "OFF"
macroStartMinute(int id) => sessionStartMinute(id) >= 0 ? sessionStartMinute(id) + macroStartOffsetMinutes : -1
macroEndMinute(int id) => macroStartMinute(id) >= 0 ? int(math.min(sessionEndMinute(id), macroStartMinute(id) + macroWindowMinutes)) : -1

priceText(float value) => na(value) ? "-" : str.tostring(value, format.mintick)
sideColor(int direction) => direction == market.DIR_LONG ? color.green : direction == market.DIR_SHORT ? color.red : color.gray

windowText(int windowId) =>
    if windowId < 0
        "-"
    else
        int startMinute = market.periodStartMinute(windowId)
        int h = int(math.floor(startMinute / 60.0))
        int m = startMinute % 60
        str.tostring(h, "00") + ":" + str.tostring(m, "00")

newZone(int leftTime, int rightTime, float top, float bottom, int direction, string textValue, int transparency) =>
    box.new(left = leftTime, top = top, right = rightTime, bottom = bottom, xloc = xloc.bar_time, bgcolor = color.new(sideColor(direction), transparency), border_color = color.new(sideColor(direction), math.max(0, transparency - 25)), text = textValue, text_color = color.new(color.white, 20), text_size = size.tiny)

copyStructure(target, source) =>
    target.active := source.active
    target.used := source.used
    target.direction := source.direction
    target.family := source.family
    target.top := source.top
    target.bottom := source.bottom
    target.bodyTop := source.bodyTop
    target.bodyBottom := source.bodyBottom
    target.invalidation := source.invalidation
    target.sourceBar := source.sourceBar
    target.sourceTime := source.sourceTime
    target.sourceWindow := source.sourceWindow
    target.parentId := source.parentId
    target.status := source.status
    target.breakBar := source.breakBar
    target.confirmBar := source.confirmBar
    target.retestCount := source.retestCount
    target.touching := source.touching
    target.ruleId := source.ruleId
    target.reason := source.reason
    0

setFromFpi(target, event, int family, string ruleId, string reason) =>
    market.setStructure(target, event.direction, family, event.top, event.bottom, event.top, event.bottom, event.direction == market.DIR_LONG ? event.bottom : event.top, event.sourceBar, event.sourceTime, event.sourceWindow, event.parentId, market.STATUS_ARMED, ruleId, reason)
    0

chooseHigherPriority(currentSignal, candidateSignal) =>
    result = market.copySignal(currentSignal)
    if candidateSignal.valid and (not currentSignal.valid or decision.familyPriority(candidateSignal.family) > decision.familyPriority(currentSignal.family))
        result := market.copySignal(candidateSignal)
    result

chooseExtreme(currentSignal, candidateSignal, int direction) =>
    result = market.copySignal(currentSignal)
    bool replace = candidateSignal.valid and (not currentSignal.valid or direction == market.DIR_LONG and candidateSignal.bottom < currentSignal.bottom or direction == market.DIR_SHORT and candidateSignal.top > currentSignal.top)
    if replace
        result := market.copySignal(candidateSignal)
    result

updateRetest(structure, int family, string ruleId, string reason) =>
    signal = market.newSignal()
    int eligibleAfter = not na(structure.breakBar) ? structure.breakBar : structure.sourceBar
    if structure.active and not structure.used and structure.status == market.STATUS_ARMED and bar_index > eligibleAfter
        bool invalid = market.bodyCloseInvalidates(structure.direction, structure.invalidation, close)
        bool touch = market.overlaps(structure.top, structure.bottom, high, low)
        bool confirms = structure.direction == market.DIR_LONG ? close > structure.bodyTop : close < structure.bodyBottom
        if invalid
            structure.status := market.STATUS_INVALID
        else if touch and confirms
            structure.status := market.STATUS_CONFIRMED
            structure.confirmBar := bar_index
            signal := market.signalFromStructure(structure, family, true, false, ruleId, reason)
    signal

armMoreExtreme(target, source, int direction) =>
    bool replace = source.active and (not target.active or target.used or target.status == market.STATUS_INVALID or direction == market.DIR_LONG and source.bottom < target.bottom or direction == market.DIR_SHORT and source.top > target.top)
    if replace
        copyStructure(target, source)
        target.status := market.STATUS_ARMED
        target.used := false
        target.confirmBar := na
        target.touching := false
    replace

boundedStop(int direction, float entryPrice, float invalidation) =>
    float fixedStop = direction == market.DIR_LONG ? entryPrice - maximumStopPoints : entryPrice + maximumStopPoints
    float buffered = na(invalidation) ? na : direction == market.DIR_LONG ? invalidation - structuralBufferTicks * syminfo.mintick : invalidation + structuralBufferTicks * syminfo.mintick
    direction == market.DIR_LONG and not na(buffered) and buffered < entryPrice ? math.max(fixedStop, buffered) : direction == market.DIR_SHORT and not na(buffered) and buffered > entryPrice ? math.min(fixedStop, buffered) : fixedStop

// =============================================================================
// Persistent state
// =============================================================================
var sessionFpi = market.newStructure()
var macroFpi = market.newStructure()
var bullOb = market.newStructure()
var bearOb = market.newStructure()
var bullImb = market.newStructure()
var bearImb = market.newStructure()
var postObImb = market.newStructure()
var extremeBuy = market.newStructure()
var extremeSell = market.newStructure()
var judasFoundation = market.newStructure()
var judasSupportImb = market.newStructure()

var array<bool> windowFpiFound = array.new<bool>(market.LAST_WINDOW_ID + 1, false)
var array<int> windowFpiDirection = array.new<int>(market.LAST_WINDOW_ID + 1, market.DIR_NONE)
var array<float> windowFpiTop = array.new<float>(market.LAST_WINDOW_ID + 1, na)
var array<float> windowFpiBottom = array.new<float>(market.LAST_WINDOW_ID + 1, na)

var array<bool> bgobActive = array.new<bool>(market.LAST_WINDOW_ID + 1, false)
var array<bool> bgobUsed = array.new<bool>(market.LAST_WINDOW_ID + 1, false)
var array<int> bgobDirection = array.new<int>(market.LAST_WINDOW_ID + 1, market.DIR_NONE)
var array<float> bgobTop = array.new<float>(market.LAST_WINDOW_ID + 1, na)
var array<float> bgobBottom = array.new<float>(market.LAST_WINDOW_ID + 1, na)
var array<int> bgobSourceBar = array.new<int>(market.LAST_WINDOW_ID + 1, na)
var array<int> bgobSourceTime = array.new<int>(market.LAST_WINDOW_ID + 1, na)
var array<int> bgobStatus = array.new<int>(market.LAST_WINDOW_ID + 1, market.STATUS_EMPTY)
var array<int> bgobBreakBar = array.new<int>(market.LAST_WINDOW_ID + 1, na)

var int activeSessionId = -1
var int activeWindow = -1
var bool sessionFpiFound = false
var bool macroFpiFound = false
var int structuralDirection = market.DIR_NONE
var int phase = PHASE_WAIT
var bool sessionFpiDisrespected = false
var bool judasCompleted = false
var int judasStartBar = na
var int judasStartWindow = -1
var bool judasFoundationValidated = false
var bool judasSupportTouched = false
var bool judasReversalReady = false
var int judasReversalConfirmBar = na
var string phaseStatus = "WAIT SESSION FPI"

var bool parentObActive = false
var int parentObDirection = market.DIR_NONE
var int parentObId = -1
var int parentObRespectBar = na

var bool tradeActive = false
var bool tradeIsJudas = false
var int tradeDirection = market.DIR_NONE
var int tradeEntryWindow = -1
var int tradeEntrySession = -1
var int tradeEntryBar = na
var float tradeEntryPrice = na
var float tradeStop = na
var float tradeTarget = na
var float tradeZoneTop = na
var float tradeZoneBottom = na
var float tradeInvalidation = na
var int tradeFamily = market.FAMILY_NONE
var string activeRule = ""
var string lastAction = "WAIT"
var int observedClosedTrades = 0

var float sessionHigh = na
var float sessionLow = na
var array<box> drawings = array.new<box>()
var array<label> labels = array.new<label>()
var array<line> dividers = array.new<line>()

// =============================================================================
// Time state
// =============================================================================
bool isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
bool confirmedBar = barstate.isconfirmed
int nowMinute = market.minuteOfDay(0)
int currentSession = sessionId(nowMinute)
int currentWindow = market.windowFromMinute(nowMinute)
bool scheduleValid = amStart() < lunchStart() and lunchStart() < pmStart() and pmStart() < market.SESSION_END_MINUTE
bool inDecisionSession = scheduleValid and currentSession >= 0
bool newDecisionSession = inDecisionSession and currentSession != activeSessionId
bool newWindow = inDecisionSession and currentWindow >= 0 and currentWindow != activeWindow
int forceFlatAt = forceFlatHour * 60 + forceFlatMinute

if newDecisionSession
    activeSessionId := currentSession
    activeWindow := currentWindow
    sessionFpi := market.newStructure()
    macroFpi := market.newStructure()
    bullOb := market.newStructure()
    bearOb := market.newStructure()
    bullImb := market.newStructure()
    bearImb := market.newStructure()
    postObImb := market.newStructure()
    extremeBuy := market.newStructure()
    extremeSell := market.newStructure()
    judasFoundation := market.newStructure()
    judasSupportImb := market.newStructure()
    sessionFpiFound := false
    macroFpiFound := false
    structuralDirection := market.DIR_NONE
    phase := PHASE_WAIT
    sessionFpiDisrespected := false
    judasCompleted := false
    judasStartBar := na
    judasStartWindow := -1
    judasFoundationValidated := false
    judasSupportTouched := false
    judasReversalReady := false
    judasReversalConfirmBar := na
    phaseStatus := "WAIT " + sessionName(currentSession) + " SESSION FPI"
    parentObActive := false
    parentObDirection := market.DIR_NONE
    parentObId := -1
    parentObRespectBar := na
    sessionHigh := high
    sessionLow := low
    for i = 0 to market.LAST_WINDOW_ID
        array.set(windowFpiFound, i, false)
        array.set(windowFpiDirection, i, market.DIR_NONE)
        array.set(windowFpiTop, i, na)
        array.set(windowFpiBottom, i, na)
        array.set(bgobActive, i, false)
        array.set(bgobUsed, i, false)
        array.set(bgobDirection, i, market.DIR_NONE)
        array.set(bgobTop, i, na)
        array.set(bgobBottom, i, na)
        array.set(bgobSourceBar, i, na)
        array.set(bgobSourceTime, i, na)
        array.set(bgobStatus, i, market.STATUS_EMPTY)
        array.set(bgobBreakBar, i, na)

if inDecisionSession and not newDecisionSession
    sessionHigh := na(sessionHigh) ? high : math.max(sessionHigh, high)
    sessionLow := na(sessionLow) ? low : math.min(sessionLow, low)

if newWindow
    activeWindow := currentWindow
    if showWindowDividers
        line divider = line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.new(color.gray, 82), style = line.style_dotted)
        array.push(dividers, divider)

// =============================================================================
// Closed trade reconciliation
// =============================================================================
if strategy.closedtrades > observedClosedTrades
    for i = observedClosedTrades to strategy.closedtrades - 1
        float exitPrice = strategy.closedtrades.exit_price(i)
        float sizeValue = strategy.closedtrades.size(i)
        int closedDirection = sizeValue > 0 ? market.DIR_LONG : market.DIR_SHORT
        if showSignals
            label exitLabel = label.new(bar_index, exitPrice, closedDirection == market.DIR_LONG ? "close buy" : "close sell", style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)
            array.push(labels, exitLabel)
    observedClosedTrades := strategy.closedtrades
    if strategy.position_size == 0
        tradeActive := false
        tradeIsJudas := false
        tradeDirection := market.DIR_NONE
        tradeEntryWindow := -1
        tradeEntrySession := -1
        tradeEntryBar := na
        tradeEntryPrice := na
        tradeStop := na
        tradeTarget := na
        tradeZoneTop := na
        tradeZoneBottom := na
        tradeInvalidation := na
        tradeFamily := market.FAMILY_NONE
        activeRule := ""

// =============================================================================
// FPI detection and fixed Session-FPI direction
// =============================================================================
fpiEvent = market.detectFpi()
int firstFpiMinute = fpiEvent.valid ? market.minuteOfDay(2) : -1
int eventSession = fpiEvent.valid ? sessionId(fpiEvent.middleMinute) : -1
int eventSessionStart = sessionStartMinute(eventSession)
bool crossesSessionStart = eventSession >= 0 and firstFpiMinute < eventSessionStart
bool passesGapFilter = not ignoreSessionBoundaryGapFpi or not crossesSessionStart
bool eligibleFpi = isOneMinute and confirmedBar and inDecisionSession and fpiEvent.valid and fpiEvent.sourceWindow >= 0 and eventSession == currentSession and passesGapFilter
bool firstFpiForWindow = eligibleFpi and not array.get(windowFpiFound, fpiEvent.sourceWindow)
bool newWindowFpi = false

if firstFpiForWindow
    newWindowFpi := true
    array.set(windowFpiFound, fpiEvent.sourceWindow, true)
    array.set(windowFpiDirection, fpiEvent.sourceWindow, fpiEvent.direction)
    array.set(windowFpiTop, fpiEvent.sourceWindow, fpiEvent.top)
    array.set(windowFpiBottom, fpiEvent.sourceWindow, fpiEvent.bottom)
    if showFpiBoxes
        int rightTime = time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000
        box fpiBox = newZone(fpiEvent.sourceTime, rightTime, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, windowText(fpiEvent.sourceWindow) + " FPI", zoneTransparency)
        array.push(drawings, fpiBox)
    if enableBgob
        array.set(bgobActive, fpiEvent.sourceWindow, true)
        array.set(bgobUsed, fpiEvent.sourceWindow, false)
        array.set(bgobDirection, fpiEvent.sourceWindow, fpiEvent.direction)
        array.set(bgobTop, fpiEvent.sourceWindow, fpiEvent.thirdHigh)
        array.set(bgobBottom, fpiEvent.sourceWindow, fpiEvent.thirdLow)
        array.set(bgobSourceBar, fpiEvent.sourceWindow, bar_index)
        array.set(bgobSourceTime, fpiEvent.sourceWindow, time)
        array.set(bgobStatus, fpiEvent.sourceWindow, market.STATUS_ARMED)
        array.set(bgobBreakBar, fpiEvent.sourceWindow, na)
        if showStructureBoxes
            box bgobBox = newZone(time, time + (sessionEndMinute(currentSession) - nowMinute) * 60000, fpiEvent.thirdHigh, fpiEvent.thirdLow, fpiEvent.direction, fpiEvent.direction == market.DIR_LONG ? "Bullish BGOB" : "Bearish BGOB", math.max(70, zoneTransparency - 8))
            array.push(drawings, bgobBox)

bool belongsToActiveSession = eligibleFpi and fpiEvent.middleMinute >= sessionStartMinute(currentSession) and fpiEvent.middleMinute < sessionEndMinute(currentSession)
if belongsToActiveSession and not sessionFpiFound
    sessionFpi := market.structureFromFpi(fpiEvent, market.FAMILY_NONE, "SESSION-FPI", "SESSION_FPI")
    sessionFpiFound := true
    structuralDirection := fpiEvent.direction
    phase := PHASE_SESSION
    phaseStatus := "SESSION " + market.sideText(structuralDirection) + " / WAIT STRUCTURE OR JUDAS"
    if showFpiBoxes
        box sessionBox = newZone(fpiEvent.sourceTime, time + (sessionEndMinute(currentSession) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, sessionName(currentSession) + " SESSION FPI", math.max(65, zoneTransparency - 12))
        array.push(drawings, sessionBox)

int activeMacroStart = macroStartMinute(currentSession)
int activeMacroEnd = macroEndMinute(currentSession)
bool belongsToMacro = belongsToActiveSession and activeMacroStart >= 0 and fpiEvent.middleMinute >= activeMacroStart and fpiEvent.middleMinute < activeMacroEnd
if belongsToMacro and not macroFpiFound
    macroFpi := market.structureFromFpi(fpiEvent, market.FAMILY_NONE, "MACRO-FPI", "FIRST_MACRO_FPI")
    macroFpiFound := true
    if showFpiBoxes
        box macroBox = newZone(fpiEvent.sourceTime, time + (sessionEndMinute(currentSession) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, sessionName(currentSession) + " FIRST MACRO FPI", math.max(65, zoneTransparency - 8))
        array.push(drawings, macroBox)

// Session FPI direction never flips during the same decision session.
// A body-close disrespect only starts the temporary opposite Judas campaign.
if sessionFpiFound and not judasCompleted and bar_index > sessionFpi.sourceBar
    bool disrespectNow = market.bodyCloseInvalidates(structuralDirection, structuralDirection == market.DIR_LONG ? sessionFpi.bottom : sessionFpi.top, close)
    if enableJudasTrades and disrespectNow and phase != PHASE_JUDAS
        phase := PHASE_JUDAS
        sessionFpiDisrespected := true
        judasStartBar := bar_index
        judasStartWindow := currentWindow
        judasFoundation := market.newStructure()
        judasSupportImb := market.newStructure()
        judasFoundationValidated := false
        judasSupportTouched := false
        judasReversalReady := false
        phaseStatus := "JUDAS " + market.sideText(-structuralDirection) + " / HOLD UNTIL LATER-WINDOW REVERSAL"

// =============================================================================
// Structure permissions and creation
// =============================================================================
int judasDirection = structuralDirection == market.DIR_NONE ? market.DIR_NONE : -structuralDirection
bool allowStructuralInventory = sessionFpiFound
bool allowJudasInventory = phase == PHASE_JUDAS and not judasCompleted
bool allowBullStructures = allowStructuralInventory and (structuralDirection == market.DIR_LONG or allowJudasInventory and judasDirection == market.DIR_LONG)
bool allowBearStructures = allowStructuralInventory and (structuralDirection == market.DIR_SHORT or allowJudasInventory and judasDirection == market.DIR_SHORT)

bool newBullImb = false
bool newBearImb = false
bool newBullOb = false
bool newBearOb = false
bool newPostOb = false

if eligibleFpi and sessionFpiFound
    if enableGenericImb and fpiEvent.sourceBar != sessionFpi.sourceBar
        if fpiEvent.direction == market.DIR_LONG and allowBullStructures
            candidate = market.structureFromFpi(fpiEvent, market.FAMILY_IMB_RETEST, "IMB-BULL-01", "BULL_IMB")
            newBullImb := armMoreExtreme(bullImb, candidate, market.DIR_LONG)
            if newBullImb and showStructureBoxes
                box imbBox = newZone(fpiEvent.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, market.DIR_LONG, "Bullish IMB", zoneTransparency)
                array.push(drawings, imbBox)
        else if fpiEvent.direction == market.DIR_SHORT and allowBearStructures
            candidate = market.structureFromFpi(fpiEvent, market.FAMILY_IMB_RETEST, "IMB-BEAR-01", "BEAR_IMB")
            newBearImb := armMoreExtreme(bearImb, candidate, market.DIR_SHORT)
            if newBearImb and showStructureBoxes
                box imbBox = newZone(fpiEvent.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, market.DIR_SHORT, "Bearish IMB", zoneTransparency)
                array.push(drawings, imbBox)

    if enablePrimaryOb
        obSeed = market.detectObSeed(fpiEvent.direction, obSearchBars, fpiEvent.sourceWindow)
        if obSeed.active and obSeed.direction == market.DIR_LONG and allowBullStructures
            newBullOb := armMoreExtreme(bullOb, obSeed, market.DIR_LONG)
            if newBullOb and showStructureBoxes
                box obBox = newZone(obSeed.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, obSeed.top, obSeed.bottom, market.DIR_LONG, "Bullish OB", zoneTransparency)
                array.push(drawings, obBox)
        else if obSeed.active and obSeed.direction == market.DIR_SHORT and allowBearStructures
            newBearOb := armMoreExtreme(bearOb, obSeed, market.DIR_SHORT)
            if newBearOb and showStructureBoxes
                box obBox = newZone(obSeed.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, obSeed.top, obSeed.bottom, market.DIR_SHORT, "Bearish OB", zoneTransparency)
                array.push(drawings, obBox)

    if enablePostObImb and parentObActive and fpiEvent.direction == parentObDirection and bar_index > parentObRespectBar
        candidate = market.structureFromFpi(fpiEvent, market.FAMILY_POST_OB_IMB, "POSTOB-01", "POST_OB_IMB")
        if armMoreExtreme(postObImb, candidate, fpiEvent.direction)
            newPostOb := true
            if showStructureBoxes
                box postBox = newZone(fpiEvent.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, "Post-OB IMB", zoneTransparency)
                array.push(drawings, postBox)

    // During Judas, store the lowest/highest IMB of either direction from a later interval.
    // Bullish Session FPI: lowest bullish OR bearish IMB can become support after close above.
    // Bearish Session FPI: highest bullish OR bearish IMB can become resistance after close below.
    if phase == PHASE_JUDAS and fpiEvent.sourceWindow > judasStartWindow
        candidate = market.structureFromFpi(fpiEvent, market.FAMILY_IMB_RETEST, "JUDAS-SUPPORT", "LOWEST_OR_HIGHEST_IMB_SUPPORT")
        bool replaceSupport = not judasSupportImb.active or structuralDirection == market.DIR_LONG and candidate.bottom < judasSupportImb.bottom or structuralDirection == market.DIR_SHORT and candidate.top > judasSupportImb.top
        if replaceSupport
            copyStructure(judasSupportImb, candidate)
            judasSupportImb.status := market.STATUS_ARMED
            judasSupportImb.used := false
            judasSupportTouched := false

// =============================================================================
// Structure signals
// =============================================================================
bullObSignal = market.newSignal()
bearObSignal = market.newSignal()
bullImbSignal = market.newSignal()
bearImbSignal = market.newSignal()
postObSignal = market.newSignal()

if enablePrimaryOb
    bullObSignal := updateRetest(bullOb, market.FAMILY_PRIMARY_OB, "OB-BULL-02", "PRIMARY_BULL_OB_RETEST")
    bearObSignal := updateRetest(bearOb, market.FAMILY_PRIMARY_OB, "OB-BEAR-02", "PRIMARY_BEAR_OB_RETEST")
if enableGenericImb
    bullImbSignal := updateRetest(bullImb, market.FAMILY_IMB_RETEST, "IMB-BULL-02", "BULL_IMB_RETEST")
    bearImbSignal := updateRetest(bearImb, market.FAMILY_IMB_RETEST, "IMB-BEAR-02", "BEAR_IMB_RETEST")
if enablePostObImb
    postObSignal := updateRetest(postObImb, market.FAMILY_POST_OB_IMB, "POSTOB-02", "POST_OB_IMB_RETEST")

primarySignal = chooseHigherPriority(bullObSignal, bearObSignal)
imbSignal = chooseHigherPriority(bullImbSignal, bearImbSignal)

if primarySignal.valid
    parentObActive := true
    parentObDirection := primarySignal.direction
    parentObId := primarySignal.parentId
    parentObRespectBar := bar_index

// BGOB lifecycle for every selected first 30-minute FPI.
bgobSignal = market.newSignal()
if enableBgob and confirmedBar and inDecisionSession
    for w = 0 to market.LAST_WINDOW_ID
        bool active = array.get(bgobActive, w)
        bool used = array.get(bgobUsed, w)
        int direction = array.get(bgobDirection, w)
        float topValue = array.get(bgobTop, w)
        float bottomValue = array.get(bgobBottom, w)
        int sourceBarValue = array.get(bgobSourceBar, w)
        int sourceTimeValue = array.get(bgobSourceTime, w)
        int statusValue = array.get(bgobStatus, w)
        int breakBarValue = array.get(bgobBreakBar, w)
        if active and not used and direction != market.DIR_NONE and not na(sourceBarValue) and bar_index > sourceBarValue
            if statusValue == market.STATUS_ARMED
                bool destroyed = direction == market.DIR_LONG ? low < bottomValue : high > topValue
                bool broken = direction == market.DIR_LONG ? close > topValue : close < bottomValue
                if destroyed
                    array.set(bgobStatus, w, market.STATUS_INVALID)
                    array.set(bgobActive, w, false)
                else if broken
                    array.set(bgobStatus, w, market.STATUS_BROKEN)
                    array.set(bgobBreakBar, w, bar_index)
            else if statusValue == market.STATUS_BROKEN and not na(breakBarValue) and bar_index > breakBarValue
                bool retest = market.overlaps(topValue, bottomValue, high, low)
                float mid = market.midpoint(topValue, bottomValue)
                bool tooDeep = direction == market.DIR_LONG ? low < mid : high > mid
                bool confirms = direction == market.DIR_LONG ? close > topValue and close > open : close < bottomValue and close < open
                if retest and rejectBgobBeyondMidpoint and tooDeep
                    array.set(bgobStatus, w, market.STATUS_INVALID)
                    array.set(bgobActive, w, false)
                else if retest and confirms
                    array.set(bgobStatus, w, market.STATUS_CONFIRMED)
                    candidate = market.makeSignal(direction, market.FAMILY_BGOB, topValue, bottomValue, direction == market.DIR_LONG ? bottomValue : topValue, sourceBarValue, sourceTimeValue, w, sourceTimeValue, true, false, direction == market.DIR_LONG ? "BGOB-BUY" : "BGOB-SELL", direction == market.DIR_LONG ? "BULLISH_BGOB_RETEST_RESPECT" : "BEARISH_BGOB_RETEST_RESPECT")
                    if not bgobSignal.valid or decision.familyPriority(candidate.family) >= decision.familyPriority(bgobSignal.family)
                        bgobSignal := market.copySignal(candidate)

// =============================================================================
// Range-extreme preference
// =============================================================================
if prioritizeRangeExtreme
    if bullObSignal.valid
        armMoreExtreme(extremeBuy, bullOb, market.DIR_LONG)
    if bullImbSignal.valid
        armMoreExtreme(extremeBuy, bullImb, market.DIR_LONG)
    if postObSignal.valid and postObSignal.direction == market.DIR_LONG
        armMoreExtreme(extremeBuy, postObImb, market.DIR_LONG)
    if bearObSignal.valid
        armMoreExtreme(extremeSell, bearOb, market.DIR_SHORT)
    if bearImbSignal.valid
        armMoreExtreme(extremeSell, bearImb, market.DIR_SHORT)
    if postObSignal.valid and postObSignal.direction == market.DIR_SHORT
        armMoreExtreme(extremeSell, postObImb, market.DIR_SHORT)

// =============================================================================
// Judas reversal inventory and 10:55-style reversal
// =============================================================================
alignedFoundationSignal = market.newSignal()
if sessionFpiFound
    if structuralDirection == market.DIR_LONG
        if allowBgobAsReversalFoundation and bgobSignal.valid and bgobSignal.direction == market.DIR_LONG
            alignedFoundationSignal := market.copySignal(bgobSignal)
        else if allowObAsReversalFoundation and bullObSignal.valid
            alignedFoundationSignal := market.copySignal(bullObSignal)
        else if allowPostObAsReversalFoundation and postObSignal.valid and postObSignal.direction == market.DIR_LONG
            alignedFoundationSignal := market.copySignal(postObSignal)
        else if allowImbAsReversalFoundation and bullImbSignal.valid
            alignedFoundationSignal := market.copySignal(bullImbSignal)
    else if structuralDirection == market.DIR_SHORT
        if allowBgobAsReversalFoundation and bgobSignal.valid and bgobSignal.direction == market.DIR_SHORT
            alignedFoundationSignal := market.copySignal(bgobSignal)
        else if allowObAsReversalFoundation and bearObSignal.valid
            alignedFoundationSignal := market.copySignal(bearObSignal)
        else if allowPostObAsReversalFoundation and postObSignal.valid and postObSignal.direction == market.DIR_SHORT
            alignedFoundationSignal := market.copySignal(postObSignal)
        else if allowImbAsReversalFoundation and bearImbSignal.valid
            alignedFoundationSignal := market.copySignal(bearImbSignal)

bool laterThanJudas = phase == PHASE_JUDAS and currentWindow > judasStartWindow
if laterThanJudas and alignedFoundationSignal.valid and alignedFoundationSignal.direction == structuralDirection and alignedFoundationSignal.sourceWindow > judasStartWindow
    market.setStructure(judasFoundation, alignedFoundationSignal.direction, alignedFoundationSignal.family, alignedFoundationSignal.top, alignedFoundationSignal.bottom, alignedFoundationSignal.top, alignedFoundationSignal.bottom, alignedFoundationSignal.invalidation, alignedFoundationSignal.sourceBar, alignedFoundationSignal.sourceTime, alignedFoundationSignal.sourceWindow, alignedFoundationSignal.parentId, market.STATUS_CONFIRMED, alignedFoundationSignal.ruleId, "LATER_WINDOW_ALIGNED_FOUNDATION")
    judasFoundationValidated := true

bool supportTouchNow = phase == PHASE_JUDAS and judasSupportImb.active and currentWindow > judasStartWindow and market.overlaps(judasSupportImb.top, judasSupportImb.bottom, high, low)
if supportTouchNow
    judasSupportTouched := true
bool supportConfirmedNow = phase == PHASE_JUDAS and judasSupportImb.active and currentWindow > judasStartWindow and judasSupportTouched and (structuralDirection == market.DIR_LONG ? close > judasSupportImb.top : close < judasSupportImb.bottom)

bool laterWindowRequirementPasses = not requireLaterWindowForJudasEnd or laterThanJudas
bool foundationRequirementPasses = not requireValidatedFoundationAndImb or judasFoundationValidated and supportConfirmedNow
judasReversalReady := phase == PHASE_JUDAS and laterWindowRequirementPasses and (requireValidatedFoundationAndImb ? foundationRequirementPasses : alignedFoundationSignal.valid and alignedFoundationSignal.direction == structuralDirection)

judasReversalSignal = market.newSignal()
if judasReversalReady and bar_index != judasReversalConfirmBar
    float topValue = judasFoundationValidated ? judasFoundation.top : judasSupportImb.top
    float bottomValue = judasFoundationValidated ? judasFoundation.bottom : judasSupportImb.bottom
    float invalidation = structuralDirection == market.DIR_LONG ? bottomValue : topValue
    int sourceWindowValue = judasFoundationValidated ? judasFoundation.sourceWindow : judasSupportImb.sourceWindow
    judasReversalSignal := market.makeSignal(structuralDirection, market.FAMILY_30M_REVERSAL, topValue, bottomValue, invalidation, bar_index, time, sourceWindowValue, -1, true, true, structuralDirection == market.DIR_LONG ? "JUDAS-END-BUY" : "JUDAS-END-SELL", structuralDirection == market.DIR_LONG ? "LATER_WINDOW_OB_VALIDATED_AND_LOW_IMB_HELD" : "LATER_WINDOW_OB_VALIDATED_AND_HIGH_IMB_HELD")
    judasReversalConfirmBar := bar_index

// =============================================================================
// Ordinary signal selection by phase
// =============================================================================
baseSignal = market.newSignal()
if bgobSignal.valid
    baseSignal := market.copySignal(bgobSignal)
else if primarySignal.valid
    baseSignal := market.copySignal(primarySignal)
else if postObSignal.valid
    baseSignal := market.copySignal(postObSignal)
else if imbSignal.valid
    baseSignal := market.copySignal(imbSignal)

extremeSignal = market.newSignal()
if prioritizeRangeExtreme
    if structuralDirection == market.DIR_LONG and extremeBuy.active and extremeBuy.status == market.STATUS_CONFIRMED
        extremeSignal := market.signalFromStructure(extremeBuy, extremeBuy.family, true, false, "RANGE-BUY", "LOWEST_ALIGNED_STRUCTURE")
    else if structuralDirection == market.DIR_SHORT and extremeSell.active and extremeSell.status == market.STATUS_CONFIRMED
        extremeSignal := market.signalFromStructure(extremeSell, extremeSell.family, true, false, "RANGE-SELL", "HIGHEST_ALIGNED_STRUCTURE")

int permittedDirection = phase == PHASE_JUDAS and not judasCompleted ? judasDirection : structuralDirection
selectedSignal = market.newSignal()
if judasReversalSignal.valid
    selectedSignal := market.copySignal(judasReversalSignal)
else if extremeSignal.valid and extremeSignal.direction == permittedDirection
    selectedSignal := market.copySignal(extremeSignal)
else if baseSignal.valid and baseSignal.direction == permittedDirection
    selectedSignal := market.copySignal(baseSignal)

// Same-direction confirmation validates a held campaign; never pyramid.
if tradeActive and baseSignal.valid and baseSignal.direction == tradeDirection
    if tradeIsJudas
        lastAction := "HOLD JUDAS | " + baseSignal.ruleId
    else
        tradeZoneTop := baseSignal.top
        tradeZoneBottom := baseSignal.bottom
        tradeInvalidation := baseSignal.family == market.FAMILY_BGOB ? (tradeDirection == market.DIR_LONG ? baseSignal.bottom : baseSignal.top) : baseSignal.invalidation
        tradeFamily := baseSignal.family
        activeRule := baseSignal.ruleId
        lastAction := "HOLD DELIVERY | CONTROLLER " + baseSignal.ruleId
    if baseSignal.family == market.FAMILY_BGOB
        for w = 0 to market.LAST_WINDOW_ID
            if array.get(bgobSourceBar, w) == baseSignal.sourceBar and array.get(bgobDirection, w) == baseSignal.direction
                array.set(bgobUsed, w, true)
                array.set(bgobActive, w, false)

// =============================================================================
// Order submission and phase transition
// =============================================================================
bool sessionOrderPermission = not tradeDecisionSessionsOnly or inDecisionSession
bool canSubmit = enableBot and isOneMinute and confirmedBar and sessionOrderPermission and nowMinute < forceFlatAt
bool reversingJudas = tradeActive and tradeIsJudas and judasReversalSignal.valid and judasReversalSignal.direction == -tradeDirection
bool freshEntry = not tradeActive and strategy.position_size == 0

if canSubmit and selectedSignal.valid and (freshEntry or reversingJudas)
    bool entryIsJudas = phase == PHASE_JUDAS and selectedSignal.direction == judasDirection and not judasCompleted and not judasReversalSignal.valid
    bool entryIsDelivery = selectedSignal.direction == structuralDirection and not entryIsJudas
    float entryPrice = close
    float structuralStop = selectedSignal.family == market.FAMILY_BGOB ? (selectedSignal.direction == market.DIR_LONG ? selectedSignal.bottom : selectedSignal.top) : selectedSignal.invalidation
    float stopValue = boundedStop(selectedSignal.direction, entryPrice, structuralStop)
    float targetValue = entryIsJudas and judasUsesNoFixedTarget ? na : entryIsDelivery and deliveryUsesFixedTarget ? (selectedSignal.direction == market.DIR_LONG ? entryPrice + deliveryTargetPoints : entryPrice - deliveryTargetPoints) : na

    strategy.entry("ENIGMA", selectedSignal.direction == market.DIR_LONG ? strategy.long : strategy.short, qty = orderQuantity, comment = selectedSignal.ruleId)
    strategy.exit("SLTP", from_entry = "ENIGMA", stop = stopValue, limit = targetValue, comment_profit = "TP", comment_loss = "SL")

    tradeActive := true
    tradeIsJudas := entryIsJudas
    tradeDirection := selectedSignal.direction
    tradeEntryWindow := currentWindow
    tradeEntrySession := currentSession
    tradeEntryBar := bar_index
    tradeEntryPrice := entryPrice
    tradeStop := stopValue
    tradeTarget := targetValue
    tradeZoneTop := selectedSignal.top
    tradeZoneBottom := selectedSignal.bottom
    tradeInvalidation := structuralStop
    tradeFamily := selectedSignal.family
    activeRule := selectedSignal.ruleId
    lastAction := market.sideText(selectedSignal.direction) + " | " + selectedSignal.ruleId

    if entryIsJudas
        judasStartWindow := currentWindow
        judasStartBar := bar_index
        phaseStatus := "JUDAS ACTIVE " + market.sideText(judasDirection) + " / WAIT LATER 30M REVERSAL"
    if entryIsDelivery
        phase := PHASE_DELIVERY
        judasCompleted := true
        sessionFpiDisrespected := false
        judasReversalReady := false
        phaseStatus := "DELIVERY " + market.sideText(structuralDirection) + " / JUDAS COMPLETE"
        // Once delivery begins, no more counter structures can execute this session.
        if structuralDirection == market.DIR_LONG
            bearOb := market.newStructure()
            bearImb := market.newStructure()
        else
            bullOb := market.newStructure()
            bullImb := market.newStructure()

    if selectedSignal.family == market.FAMILY_PRIMARY_OB
        if selectedSignal.direction == market.DIR_LONG
            bullOb.used := true
        else
            bearOb.used := true
    else if selectedSignal.family == market.FAMILY_IMB_RETEST
        if selectedSignal.direction == market.DIR_LONG
            bullImb.used := true
        else
            bearImb.used := true
    else if selectedSignal.family == market.FAMILY_POST_OB_IMB
        postObImb.used := true
    else if selectedSignal.family == market.FAMILY_BGOB
        for w = 0 to market.LAST_WINDOW_ID
            if array.get(bgobSourceBar, w) == selectedSignal.sourceBar and array.get(bgobDirection, w) == selectedSignal.direction
                array.set(bgobUsed, w, true)
                array.set(bgobActive, w, false)

    if showSignals
        label entryLabel = label.new(bar_index, close, selectedSignal.direction == market.DIR_LONG ? "buy\n" + selectedSignal.ruleId : "sell\n" + selectedSignal.ruleId, style = selectedSignal.direction == market.DIR_LONG ? label.style_label_up : label.style_label_down, color = selectedSignal.direction == market.DIR_LONG ? color.green : color.red, textcolor = color.white, size = size.small)
        array.push(labels, entryLabel)

// =============================================================================
// Position management
// =============================================================================
if tradeActive and bar_index > tradeEntryBar
    if strategy.position_size != 0 and not na(strategy.position_avg_price)
        tradeEntryPrice := strategy.position_avg_price

    strategy.exit("SLTP", from_entry = "ENIGMA", stop = tradeStop, limit = tradeTarget, comment_profit = "TP", comment_loss = "SL")

    // Judas ignores local OB/IMB invalidations. It is held until a later-window
    // reversal foundation confirms, the disaster stop is hit, or the session ends.
    if not tradeIsJudas
        bool controllerDisrespected = market.bodyCloseInvalidates(tradeDirection, tradeInvalidation, close)
        if controllerDisrespected
            strategy.close("ENIGMA", comment = tradeFamily == market.FAMILY_BGOB ? "BGOB_DISRESPECT" : tradeFamily == market.FAMILY_PRIMARY_OB ? "OB_DISRESPECT" : "IMB_DISRESPECT")
            lastAction := "CLOSE | CONTROLLER DISRESPECT"

    // A new decision session does not blindly reverse. Once its Session FPI and
    // a fresh opposite structure confirm, the ordinary selection path may reverse.
    if forceFlat and nowMinute >= forceFlatAt
        strategy.close("ENIGMA", comment = "FORCE_FLAT")
        lastAction := "CLOSE | FORCE_FLAT"

// =============================================================================
// Data window outputs
// =============================================================================
plot(sessionFpiFound ? structuralDirection : na, "Structural Session FPI Direction", display = display.data_window)
plot(phase, "Campaign Phase", display = display.data_window)
plot(sessionFpiFound ? sessionFpi.top : na, "Session FPI Top", display = display.data_window)
plot(sessionFpiFound ? sessionFpi.bottom : na, "Session FPI Bottom", display = display.data_window)
plot(macroFpiFound ? macroFpi.direction : na, "First Macro FPI Direction", display = display.data_window)
plot(judasSupportImb.active ? judasSupportImb.top : na, "Judas Support IMB Top", display = display.data_window)
plot(judasSupportImb.active ? judasSupportImb.bottom : na, "Judas Support IMB Bottom", display = display.data_window)
plot(judasFoundationValidated ? judasFoundation.invalidation : na, "Judas Reversal Foundation Invalidation", display = display.data_window)
plot(tradeActive ? tradeDirection : 0, "Active Trade Direction", display = display.data_window)
plot(tradeActive ? tradeStop : na, "Active Stop", display = display.data_window)
plot(tradeActive ? tradeTarget : na, "Active Target", display = display.data_window)

alertcondition(tradeActive and bar_index == tradeEntryBar and tradeDirection == market.DIR_LONG, "PO3 MMXM Buy", "PO3 MMXM Enigma BUY")
alertcondition(tradeActive and bar_index == tradeEntryBar and tradeDirection == market.DIR_SHORT, "PO3 MMXM Sell", "PO3 MMXM Enigma SELL")
