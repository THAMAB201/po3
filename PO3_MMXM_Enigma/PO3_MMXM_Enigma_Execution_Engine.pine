minuteAt(int offset) => hour(time[offset], TZ) * 60 + minute(time[offset], TZ)

minuteFromTimestamp(int eventTime) => hour(eventTime, TZ) * 60 + minute(eventTime, TZ)

windowIdFromMinute(int minuteOfDay) =>
    minuteOfDay >= WINDOW_START_MINUTE and minuteOfDay < SESSION_END_MINUTE ? math.min(int(math.floor((minuteOfDay - WINDOW_START_MINUTE) / float(PERIOD_MINUTES))), LAST_WINDOW_ID) : -1

windowIdAt(int offset) =>
    windowIdFromMinute(minuteAt(offset))

windowIdFromTimestamp(int eventTime) =>
    windowIdFromMinute(minuteFromTimestamp(eventTime))

sessionPhaseFromMinute(int minuteOfDay) =>
    minuteOfDay >= SESSION_OPEN_MINUTE and minuteOfDay < NY_AM_END_MINUTE ? SESSION_PHASE_AM :
     minuteOfDay >= NY_AM_END_MINUTE and minuteOfDay < NY_PM_START_MINUTE ? SESSION_PHASE_LUNCH :
     minuteOfDay >= NY_PM_START_MINUTE and minuteOfDay < SESSION_END_MINUTE ? SESSION_PHASE_PM :
     SESSION_PHASE_NONE

phaseStartWindow(int phase) =>
    phase == SESSION_PHASE_AM ? 0 : phase == SESSION_PHASE_LUNCH ? 4 : phase == SESSION_PHASE_PM ? 8 : 0

controllerWindowForPhase(int phase) =>
    phase == SESSION_PHASE_AM ? 0 : phase == SESSION_PHASE_PM ? 8 : -1

clockLabel(int totalMinute) =>
    int h24 = int(math.floor(totalMinute / 60.0))
    int mins = totalMinute % 60
    string suffix = h24 >= 12 ? "PM" : "AM"
    int h12 = h24 % 12 == 0 ? 12 : h24 % 12
    str.tostring(h12) + ":" + str.tostring(mins, "00") + " " + suffix

periodStartMinute(int windowId) => WINDOW_START_MINUTE + windowId * PERIOD_MINUTES
periodEndMinute(int windowId) => math.min(SESSION_END_MINUTE, periodStartMinute(windowId) + PERIOD_MINUTES)
periodLabel(int windowId) => clockLabel(periodStartMinute(windowId))
periodRangeLabel(int windowId) => periodLabel(windowId) + "-" + clockLabel(periodEndMinute(windowId))
minuteTimestamp(int totalMinute) => time + (totalMinute - minuteAt(0)) * 60000
minuteTimestampFrom(int anchorTime, int totalMinute) => anchorTime + (totalMinute - minuteFromTimestamp(anchorTime)) * 60000

bullFpi() => close[1] > open[1] and high[2] < low
bearFpi() => close[1] < open[1] and low[2] > high
fpiDirection() => bullFpi() ? 1 : bearFpi() ? -1 : 0
fpiTop() => bullFpi() ? low : bearFpi() ? low[2] : na
fpiBottom() => bullFpi() ? high[2] : bearFpi() ? high : na
positionDirection() => strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
priceText(float price) => na(price) ? "-" : str.tostring(price, format.mintick)
sideText(int dir) => dir == 1 ? "BUY" : dir == -1 ? "SELL" : "-"
closeSideText(int dir) => dir == 1 ? "CLOSE BUY" : dir == -1 ? "CLOSE SELL" : "CLOSE"

fpiBorderColor(int dir) => dir == 1 ? color.new(#2f9e44, 0) : color.new(#c92a2a, 0)
fpiFillColor(int dir, int transparency) => dir == 1 ? color.new(#2f9e44, transparency) : color.new(#c92a2a, transparency)

tradePoints(int dir, float entryPrice, float exitPrice) => dir == 1 ? exitPrice - entryPrice : entryPrice - exitPrice
directionalBodyFor(int dir) => dir == 1 ? close > open : dir == -1 ? close < open : false
fpiFailureBodyConfirmed(int heldDirection, bool requireDirectionalBody) => not requireDirectionalBody or directionalBodyFor(-heldDirection)
isSoftFpiSource(int sourceKind) => sourceKind == SOURCE_FPI or sourceKind == SOURCE_MACRO_950 or sourceKind == SOURCE_FPI_REQUALIFICATION or sourceKind == SOURCE_DELAYED_FPI or sourceKind == SOURCE_PRIOR_FPI_RETEST
signedPointNumber(float points) => na(points) ? "-" : (points > 0 ? "+" : "") + str.tostring(points, format.mintick)
signedPointsText(float points) => signedPointNumber(points) + " PTS"
resultColor(float points) => points > 0 ? color.new(#2b8a3e, 12) : points < 0 ? color.new(#c92a2a, 12) : color.new(#495057, 12)


visualOrderBlockStep(array<float> visualState, int eventTime, float eventOpen, float eventHigh, float eventLow, float eventClose, int anchorDirection) =>
    int signalDirection = 0
    float signalTop = na
    float signalBottom = na
    int signalLeftTime = na
    bool downCloseCandle = eventClose < eventOpen
    bool upCloseCandle = eventClose > eventOpen

    // State slots 0-12 are bullish; 13-25 are the symmetric bearish state.
    bool bullishRunActive = array.get(visualState, 0) == 1.0
    if downCloseCandle
        if not bullishRunActive
            array.set(visualState, 0, 1.0)
            array.set(visualState, 1, eventHigh)
            array.set(visualState, 2, eventLow)
            array.set(visualState, 3, float(eventTime))
        else
            array.set(visualState, 1, math.max(array.get(visualState, 1), eventHigh))
            array.set(visualState, 2, math.min(array.get(visualState, 2), eventLow))
        array.set(visualState, 4, float(eventTime))
    else if bullishRunActive
        float completedTop = array.get(visualState, 1)
        float completedBottom = array.get(visualState, 2)
        bool candidateFound = array.get(visualState, 5) == 1.0
        bool replaceCandidate = not candidateFound or na(array.get(visualState, 7)) or completedBottom < array.get(visualState, 7)
        if replaceCandidate
            array.set(visualState, 5, 1.0)
            array.set(visualState, 6, completedTop)
            array.set(visualState, 7, completedBottom)
            array.set(visualState, 8, array.get(visualState, 3))
            array.set(visualState, 9, array.get(visualState, 4))
            array.set(visualState, 10, 0.0)
            array.set(visualState, 11, na)
            array.set(visualState, 12, 0.0)
        array.set(visualState, 0, 0.0)
        array.set(visualState, 1, na)
        array.set(visualState, 2, na)
        array.set(visualState, 3, na)
        array.set(visualState, 4, na)

    bool bearishRunActive = array.get(visualState, 13) == 1.0
    if upCloseCandle
        if not bearishRunActive
            array.set(visualState, 13, 1.0)
            array.set(visualState, 14, eventHigh)
            array.set(visualState, 15, eventLow)
            array.set(visualState, 16, float(eventTime))
        else
            array.set(visualState, 14, math.max(array.get(visualState, 14), eventHigh))
            array.set(visualState, 15, math.min(array.get(visualState, 15), eventLow))
        array.set(visualState, 17, float(eventTime))
    else if bearishRunActive
        float completedTop = array.get(visualState, 14)
        float completedBottom = array.get(visualState, 15)
        bool candidateFound = array.get(visualState, 18) == 1.0
        bool replaceCandidate = not candidateFound or na(array.get(visualState, 19)) or completedTop > array.get(visualState, 19)
        if replaceCandidate
            array.set(visualState, 18, 1.0)
            array.set(visualState, 19, completedTop)
            array.set(visualState, 20, completedBottom)
            array.set(visualState, 21, array.get(visualState, 16))
            array.set(visualState, 22, array.get(visualState, 17))
            array.set(visualState, 23, 0.0)
            array.set(visualState, 24, na)
            array.set(visualState, 25, 0.0)
        array.set(visualState, 13, 0.0)
        array.set(visualState, 14, na)
        array.set(visualState, 15, na)
        array.set(visualState, 16, na)
        array.set(visualState, 17, na)

    if anchorDirection == 1 and array.get(visualState, 5) == 1.0 and float(eventTime) > array.get(visualState, 9)
        float candidateTop = array.get(visualState, 6)
        float candidateBottom = array.get(visualState, 7)
        bool candidateUsed = array.get(visualState, 12) == 1.0
        bool breakConfirmed = array.get(visualState, 10) == 1.0
        if eventClose < candidateBottom
            array.set(visualState, 5, 0.0)
            array.set(visualState, 10, 0.0)
        else if not candidateUsed
            if not breakConfirmed and eventClose > candidateTop
                array.set(visualState, 10, 1.0)
                array.set(visualState, 11, float(eventTime))
            else if breakConfirmed and float(eventTime) > array.get(visualState, 11)
                bool successfulRetest = eventLow <= candidateTop and eventHigh >= candidateBottom and eventClose > candidateTop
                if successfulRetest
                    array.set(visualState, 12, 1.0)
                    signalDirection := 1
                    signalTop := candidateTop
                    signalBottom := candidateBottom
                    signalLeftTime := int(array.get(visualState, 8))

    if anchorDirection == -1 and array.get(visualState, 18) == 1.0 and float(eventTime) > array.get(visualState, 22)
        float candidateTop = array.get(visualState, 19)
        float candidateBottom = array.get(visualState, 20)
        bool candidateUsed = array.get(visualState, 25) == 1.0
        bool breakConfirmed = array.get(visualState, 23) == 1.0
        if eventClose > candidateTop
            array.set(visualState, 18, 0.0)
            array.set(visualState, 23, 0.0)
        else if not candidateUsed
            if not breakConfirmed and eventClose < candidateBottom
                array.set(visualState, 23, 1.0)
                array.set(visualState, 24, float(eventTime))
            else if breakConfirmed and float(eventTime) > array.get(visualState, 24)
                bool successfulRetest = eventHigh >= candidateBottom and eventLow <= candidateTop and eventClose < candidateBottom
                if successfulRetest
                    array.set(visualState, 25, 1.0)
                    signalDirection := -1
                    signalTop := candidateTop
                    signalBottom := candidateBottom
                    signalLeftTime := int(array.get(visualState, 21))

    [signalDirection, signalTop, signalBottom, signalLeftTime]

addConfluence(array<int> kinds, array<int> sourceBars, array<int> windows, array<float> tops, array<float> bottoms, array<float> boundaries, array<bool> validStates, array<box> structureBoxes, int structureKind, int sourceBar, int sourceWindow, int direction, float structureTop, float structureBottom, box structureBox) =>
    bool alreadyRecorded = false
    int structureCount = array.size(kinds)
    if structureCount > 0
        for structureIndex = 0 to structureCount - 1
            alreadyRecorded := alreadyRecorded or (array.get(kinds, structureIndex) == structureKind and array.get(sourceBars, structureIndex) == sourceBar and array.get(windows, structureIndex) == sourceWindow)
    if not alreadyRecorded and direction != 0 and not na(sourceBar) and not na(structureTop) and not na(structureBottom)
        float holdBoundary = structureKind == SOURCE_BGOB ? (structureTop + structureBottom) / 2.0 : direction == 1 ? structureBottom : structureTop
        array.push(kinds, structureKind)
        array.push(sourceBars, sourceBar)
        array.push(windows, sourceWindow)
        array.push(tops, structureTop)
        array.push(bottoms, structureBottom)
        array.push(boundaries, holdBoundary)
        array.push(validStates, true)
        array.push(structureBoxes, structureBox)
    not alreadyRecorded

confluenceSummary(int anchorDirection, int regime, int validCount, float masterBoundary, array<float> boundaries, array<bool> validStates, bool reversalActive, int reversalDirection, int supportIntervalCount, int resistanceIntervalCount) =>
    string biasName = anchorDirection == 1 ? "BULLISH" : anchorDirection == -1 ? "BEARISH" : "WAITING"
    string regimeName = regime == SESSION_REGIME_ALIGNED ? "ALIGNED" : regime == SESSION_REGIME_JUDAS ? "JUDAS" : "UNRESOLVED"
    string foundationName = anchorDirection == 1 ? "HOLD FLOOR" : anchorDirection == -1 ? "HOLD CEILING" : "FOUNDATION"
    array<float> orderedLevels = array.new<float>(0)
    int structureCount = array.size(boundaries)
    if structureCount > 0
        for structureIndex = 0 to structureCount - 1
            if array.get(validStates, structureIndex)
                array.push(orderedLevels, array.get(boundaries, structureIndex))
    if array.size(orderedLevels) > 1
        array.sort(orderedLevels, anchorDirection == -1 ? order.descending : order.ascending)
    string levelList = "-"
    int distinctCount = 0
    float previousLevel = na
    int orderedCount = array.size(orderedLevels)
    if orderedCount > 0
        levelList := ""
        for levelIndex = 0 to orderedCount - 1
            float currentLevel = array.get(orderedLevels, levelIndex)
            bool distinctLevel = na(previousLevel) or math.abs(currentLevel - previousLevel) > syminfo.mintick * 0.5
            if distinctLevel
                distinctCount += 1
                if distinctCount <= 8
                    levelList += (distinctCount == 1 ? "" : " | ") + priceText(currentLevel)
                previousLevel := currentLevel
        if distinctCount > 8
            levelList += " | +" + str.tostring(distinctCount - 8) + " MORE"
    string orderName = anchorDirection == -1 ? "HIGH TO LOW" : "LOW TO HIGH"
    string reversalText = reversalActive ? " | REVERSAL MODE: " + (reversalDirection == 1 ? "BULLISH" : "BEARISH") : ""
    "SESSION FPI: " + biasName + " | " + regimeName + reversalText + " | " + str.tostring(validCount) + " VALID | " + foundationName + ": " + priceText(masterBoundary) + "\nSUPPORT INTERVALS: " + str.tostring(supportIntervalCount) + " | RESISTANCE INTERVALS: " + str.tostring(resistanceIntervalCount) + "\nCONFLUENCE " + orderName + ": " + levelList


ledgerIndex(int window, int slot) => window * MAX_LEDGER_ROWS + slot

ledgerColumn(array<string> rows, int window, int count, string emptyValue) =>
    string output = count == 0 ? emptyValue : ""
    if count > 0
        for slot = 0 to count - 1
            output += (slot == 0 ? "" : "\n") + array.get(rows, ledgerIndex(window, slot))
    output

dailyTradeCount(LedgerRefs ledger) =>
    int total = 0
    for window = 0 to LAST_WINDOW_ID
        total += array.get(ledger.counts, window)
    total

dailyTradeLogText(LedgerRefs ledger) =>
    string output = "DAILY TRADES\n# | TIME | SIDE | ENTRY | SL | TP/EXIT | PTS"
    int tradeNumber = 0
    for window = 0 to LAST_WINDOW_ID
        int count = array.get(ledger.counts, window)
        if count > 0
            for slot = 0 to count - 1
                int index = ledgerIndex(window, slot)
                tradeNumber += 1
                int entryTimestamp = array.get(ledger.entryTimes, index)
                string entryTimeText = na(entryTimestamp) ? "-" : str.format_time(entryTimestamp, "HH:mm", TZ)
                output += "\n" + str.tostring(tradeNumber) + " | " + entryTimeText + " | " + array.get(ledger.tradeRows, index) + " | " + array.get(ledger.entryRows, index) + " | " + array.get(ledger.slRows, index) + " | " + array.get(ledger.tpRows, index) + " | " + array.get(ledger.resultRows, index)
    if tradeNumber == 0
        output += "\nNO TRADES"
    output

renderLedger(
    LedgerRefs ledger,
    int window,
    bool recordedTradeOpen,
    float recordedEntry,
    float recordedSl,
    bool reversalModeActive,
    int reversalModeDirection,
    int sessionAnchorDirection
) =>
    int count = array.get(ledger.counts, window)
    bool holding = array.get(ledger.holding, window)
    bool pullback = array.get(ledger.pullback, window)
    float windowPoints = array.get(ledger.closedPoints, window)
    bool windowHasOpenTrade = false
    if count > 0
        for slot = 0 to count - 1
            windowHasOpenTrade := windowHasOpenTrade or array.get(ledger.openRows, ledgerIndex(window, slot))
    box tradeCell = array.get(ledger.tradeCells, window)
    box entryCell = array.get(ledger.entryCells, window)
    box slCell = array.get(ledger.slCells, window)
    box tpCell = array.get(ledger.tpCells, window)
    box resultCell = array.get(ledger.resultCells, window)
    string heldEntry = holding and count == 0 and recordedTradeOpen ? priceText(recordedEntry) : "-"
    string heldSl = holding and count == 0 and recordedTradeOpen ? priceText(recordedSl) : "-"
    int displayedBiasDirection = reversalModeActive ? reversalModeDirection : sessionAnchorDirection
    string heldNarrative = holding ? "HOLDING\nMAIN BIAS: " + (displayedBiasDirection == 1 ? "BULLISH" : displayedBiasDirection == -1 ? "BEARISH" : "WAITING") + (reversalModeActive ? "\nREVERSAL MODE" : pullback ? "\nPOTENTIAL PULLBACK INTERVAL" : "") : "-"
    if not na(tradeCell)
        box.set_text(tradeCell, periodLabel(window) + "\nTRADE\n" + ledgerColumn(ledger.tradeRows, window, count, heldNarrative))
    if not na(entryCell)
        box.set_text(entryCell, "ENTRY\n" + ledgerColumn(ledger.entryRows, window, count, heldEntry))
    if not na(slCell)
        box.set_text(slCell, "SL\n" + ledgerColumn(ledger.slRows, window, count, heldSl))
    if not na(tpCell)
        box.set_text(tpCell, "TP\n" + ledgerColumn(ledger.tpRows, window, count, "-"))
    if not na(resultCell)
        box.set_text(resultCell, "PTS " + signedPointNumber(windowPoints) + "\n" + ledgerColumn(ledger.resultRows, window, count, holding ? "HOLDING" : "NO TRADE"))
        box.set_bgcolor(resultCell, (holding or windowHasOpenTrade) and windowPoints == 0 ? color.new(#0b7285, 12) : resultColor(windowPoints))
    0

writeLedgerRow(
    LedgerRefs ledger,
    int window,
    int slot,
    int dir,
    float entryPrice,
    float slPrice,
    float tpPrice,
    float pointResult,
    bool isOpen,
    bool recordedTradeOpen,
    float recordedEntry,
    float recordedSl,
    bool reversalModeActive,
    int reversalModeDirection,
    int sessionAnchorDirection
) =>
    int index = ledgerIndex(window, slot)
    bool wasOpen = array.get(ledger.openRows, index)
    if isOpen and na(array.get(ledger.entryTimes, index))
        array.set(ledger.entryTimes, index, time)
    if not isOpen and wasOpen and not na(pointResult)
        array.set(ledger.closedPoints, window, array.get(ledger.closedPoints, window) + pointResult)
    array.set(ledger.tradeRows, index, sideText(dir))
    array.set(ledger.entryRows, index, priceText(entryPrice))
    array.set(ledger.slRows, index, priceText(slPrice))
    array.set(ledger.tpRows, index, na(tpPrice) and isOpen ? "OPP SIGNAL" : priceText(tpPrice))
    array.set(ledger.resultRows, index, isOpen ? "OPEN" : signedPointNumber(pointResult))
    array.set(ledger.openRows, index, isOpen)
    renderLedger(ledger, window, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)


makeLedgerCell(int left, int right, float top, float bottom, string cellText) =>
    box.new(left=left, top=top, right=right, bottom=bottom, xloc=xloc.bar_time, border_color=color.new(color.black, 0), border_width=1, bgcolor=color.new(#212529, 12), text=cellText, text_size=size.normal, text_color=color.white, text_halign=text.align_center, text_valign=text.align_center, text_font_family=font.family_monospace)


export run(EnigmaConfig cfg) =>
    bool inSession = not na(time(timeframe.period, NY_SESSION, TZ))
    bool isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
    bool isSubMinuteVisualTimeframe = timeframe.isseconds
    bool isHigherVisualTimeframe = timeframe.isminutes and timeframe.multiplier > 1 and timeframe.multiplier <= MAX_VISUAL_TIMEFRAME_MINUTES
    bool isVisualTimeframe = isSubMinuteVisualTimeframe or isOneMinute or isHigherVisualTimeframe

    bool drawStructureVisuals = cfg.showFpiBoxes and not cfg.entriesOnlyMode
    bool drawStructureTags = cfg.showFpiTags and not cfg.entriesOnlyMode
    bool drawPeriodDividers = cfg.showPeriodDividers and not cfg.entriesOnlyMode
    bool drawPeriodTables = cfg.showPeriodTradeTables and not cfg.entriesOnlyMode
    bool drawSessionResults = cfg.showSessionResults and not cfg.entriesOnlyMode
    bool drawConfluenceStatus = cfg.showConfluenceStatus and not cfg.entriesOnlyMode
    bool drawExecutionTriangles = cfg.showExecutionTriangles
    bool drawClosedTradeLines = cfg.showClosedTradeLines

    var stateManager.EnigmaConfig enigmaConfig = stateManager.newConfig(
        cfg.enigmaMinimumExpansionPoints,
        cfg.enigmaExpansionPullbackPoints,
        cfg.enigmaMinimumLegBars,
        cfg.enigmaCautionWarnings,
        cfg.enigmaHardWarnings,
        cfg.enigmaGivebackWatchPoints,
        cfg.enigmaMaximumGivebackPoints,
        cfg.enigmaOpposingConfirmations
    )
    var stateManager.EnigmaState enigmaState = stateManager.newState()
    var stateManager.ObRegistryState obRegistryState = stateManager.newObRegistry(24)

    // Period, FPI, and trade state
    // -----------------------------------------------------------------------------------------------------
    var int stateWindow = -1
    var array<bool> selectedByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> intervalFpiOriginalDirection = array.new<int>(LAST_WINDOW_ID + 1, 0)
    var array<float> intervalFpiTop = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> intervalFpiBottom = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> intervalFpiThreeCandleHigh = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> intervalFpiThreeCandleLow = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<bool> intervalFpiDisrespected = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalFpiRespected = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> intervalFpiFormationBar = array.new<int>(LAST_WINDOW_ID + 1, na)
    var array<bool> intervalFpiPersistentAcceptanceSeen = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> intervalFpiPersistentAcceptanceBar = array.new<int>(LAST_WINDOW_ID + 1, na)
    var array<bool> intervalFpiReversalUsed = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBullStructureValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBearStructureValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBullObValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBearObValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBullImbValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBearImbValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    // Opposing IMB components are reversal confluence, not standalone trade direction.
    // Bullish pair = failed/retested bearish IMB. Bearish pair = failed/retested bullish IMB.
    var array<bool> intervalBullOpposingImbValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBearOpposingImbValidated = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<float> intervalBullStructureTop = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> intervalBullStructureBottom = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> intervalBearStructureTop = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> intervalBearStructureBottom = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<int> intervalBullStructureKind = array.new<int>(LAST_WINDOW_ID + 1, SOURCE_NONE)
    var array<int> intervalBearStructureKind = array.new<int>(LAST_WINDOW_ID + 1, SOURCE_NONE)
    var array<bool> intervalBullEntryUsed = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalBearEntryUsed = array.new<bool>(LAST_WINDOW_ID + 1, false)
    // A completed interval becomes durable support/resistance only after its own FPI
    // and a matching structural foundation have both validated. The most extreme of
    // those two boundaries is frozen as that interval's economic hold authority.
    var array<bool> intervalAuthorityQualified = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> intervalAuthorityValid = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> intervalAuthorityDirection = array.new<int>(LAST_WINDOW_ID + 1, 0)
    var array<float> intervalAuthorityBoundary = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<int> intervalAuthorityKind = array.new<int>(LAST_WINDOW_ID + 1, SOURCE_NONE)
    var array<int> intervalAuthorityQualifiedBar = array.new<int>(LAST_WINDOW_ID + 1, na)
    var array<bool> bgobValidByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> bgobUsedByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> bgobDirectionByWindow = array.new<int>(LAST_WINDOW_ID + 1, 0)
    var array<float> bgobTopByWindow = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> bgobBottomByWindow = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<int> bgobFormationBarByWindow = array.new<int>(LAST_WINDOW_ID + 1, na)
    var array<bool> bgobBreakConfirmedByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> bgobBreakBarByWindow = array.new<int>(LAST_WINDOW_ID + 1, na)
    // A matching IMB fully contained inside a BGOB is retained as an internal trigger.
    // The inner IMB supplies timing; the outer BGOB supplies the governing stop/hold zone.
    var array<bool> nestedBgobImbValidByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> nestedBgobImbUsedByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> nestedBgobImbDirectionByWindow = array.new<int>(LAST_WINDOW_ID + 1, 0)
    var array<float> nestedBgobImbTopByWindow = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> nestedBgobImbBottomByWindow = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> nestedBgobOuterTopByWindow = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<float> nestedBgobOuterBottomByWindow = array.new<float>(LAST_WINDOW_ID + 1, na)
    var array<int> nestedBgobImbFormationBarByWindow = array.new<int>(LAST_WINDOW_ID + 1, na)
    var array<int> nestedBgobImbStartTimeByWindow = array.new<int>(LAST_WINDOW_ID + 1, na)
    var array<bool> nestedBgobImbBreakConfirmedByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<int> nestedBgobImbBreakBarByWindow = array.new<int>(LAST_WINDOW_ID + 1, na)
    var array<box> tradeCellByWindow = array.new<box>(LAST_WINDOW_ID + 1, na)
    var array<box> entryCellByWindow = array.new<box>(LAST_WINDOW_ID + 1, na)
    var array<box> slCellByWindow = array.new<box>(LAST_WINDOW_ID + 1, na)
    var array<box> tpCellByWindow = array.new<box>(LAST_WINDOW_ID + 1, na)
    var array<box> resultCellByWindow = array.new<box>(LAST_WINDOW_ID + 1, na)

    var array<int> ledgerCountByWindow = array.new<int>(LAST_WINDOW_ID + 1, 0)
    var array<string> ledgerTradeRows = array.new<string>((LAST_WINDOW_ID + 1) * MAX_LEDGER_ROWS, "")
    var array<string> ledgerEntryRows = array.new<string>((LAST_WINDOW_ID + 1) * MAX_LEDGER_ROWS, "")
    var array<string> ledgerSlRows = array.new<string>((LAST_WINDOW_ID + 1) * MAX_LEDGER_ROWS, "")
    var array<string> ledgerTpRows = array.new<string>((LAST_WINDOW_ID + 1) * MAX_LEDGER_ROWS, "")
    var array<string> ledgerResultRows = array.new<string>((LAST_WINDOW_ID + 1) * MAX_LEDGER_ROWS, "")
    var array<int> ledgerEntryTimeRows = array.new<int>((LAST_WINDOW_ID + 1) * MAX_LEDGER_ROWS, na)
    var array<bool> ledgerOpenRows = array.new<bool>((LAST_WINDOW_ID + 1) * MAX_LEDGER_ROWS, false)
    var array<float> ledgerClosedPointsByWindow = array.new<float>(LAST_WINDOW_ID + 1, 0.0)
    var array<bool> holdingByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var array<bool> pullbackByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)

    var bool pendingFpi = false
    var int pendingDirection = 0
    var float pendingTop = na
    var float pendingBottom = na
    var int pendingBar = na
    var int pendingWindow = -1
    var box pendingBox = na
    var bool pendingAcceptanceConfirmed = false
    var int pendingAcceptanceBar = na

    var int activeNyPhase = SESSION_PHASE_NONE
    var bool sessionAnchorFpiFound = false
    var int sessionAnchorDirection = 0
    var float sessionAnchorTop = na
    var float sessionAnchorBottom = na
    var int sessionAnchorWindow = -1
    var int sessionAnchorBar = na
    var box sessionAnchorBox = na
    var int sessionFpiRegime = SESSION_REGIME_UNRESOLVED
    var bool sessionAlignmentProvenByLaterFpi = false
    var bool sessionAnchorResolutionComplete = false
    var bool sessionAnchorAcceptanceConfirmed = false
    var int sessionAnchorAcceptanceBar = na

    // The AM 9:30 FPI and PM 1:30 FPI share one opening-window failure rule: close any open trade and wait for
    // the next 30-minute divider. It never performs an immediate same-bar failure reversal.
    var bool openingFpiDisrespectConsumed = false
    var bool openingFpiWindowLock = false
    var int openingFpiLockWindow = -1

    // Every respected same-session structure is retained independently. FPI and
    // order-block boundaries fail on close; BGOB confluence fails on movement beyond 50%.
    var array<int> confluenceKind = array.new<int>(0)
    var array<int> confluenceSourceBar = array.new<int>(0)
    var array<int> confluenceWindow = array.new<int>(0)
    var array<float> confluenceTop = array.new<float>(0)
    var array<float> confluenceBottom = array.new<float>(0)
    var array<float> confluenceBoundary = array.new<float>(0)
    var array<bool> confluenceValid = array.new<bool>(0)
    var array<box> confluenceStructureBox = array.new<box>(0)

    // Bullish session order block = the lowest completed consecutive down-close run.
    // Bearish session order block = the highest completed consecutive up-close run.
    var bool bullishObRunActive = false
    var float bullishObRunTop = na
    var float bullishObRunBottom = na
    var int bullishObRunStartTime = na
    var int bullishObRunEndBar = na
    var bool bullishObCandidateFound = false
    var float bullishObCandidateTop = na
    var float bullishObCandidateBottom = na
    var int bullishObCandidateStartTime = na
    var int bullishObCandidateEndBar = na
    var bool bullishObBreakConfirmed = false
    var int bullishObBreakBar = na
    var bool bullishObCandidateUsed = false

    var bool bearishObRunActive = false
    var float bearishObRunTop = na
    var float bearishObRunBottom = na
    var int bearishObRunStartTime = na
    var int bearishObRunEndBar = na
    var bool bearishObCandidateFound = false
    var float bearishObCandidateTop = na
    var float bearishObCandidateBottom = na
    var int bearishObCandidateStartTime = na
    var int bearishObCandidateEndBar = na
    var bool bearishObBreakConfirmed = false
    var int bearishObBreakBar = na
    var bool bearishObCandidateUsed = false

    // Lowest bullish / highest bearish imbalance discovered inside the active interval.
    var bool bullishImbCandidateFound = false
    var float bullishImbCandidateTop = na
    var float bullishImbCandidateBottom = na
    var int bullishImbFormationBar = na
    var int bullishImbStartTime = na
    var bool bullishImbBreakConfirmed = false
    var int bullishImbBreakBar = na
    var bool bullishImbCandidateUsed = false
    var bool bearishImbCandidateFound = false
    var float bearishImbCandidateTop = na
    var float bearishImbCandidateBottom = na
    var int bearishImbFormationBar = na
    var int bearishImbStartTime = na
    var bool bearishImbBreakConfirmed = false
    var int bearishImbBreakBar = na
    var bool bearishImbCandidateUsed = false

    // Order-independent reversal-pair IMBs.
    // For a bullish foundation, retain the lowest bearish IMB, require a close above it,
    // then a later overlap and another close above. The bearish case is symmetric.
    var bool bullPairBearImbFound = false
    var float bullPairBearImbTop = na
    var float bullPairBearImbBottom = na
    var int bullPairBearImbFormationBar = na
    var int bullPairBearImbStartTime = na
    var int bullPairBearImbWindow = -1
    var bool bullPairBearImbReclaimConfirmed = false
    var int bullPairBearImbReclaimBar = na
    var bool bullPairBearImbUsed = false

    var bool bearPairBullImbFound = false
    var float bearPairBullImbTop = na
    var float bearPairBullImbBottom = na
    var int bearPairBullImbFormationBar = na
    var int bearPairBullImbStartTime = na
    var int bearPairBullImbWindow = -1
    var bool bearPairBullImbReclaimConfirmed = false
    var int bearPairBullImbReclaimBar = na
    var bool bearPairBullImbUsed = false

    var bool activeHasFpi = false
    var bool activeFpiValid = false
    var bool activeProtectionEnabled = false
    var int activeTradeDirection = 0
    var float activeTop = na
    var float activeBottom = na
    var float activeInvalidation = na
    var int activeFpiBar = na
    var box activeFpiBox = na
    var bool activeCanReverse = true
    var int activeSourceKind = SOURCE_NONE
    var int activeSourceWindow = -1
    var int activeRetestCount = 0
    var bool activeTouchedLast = false
    var bool activeSecondRetestConsumed = false

    var bool fpiRequalificationWatch = false
    var int fpiRequalificationDirection = 0
    var float fpiRequalificationTop = na
    var float fpiRequalificationBottom = na
    var int fpiRequalificationWindow = -1
    var int fpiRequalificationBar = na
    var bool fpiRequalificationAcceptanceConfirmed = false
    var int fpiRequalificationAcceptanceBar = na

    var bool macro950Found = false
    var int macro950Direction = 0
    var float macro950Top = na
    var float macro950Bottom = na
    var int macro950FormationBar = na
    var bool macro950InitialSignalUsed = false
    var bool macro950AcceptanceConfirmed = false
    var int macro950AcceptanceBar = na
    var int macro950AuthorityDirection = 0
    var int macro950AuthorityBar = na
    var bool macro950AuthorityRetestConfirmed = false
    var bool macro950OppositeRetestPending = false
    var box macro950Box = na

    // Independent 9:50-10:10 range state lives in the compact catalog library.
    var catalog.MacroRangeState catalogRange = catalog.newMacroRangeState()
    var bool catalogSessionDisrespectedLatched = false
    var label catalogAuditLabel = na

    // The third candle of the 9:50 Macro FPI is retained as a dedicated Macro BGOB.
    // When price closes through its far edge, the candle becomes an opposite-direction
    // breaker. A later retest plus directional close confirms the MMBM/MMSM structure.
    var bool macro950BgobActive = false
    var int macro950BgobOriginalDirection = 0
    var int macro950BgobDirection = 0
    var float macro950BgobTop = na
    var float macro950BgobBottom = na
    var int macro950BgobFormationBar = na
    var int macro950BgobStartTime = na
    var bool macro950BgobFlipConfirmed = false
    var int macro950BgobFlipBar = na
    var bool macro950BgobUsed = false
    var box macro950BgobBox = na

    // Higher-chart visual reconstruction state. Execution remains strictly one-minute;
    // these variables rebuild the one-minute FPI drawings without changing order timing.
    var array<bool> mtfSelectedByWindow = array.new<bool>(LAST_WINDOW_ID + 1, false)
    var bool mtfMacro950Found = false
    var int mtfSessionAnchorDirection = 0
    var array<float> mtfOrderBlockState = array.new<float>(26, na)
    var int mtfLastProcessedTime = na
    var int mtfPrevious2Time = na
    var float mtfPrevious2High = na
    var float mtfPrevious2Low = na
    var int mtfPrevious1Time = na
    var float mtfPrevious1Open = na
    var float mtfPrevious1High = na
    var float mtfPrevious1Low = na
    var float mtfPrevious1Close = na

    var float lastSwingHighClose = na
    var float lastSwingLowClose = na
    var float currentPeriodHighestClose = na
    var float currentPeriodLowestClose = na
    var float frozenPriorSwingHighClose = na
    var float frozenPriorSwingLowClose = na

    var bool delayedFpiReversal = false
    var int delayedFpiDirection = 0
    var float delayedFpiTop = na
    var float delayedFpiBottom = na
    var float delayedFpiBreakLevel = na
    var int delayedFpiWindow = -1
    var int delayedFpiArmedBar = na

    var bool targetWindowLock = false
    var int targetLockWindow = -1

    var float currentPeriodLow = na
    var float sessionPriceLow = na
    var float sessionExtremeHigh = na
    var float sessionExtremeLow = na
    var float sessionClosedPoints = 0.0
    var label sessionResultLabel = na
    var box confluenceStatusBox = na
    var box dailyTradeLogBox = na

    var bool recordedTradeOpen = false
    var int recordedTradeDirection = 0
    var float recordedEntry = na
    var float recordedSl = na
    var float recordedTp = na
    var int recordedWindow = -1
    var int recordedTradePhaseStartWindow = 0
    var int recordedSlot = -1
    var int recordedEntryBar = na
    var int recordedClosedTradesAtEntry = 0
    var float recordedTarget = na
    var float recordedMaxProfitPoints = 0.0
    var bool recordedBreakEvenArmed = false
    var bool recordedEarlyReversal = false
    var bool recordedNarrativeHoldConfirmed = false
    var int recordedOriginKind = SOURCE_NONE
    var float recordedOriginTop = na
    var float recordedOriginBottom = na
    var bool campaignHoldAnchorFound = false
    var int campaignHoldAnchorWindow = -1
    var float campaignHoldAnchorTop = na
    var float campaignHoldAnchorBottom = na
    var bool campaignAnchorSelectionConsumed = false
    var bool campaignReentryWait = false
    var int campaignReentryExitWindow = -1
    var bool campaignReentryAlignedOnly = false
    var bool recoveryTradeWatchEligible = false
    var int recoveryTradeFpiWindow = -1
    var float recoveryTradeFpiTop = na
    var float recoveryTradeFpiBottom = na
    var bool recoveryTradeAcceptanceSeen = false
    var int recoveryTradeAcceptanceBar = na
    var bool failedRecoveryWait = false
    var int failedRecoveryExitWindow = -1
    var bool reversalModeActive = false
    var int reversalModeDirection = 0
    var int reversalModeStartWindow = -1
    var bool reversalOpeningPairConsumed = false
    var bool intervalReentryWait = false
    var int intervalReentryExitWindow = -1
    var int intervalReentryDirection = 0

    // Persistent sequence memory. A reversal foundation is built from a validated
    // counter-FPI OB/IMB pair. The first completed foundation confirmation may enter
    // early at the phase extreme; later controller/Macro reclaim upgrades the hold.
    var bool bullRevFoundationBuilding = false
    var bool bullRevFoundationReady = false
    var bool bullRevFoundationUsed = false
    var bool bullRevFoundationHasOb = false
    var bool bullRevFoundationHasImb = false
    var float bullRevFoundationTop = na
    var float bullRevFoundationBottom = na
    var float bullRevFoundationObTop = na
    var float bullRevFoundationObBottom = na
    var float bullRevFoundationImbTop = na
    var float bullRevFoundationImbBottom = na
    var int bullRevFoundationWindow = -1
    var int bullRevFoundationAgainstFpiWindow = -1
    var int bullRevFoundationConfirmBar = na

    var bool bearRevFoundationBuilding = false
    var bool bearRevFoundationReady = false
    var bool bearRevFoundationUsed = false
    var bool bearRevFoundationHasOb = false
    var bool bearRevFoundationHasImb = false
    var float bearRevFoundationTop = na
    var float bearRevFoundationBottom = na
    var float bearRevFoundationObTop = na
    var float bearRevFoundationObBottom = na
    var float bearRevFoundationImbTop = na
    var float bearRevFoundationImbBottom = na
    var int bearRevFoundationWindow = -1
    var int bearRevFoundationAgainstFpiWindow = -1
    var int bearRevFoundationConfirmBar = na

    var LedgerRefs ledger = LedgerRefs.new(
        ledgerCountByWindow,
        ledgerTradeRows,
        ledgerEntryRows,
        ledgerSlRows,
        ledgerTpRows,
        ledgerResultRows,
        ledgerEntryTimeRows,
        ledgerOpenRows,
        ledgerClosedPointsByWindow,
        holdingByWindow,
        pullbackByWindow,
        tradeCellByWindow,
        entryCellByWindow,
        slCellByWindow,
        tpCellByWindow,
        resultCellByWindow
    )

    // One-bar visual/execution flags.
    bool buyEntryNow = false
    bool sellEntryNow = false
    bool exitNow = false
    int closedDirectionNow = 0
    bool openingFpiLockReleasedNow = false
    bool campaignLegNow = false
    int campaignLegDirection = 0
    float campaignLegPrice = na
    bool selectedFpiNow = false
    int selectedFpiWindow = -1
    int selectedFpiDirection = 0
    float selectedFpiTop = na
    float selectedFpiBottom = na
    bool reversalModeActivatedNow = false
    bool reversalModeReleasedNow = false
    bool drawEntryTriangleNow = false
    int drawEntryTriangleDirection = 0
    float drawEntryTrianglePrice = na
    bool drawExitTriangleNow = false
    int drawExitTriangleDirection = 0
    float drawExitTrianglePrice = na
    int drawClosedTradeEntryBar = na
    float drawClosedTradeEntryPrice = na

    int currentWindow = windowIdAt(0)
    int middleWindow = windowIdAt(1)
    int nowMinute = minuteAt(0)
    int currentNyPhase = sessionPhaseFromMinute(nowMinute)
    bool sessionStart = inSession and not inSession[1]
    bool nyPhaseChanged = inSession and not sessionStart and currentNyPhase != SESSION_PHASE_NONE and currentNyPhase != activeNyPhase
    bool newPeriod = inSession and currentWindow >= 0 and currentWindow != stateWindow
    bool finalTradableBar = inSession and nowMinute == FORCE_FLAT_MINUTE - 1
    bool entryTimeAllowed = inSession and (not cfg.forceFlatBy450 or nowMinute < FORCE_FLAT_MINUTE - 1)
    bool sessionEnded = not inSession and inSession[1]
    bool exactHalfHourBoundary = nowMinute >= SESSION_OPEN_MINUTE and nowMinute <= SESSION_END_MINUTE and (nowMinute - SESSION_OPEN_MINUTE) % PERIOD_MINUTES == 0
    bool exactDividerBar = exactHalfHourBoundary and (not isSubMinuteVisualTimeframe or second(time, TZ) == 0)

    if drawPeriodDividers and isVisualTimeframe and barstate.isconfirmed and exactDividerBar and (inSession or sessionEnded)
        line.new(x1=time, y1=low, x2=time, y2=high, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.black, 0), style=line.style_solid, width=1)

    // Reconstruct the one-minute FPI drawings when the chart itself is 2-15 minutes.
    // This is deliberately visual-only: TradingView strategies still place orders on
    // the chart timeframe, so all economic execution remains restricted to the 1m chart.
    if cfg.showOneMinuteDrawingsThrough15m and isHigherVisualTimeframe
        [oneMinuteTimes, oneMinuteCloseTimes, oneMinuteOpens, oneMinuteHighs, oneMinuteLows, oneMinuteCloses] = request.security_lower_tf(syminfo.tickerid, "1", [time, time_close, open, high, low, close])
        int intrabarCount = array.size(oneMinuteTimes)
        if intrabarCount > 0
            for intrabarIndex = 0 to intrabarCount - 1
                int eventTime = array.get(oneMinuteTimes, intrabarIndex)
                int eventCloseTime = array.get(oneMinuteCloseTimes, intrabarIndex)
                bool eventMinuteConfirmed = barstate.ishistory or eventCloseTime <= timenow
                if eventMinuteConfirmed and (na(mtfLastProcessedTime) or eventTime > mtfLastProcessedTime)
                    float eventOpen = array.get(oneMinuteOpens, intrabarIndex)
                    float eventHigh = array.get(oneMinuteHighs, intrabarIndex)
                    float eventLow = array.get(oneMinuteLows, intrabarIndex)
                    float eventClose = array.get(oneMinuteCloses, intrabarIndex)
                    int eventMinute = minuteFromTimestamp(eventTime)

                    if eventMinute == SESSION_OPEN_MINUTE
                        for visualWindow = 0 to LAST_WINDOW_ID
                            array.set(mtfSelectedByWindow, visualWindow, false)
                        mtfMacro950Found := false
                    if eventMinute == SESSION_OPEN_MINUTE or eventMinute == NY_AM_END_MINUTE or eventMinute == NY_PM_START_MINUTE
                        mtfSessionAnchorDirection := 0
                        array.fill(mtfOrderBlockState, na)

                    if not na(mtfPrevious2Time) and not na(mtfPrevious1Time)
                        bool visualBullFpi = mtfPrevious1Close > mtfPrevious1Open and mtfPrevious2High < eventLow
                        bool visualBearFpi = mtfPrevious1Close < mtfPrevious1Open and mtfPrevious2Low > eventHigh
                        int visualDirection = visualBullFpi ? 1 : visualBearFpi ? -1 : 0
                        int visualMiddleMinute = minuteFromTimestamp(mtfPrevious1Time)
                        int visualWindow = windowIdFromMinute(visualMiddleMinute)
                        float visualTop = visualBullFpi ? eventLow : visualBearFpi ? mtfPrevious2Low : na
                        float visualBottom = visualBullFpi ? mtfPrevious2High : visualBearFpi ? eventHigh : na
                        bool visualMiddleInMacro950 = visualMiddleMinute >= MACRO_950_START_MINUTE and visualMiddleMinute < MACRO_950_END_MINUTE

                        if visualDirection != 0 and visualMiddleInMacro950 and not mtfMacro950Found
                            mtfMacro950Found := true
                            if drawStructureVisuals
                                box.new(left=mtfPrevious2Time, top=visualTop, right=minuteTimestampFrom(eventTime, MACRO_950_TRADE_END), bottom=visualBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(visualDirection), border_width=2, bgcolor=fpiFillColor(visualDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? "9:50-10:10 FPI" + (visualDirection == 1 ? "+" : "-") : "", text_size=size.large, text_color=fpiBorderColor(visualDirection), text_halign=text.align_center, text_valign=text.align_center)

                        bool visualMiddleInExactPeriod = visualWindow >= 0 and visualMiddleMinute >= periodStartMinute(visualWindow) and visualMiddleMinute < periodEndMinute(visualWindow)
                        bool visualFirstFpi = visualMiddleInExactPeriod and visualDirection != 0 and not array.get(mtfSelectedByWindow, visualWindow)
                        if visualFirstFpi
                            array.set(mtfSelectedByWindow, visualWindow, true)
                            int visualPhase = sessionPhaseFromMinute(visualMiddleMinute)
                            if mtfSessionAnchorDirection == 0 and visualWindow == controllerWindowForPhase(visualPhase)
                                mtfSessionAnchorDirection := visualDirection
                            if drawStructureVisuals
                                int visualStartTime = minuteTimestampFrom(eventTime, periodStartMinute(visualWindow))
                                int visualEndTime = minuteTimestampFrom(eventTime, periodEndMinute(visualWindow))
                                int visualLeftTime = math.max(mtfPrevious2Time, visualStartTime)
                                box.new(left=visualLeftTime, top=visualTop, right=visualEndTime, bottom=visualBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(visualDirection), border_width=2, bgcolor=fpiFillColor(visualDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? periodLabel(visualWindow) + " FPI" + (visualDirection == 1 ? "+" : "-") : "", text_size=size.large, text_color=fpiBorderColor(visualDirection), text_halign=text.align_center, text_valign=text.align_center)

                    if eventMinute >= SESSION_OPEN_MINUTE and eventMinute < SESSION_END_MINUTE
                        [visualObDirection, visualObTop, visualObBottom, visualObLeftTime] = visualOrderBlockStep(mtfOrderBlockState, eventTime, eventOpen, eventHigh, eventLow, eventClose, mtfSessionAnchorDirection)
                        if visualObDirection != 0 and drawStructureVisuals
                            box.new(left=visualObLeftTime, top=visualObTop, right=minuteTimestampFrom(eventTime, SESSION_END_MINUTE), bottom=visualObBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(visualObDirection), border_width=2, bgcolor=fpiFillColor(visualObDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? (visualObDirection == 1 ? "BULLISH OB" : "BEARISH OB") : "", text_size=size.large, text_color=fpiBorderColor(visualObDirection), text_halign=text.align_center, text_valign=text.align_center)

                    mtfPrevious2Time := mtfPrevious1Time
                    mtfPrevious2High := mtfPrevious1High
                    mtfPrevious2Low := mtfPrevious1Low
                    mtfPrevious1Time := eventTime
                    mtfPrevious1Open := eventOpen
                    mtfPrevious1High := eventHigh
                    mtfPrevious1Low := eventLow
                    mtfPrevious1Close := eventClose
                    mtfLastProcessedTime := eventTime

    // Seconds charts request the same one-minute source as a higher timeframe. The
    // confirmed minute is processed once, producing geometry identical to the 1m chart.
    if cfg.showOneMinuteDrawingsThrough15m and isSubMinuteVisualTimeframe
        [oneMinuteTime, oneMinuteCloseTime, oneMinuteOpen, oneMinuteHigh, oneMinuteLow, oneMinuteClose] = request.security(syminfo.tickerid, "1", [time, time_close, open, high, low, close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
        bool oneMinuteConfirmed = barstate.ishistory or oneMinuteCloseTime <= timenow
        if oneMinuteConfirmed and not na(oneMinuteTime) and (na(mtfLastProcessedTime) or oneMinuteTime > mtfLastProcessedTime)
            int eventMinute = minuteFromTimestamp(oneMinuteTime)
            if eventMinute == SESSION_OPEN_MINUTE
                for visualWindow = 0 to LAST_WINDOW_ID
                    array.set(mtfSelectedByWindow, visualWindow, false)
                mtfMacro950Found := false
            if eventMinute == SESSION_OPEN_MINUTE or eventMinute == NY_AM_END_MINUTE or eventMinute == NY_PM_START_MINUTE
                mtfSessionAnchorDirection := 0
                array.fill(mtfOrderBlockState, na)

            if not na(mtfPrevious2Time) and not na(mtfPrevious1Time)
                bool visualBullFpi = mtfPrevious1Close > mtfPrevious1Open and mtfPrevious2High < oneMinuteLow
                bool visualBearFpi = mtfPrevious1Close < mtfPrevious1Open and mtfPrevious2Low > oneMinuteHigh
                int visualDirection = visualBullFpi ? 1 : visualBearFpi ? -1 : 0
                int visualMiddleMinute = minuteFromTimestamp(mtfPrevious1Time)
                int visualWindow = windowIdFromMinute(visualMiddleMinute)
                float visualTop = visualBullFpi ? oneMinuteLow : visualBearFpi ? mtfPrevious2Low : na
                float visualBottom = visualBullFpi ? mtfPrevious2High : visualBearFpi ? oneMinuteHigh : na
                bool visualMiddleInMacro950 = visualMiddleMinute >= MACRO_950_START_MINUTE and visualMiddleMinute < MACRO_950_END_MINUTE

                if visualDirection != 0 and visualMiddleInMacro950 and not mtfMacro950Found
                    mtfMacro950Found := true
                    if drawStructureVisuals
                        box.new(left=mtfPrevious2Time, top=visualTop, right=minuteTimestampFrom(oneMinuteTime, MACRO_950_TRADE_END), bottom=visualBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(visualDirection), border_width=2, bgcolor=fpiFillColor(visualDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? "9:50-10:10 FPI" + (visualDirection == 1 ? "+" : "-") : "", text_size=size.large, text_color=fpiBorderColor(visualDirection), text_halign=text.align_center, text_valign=text.align_center)

                bool visualMiddleInExactPeriod = visualWindow >= 0 and visualMiddleMinute >= periodStartMinute(visualWindow) and visualMiddleMinute < periodEndMinute(visualWindow)
                bool visualFirstFpi = visualMiddleInExactPeriod and visualDirection != 0 and not array.get(mtfSelectedByWindow, visualWindow)
                if visualFirstFpi
                    array.set(mtfSelectedByWindow, visualWindow, true)
                    int visualPhase = sessionPhaseFromMinute(visualMiddleMinute)
                    if mtfSessionAnchorDirection == 0 and visualWindow == controllerWindowForPhase(visualPhase)
                        mtfSessionAnchorDirection := visualDirection
                    if drawStructureVisuals
                        int visualStartTime = minuteTimestampFrom(oneMinuteTime, periodStartMinute(visualWindow))
                        int visualEndTime = minuteTimestampFrom(oneMinuteTime, periodEndMinute(visualWindow))
                        int visualLeftTime = math.max(mtfPrevious2Time, visualStartTime)
                        box.new(left=visualLeftTime, top=visualTop, right=visualEndTime, bottom=visualBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(visualDirection), border_width=2, bgcolor=fpiFillColor(visualDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? periodLabel(visualWindow) + " FPI" + (visualDirection == 1 ? "+" : "-") : "", text_size=size.large, text_color=fpiBorderColor(visualDirection), text_halign=text.align_center, text_valign=text.align_center)

            if eventMinute >= SESSION_OPEN_MINUTE and eventMinute < SESSION_END_MINUTE
                [visualObDirection, visualObTop, visualObBottom, visualObLeftTime] = visualOrderBlockStep(mtfOrderBlockState, oneMinuteTime, oneMinuteOpen, oneMinuteHigh, oneMinuteLow, oneMinuteClose, mtfSessionAnchorDirection)
                if visualObDirection != 0 and drawStructureVisuals
                    box.new(left=visualObLeftTime, top=visualObTop, right=minuteTimestampFrom(oneMinuteTime, SESSION_END_MINUTE), bottom=visualObBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(visualObDirection), border_width=2, bgcolor=fpiFillColor(visualObDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? (visualObDirection == 1 ? "BULLISH OB" : "BEARISH OB") : "", text_size=size.large, text_color=fpiBorderColor(visualObDirection), text_halign=text.align_center, text_valign=text.align_center)

            mtfPrevious2Time := mtfPrevious1Time
            mtfPrevious2High := mtfPrevious1High
            mtfPrevious2Low := mtfPrevious1Low
            mtfPrevious1Time := oneMinuteTime
            mtfPrevious1Open := oneMinuteOpen
            mtfPrevious1High := oneMinuteHigh
            mtfPrevious1Low := oneMinuteLow
            mtfPrevious1Close := oneMinuteClose
            mtfLastProcessedTime := oneMinuteTime

    if sessionStart
