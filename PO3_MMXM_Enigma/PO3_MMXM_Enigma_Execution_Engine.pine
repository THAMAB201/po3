//@version=6
// @description Compact PO3 MMXM Enigma execution coordinator. Reuses the version-2 engine and adds local OB-retest plus post-OB directional IMB first-retest entries across every catalog state without exceeding Pine's main-body compilation limit.
library("PO3MMXMEnigmaExecutionEngine", overlay = true, dynamic_requests = true)

// TradingView libraries may import previous versions of themselves. Version 2 remains
// the proven full engine; this compact coordinator adds the corrected foundation path.
import SunovaBeach/PO3MMXMEnigmaExecutionEngine/2 as baseEngine

const string TZ = "America/New_York"
const string NY_SESSION = "0930-1700"
const int NY_OPEN_MINUTE = 570
const int NY_AM_END_MINUTE = 690
const int NY_PM_START_MINUTE = 810
const int NY_CLOSE_MINUTE = 1020
const int FORCE_FLAT_MINUTE = 1010
const float BREAK_EVEN_TRIGGER_POINTS = 80.0
const float FIXED_TARGET_POINTS = 500.0
const string FOUNDATION_ORDER_ID = "ENIGMA FOUNDATION"
const string FOUNDATION_PROTECTION_ID = "ENIGMA FOUNDATION PROTECTION"

export type EnigmaConfig
    bool enableBot
    float orderQuantity
    bool forceFlatBy450
    bool enableSequenceEngine
    bool requireFoundationObImbPair
    bool allowOpposingImbFoundationPair
    bool allowControllerAlignedFoundationEntry
    bool allowEarlyCounterControllerFoundationEntry
    float maximumEarlyFoundationExtensionPoints
    bool requireFreshFoundationSignal
    bool useNestedBgobMidpointConfirmation
    bool allowMacro950FoundationExpectancy
    bool usePhaseExtremeFoundationCandidates
    bool requireAmMacroReclaim
    bool showSequenceStateLabels
    bool enablePriorRespectedFpiReversal
    bool enforcePremiumDiscountEntries
    bool requireDirectionalBodyForFpiFailure
    bool entriesOnlyMode
    bool showFpiBoxes
    int fpiBoxTransparency
    bool showFpiTags
    bool showPeriodDividers
    bool showCleanTradeText
    bool showExecutionTriangles
    bool showClosedTradeLines
    bool showPeriodTradeTables
    bool showSessionResults
    bool showConfluenceStatus
    bool showOneMinuteDrawingsThrough15m
    float tradeTableGap
    float tradeTableHeight
    bool enableEnigmaManagement
    float enigmaMinimumExpansionPoints
    float enigmaExpansionPullbackPoints
    int enigmaMinimumLegBars
    int enigmaCautionWarnings
    int enigmaHardWarnings
    float enigmaGivebackWatchPoints
    float enigmaMaximumGivebackPoints
    int enigmaOpposingConfirmations
    bool requireAuthorityFailureForCautionExit
    bool enableCatalogAudit
    bool enforceCatalogGate
    bool showCatalogAuditLabel

export newConfig(
    bool enableBot,
    float orderQuantity,
    bool forceFlatBy450,
    bool enableSequenceEngine,
    bool requireFoundationObImbPair,
    bool allowOpposingImbFoundationPair,
    bool allowControllerAlignedFoundationEntry,
    bool allowEarlyCounterControllerFoundationEntry,
    float maximumEarlyFoundationExtensionPoints,
    bool requireFreshFoundationSignal,
    bool useNestedBgobMidpointConfirmation,
    bool allowMacro950FoundationExpectancy,
    bool usePhaseExtremeFoundationCandidates,
    bool requireAmMacroReclaim,
    bool showSequenceStateLabels,
    bool enablePriorRespectedFpiReversal,
    bool enforcePremiumDiscountEntries,
    bool requireDirectionalBodyForFpiFailure,
    bool entriesOnlyMode,
    bool showFpiBoxes,
    int fpiBoxTransparency,
    bool showFpiTags,
    bool showPeriodDividers,
    bool showCleanTradeText,
    bool showExecutionTriangles,
    bool showClosedTradeLines,
    bool showPeriodTradeTables,
    bool showSessionResults,
    bool showConfluenceStatus,
    bool showOneMinuteDrawingsThrough15m,
    float tradeTableGap,
    float tradeTableHeight,
    bool enableEnigmaManagement,
    float enigmaMinimumExpansionPoints,
    float enigmaExpansionPullbackPoints,
    int enigmaMinimumLegBars,
    int enigmaCautionWarnings,
    int enigmaHardWarnings,
    float enigmaGivebackWatchPoints,
    float enigmaMaximumGivebackPoints,
    int enigmaOpposingConfirmations,
    bool requireAuthorityFailureForCautionExit,
    bool enableCatalogAudit,
    bool enforceCatalogGate,
    bool showCatalogAuditLabel
) =>
    EnigmaConfig.new(
        enableBot,
        orderQuantity,
        forceFlatBy450,
        enableSequenceEngine,
        requireFoundationObImbPair,
        allowOpposingImbFoundationPair,
        allowControllerAlignedFoundationEntry,
        allowEarlyCounterControllerFoundationEntry,
        maximumEarlyFoundationExtensionPoints,
        requireFreshFoundationSignal,
        useNestedBgobMidpointConfirmation,
        allowMacro950FoundationExpectancy,
        usePhaseExtremeFoundationCandidates,
        requireAmMacroReclaim,
        showSequenceStateLabels,
        enablePriorRespectedFpiReversal,
        enforcePremiumDiscountEntries,
        requireDirectionalBodyForFpiFailure,
        entriesOnlyMode,
        showFpiBoxes,
        fpiBoxTransparency,
        showFpiTags,
        showPeriodDividers,
        showCleanTradeText,
        showExecutionTriangles,
        showClosedTradeLines,
        showPeriodTradeTables,
        showSessionResults,
        showConfluenceStatus,
        showOneMinuteDrawingsThrough15m,
        tradeTableGap,
        tradeTableHeight,
        enableEnigmaManagement,
        enigmaMinimumExpansionPoints,
        enigmaExpansionPullbackPoints,
        enigmaMinimumLegBars,
        enigmaCautionWarnings,
        enigmaHardWarnings,
        enigmaGivebackWatchPoints,
        enigmaMaximumGivebackPoints,
        enigmaOpposingConfirmations,
        requireAuthorityFailureForCautionExit,
        enableCatalogAudit,
        enforceCatalogGate,
        showCatalogAuditLabel
    )

export type EnigmaOutput
    bool buyEntry = false
    bool sellEntry = false
    bool exitSignal = false
    int closedDirection = 0
    bool catalogAvailable = false
    bool catalogDirectionAllowed = true
    int catalogApprovedBias = 0
    int catalogResolvedState = 0
    int catalogTerminalAction = 0
    int catalogSweepEvent = 99
    int catalogStructure = 0
    string catalogSummary = "CATALOG N/A"

type FoundationSignal
    bool buy = false
    bool sell = false
    float zoneTop = na
    float zoneBottom = na
    float obTop = na
    float obBottom = na
    int sourceBar = na

minuteFromTimestamp(int timestamp) =>
    hour(timestamp, TZ) * 60 + minute(timestamp, TZ)

sessionPhase(int minuteOfDay) =>
    minuteOfDay >= NY_OPEN_MINUTE and minuteOfDay < NY_AM_END_MINUTE ? 1 :
     minuteOfDay >= NY_AM_END_MINUTE and minuteOfDay < NY_PM_START_MINUTE ? 2 :
     minuteOfDay >= NY_PM_START_MINUTE and minuteOfDay < NY_CLOSE_MINUTE ? 3 : 0

imbalanceDirection() =>
    bool bullish = bar_index >= 2 and close[1] > open[1] and high[2] < low
    bool bearish = bar_index >= 2 and close[1] < open[1] and low[2] > high
    bullish ? 1 : bearish ? -1 : 0

imbalanceTop(int direction) =>
    direction == 1 ? low : direction == -1 ? low[2] : na

imbalanceBottom(int direction) =>
    direction == 1 ? high[2] : direction == -1 ? high : na

// Detects the additional setup independently from the full engine:
//   1) a consecutive-candle order block validates;
//   2) the lowest/highest IMB formed by or after that confirmation is retained;
//   3) the first later overlap and outside close is the entry confirmation.
// The Session FPI controls direction. A conflicting 9:50 Macro FPI does not cancel
// this structural entry; it remains an early foundation until the Macro later reclaims.
foundationStep(EnigmaConfig cfg) =>
    bool inSession = not na(time(timeframe.period, NY_SESSION, TZ))
    bool oneMinute = timeframe.isminutes and timeframe.multiplier == 1
    int nowMinute = minuteFromTimestamp(time)
    int currentPhase = sessionPhase(nowMinute)
    bool sessionStart = inSession and not inSession[1]

    var int activePhase = 0
    bool phaseChanged = inSession and currentPhase != 0 and currentPhase != activePhase

    var bool controllerFound = false
    var int controllerDirection = 0
    var float phaseHigh = na
    var float phaseLow = na

    var bool bullishRunActive = false
    var float bullishRunTop = na
    var float bullishRunBottom = na
    var int bullishRunEndBar = na
    var bool bullishCandidateFound = false
    var float bullishCandidateTop = na
    var float bullishCandidateBottom = na
    var int bullishCandidateEndBar = na
    var int bullishValidatedCandidateEndBar = na
    var bool bullishObConfirmed = false
    var float bullishObTop = na
    var float bullishObBottom = na
    var int bullishObConfirmBar = na
    var bool bullishObRetested = false

    var bool bearishRunActive = false
    var float bearishRunTop = na
    var float bearishRunBottom = na
    var int bearishRunEndBar = na
    var bool bearishCandidateFound = false
    var float bearishCandidateTop = na
    var float bearishCandidateBottom = na
    var int bearishCandidateEndBar = na
    var int bearishValidatedCandidateEndBar = na
    var bool bearishObConfirmed = false
    var float bearishObTop = na
    var float bearishObBottom = na
    var int bearishObConfirmBar = na
    var bool bearishObRetested = false

    var bool bullishImbFound = false
    var int bullishImbDirection = 0
    var float bullishImbTop = na
    var float bullishImbBottom = na
    var int bullishImbFormationBar = na
    var bool bullishImbUsed = false

    var bool bearishImbFound = false
    var int bearishImbDirection = 0
    var float bearishImbTop = na
    var float bearishImbBottom = na
    var int bearishImbFormationBar = na
    var bool bearishImbUsed = false

    if sessionStart or phaseChanged
        activePhase := currentPhase
        controllerFound := false
        controllerDirection := 0
        phaseHigh := high
        phaseLow := low

        bullishRunActive := false
        bullishRunTop := na
        bullishRunBottom := na
        bullishRunEndBar := na
        bullishCandidateFound := false
        bullishCandidateTop := na
        bullishCandidateBottom := na
        bullishCandidateEndBar := na
        bullishValidatedCandidateEndBar := na
        bullishObConfirmed := false
        bullishObTop := na
        bullishObBottom := na
        bullishObConfirmBar := na
        bullishObRetested := false
        bullishImbFound := false
        bullishImbDirection := 0
        bullishImbTop := na
        bullishImbBottom := na
        bullishImbFormationBar := na
        bullishImbUsed := false

        bearishRunActive := false
        bearishRunTop := na
        bearishRunBottom := na
        bearishRunEndBar := na
        bearishCandidateFound := false
        bearishCandidateTop := na
        bearishCandidateBottom := na
        bearishCandidateEndBar := na
        bearishValidatedCandidateEndBar := na
        bearishObConfirmed := false
        bearishObTop := na
        bearishObBottom := na
        bearishObConfirmBar := na
        bearishObRetested := false
        bearishImbFound := false
        bearishImbDirection := 0
        bearishImbTop := na
        bearishImbBottom := na
        bearishImbFormationBar := na
        bearishImbUsed := false

    bool buySignal = false
    bool sellSignal = false
    float signalZoneTop = na
    float signalZoneBottom = na
    float signalObTop = na
    float signalObBottom = na
    int signalSourceBar = na

    if cfg.enableBot and cfg.enableSequenceEngine and oneMinute and inSession and barstate.isconfirmed
        phaseHigh := na(phaseHigh) ? high : math.max(phaseHigh, high)
        phaseLow := na(phaseLow) ? low : math.min(phaseLow, low)

        int imbalanceDir = imbalanceDirection()
        float currentImbTop = imbalanceTop(imbalanceDir)
        float currentImbBottom = imbalanceBottom(imbalanceDir)
        int middleMinute = bar_index >= 2 ? minuteFromTimestamp(time[1]) : -1

        if not controllerFound and imbalanceDir != 0 and sessionPhase(middleMinute) == currentPhase
            controllerFound := true
            controllerDirection := imbalanceDir

        bool bearishBody = close < open
        bool bullishBody = close > open

        // Every newly completed down-close run can become the active local bullish OB.
        if bearishBody
            if not bullishRunActive
                bullishRunActive := true
                bullishRunTop := high
                bullishRunBottom := low
            else
                bullishRunTop := math.max(bullishRunTop, high)
                bullishRunBottom := math.min(bullishRunBottom, low)
            bullishRunEndBar := bar_index
        else if bullishRunActive
            bullishCandidateFound := true
            bullishCandidateTop := bullishRunTop
            bullishCandidateBottom := bullishRunBottom
            bullishCandidateEndBar := bullishRunEndBar
            bullishRunActive := false
            bullishRunTop := na
            bullishRunBottom := na
            bullishRunEndBar := na

        // Every newly completed up-close run can become the active local bearish OB.
        if bullishBody
            if not bearishRunActive
                bearishRunActive := true
                bearishRunTop := high
                bearishRunBottom := low
            else
                bearishRunTop := math.max(bearishRunTop, high)
                bearishRunBottom := math.min(bearishRunBottom, low)
            bearishRunEndBar := bar_index
        else if bearishRunActive
            bearishCandidateFound := true
            bearishCandidateTop := bearishRunTop
            bearishCandidateBottom := bearishRunBottom
            bearishCandidateEndBar := bearishRunEndBar
            bearishRunActive := false
            bearishRunTop := na
            bearishRunBottom := na
            bearishRunEndBar := na

        bool bullishObValidationNow = bullishCandidateFound and bullishCandidateEndBar != bullishValidatedCandidateEndBar and close > bullishCandidateTop
        if bullishObValidationNow
            bullishValidatedCandidateEndBar := bullishCandidateEndBar
            bullishObConfirmed := true
            bullishObTop := bullishCandidateTop
            bullishObBottom := bullishCandidateBottom
            bullishObConfirmBar := bar_index
            bullishObRetested := false
            bullishImbFound := false
            bullishImbDirection := 0
            bullishImbTop := na
            bullishImbBottom := na
            bullishImbFormationBar := na
            bullishImbUsed := false

        bool bearishObValidationNow = bearishCandidateFound and bearishCandidateEndBar != bearishValidatedCandidateEndBar and close < bearishCandidateBottom
        if bearishObValidationNow
            bearishValidatedCandidateEndBar := bearishCandidateEndBar
            bearishObConfirmed := true
            bearishObTop := bearishCandidateTop
            bearishObBottom := bearishCandidateBottom
            bearishObConfirmBar := bar_index
            bearishObRetested := false
            bearishImbFound := false
            bearishImbDirection := 0
            bearishImbTop := na
            bearishImbBottom := na
            bearishImbFormationBar := na
            bearishImbUsed := false

        bool bullishObRetestNow = bullishObConfirmed and not bullishObRetested and bar_index > bullishObConfirmBar and low <= bullishObTop and high >= bullishObBottom and close > bullishObTop
        if bullishObRetestNow
            bullishObRetested := true

        bool bearishObRetestNow = bearishObConfirmed and not bearishObRetested and bar_index > bearishObConfirmBar and high >= bearishObBottom and low <= bearishObTop and close < bearishObBottom
        if bearishObRetestNow
            bearishObRetested := true

        // After the local OB has validated and successfully retested, retain the lowest
        // bullish IMB or highest bearish IMB created afterward.
        if imbalanceDir == 1 and bullishObConfirmed and bullishObRetested and not na(bullishObConfirmBar) and bar_index > bullishObConfirmBar
            bool replaceLowestImb = not bullishImbFound or currentImbBottom < bullishImbBottom
            if replaceLowestImb
                bullishImbFound := true
                bullishImbDirection := imbalanceDir
                bullishImbTop := currentImbTop
                bullishImbBottom := currentImbBottom
                bullishImbFormationBar := bar_index
                bullishImbUsed := false

        if imbalanceDir == -1 and bearishObConfirmed and bearishObRetested and not na(bearishObConfirmBar) and bar_index > bearishObConfirmBar
            bool replaceHighestImb = not bearishImbFound or currentImbTop > bearishImbTop
            if replaceHighestImb
                bearishImbFound := true
                bearishImbDirection := imbalanceDir
                bearishImbTop := currentImbTop
                bearishImbBottom := currentImbBottom
                bearishImbFormationBar := bar_index
                bearishImbUsed := false

        bool bullishZoneOverlap = bullishImbFound and low <= bullishImbTop and high >= bullishImbBottom
        bool bullishOutsideClose = bullishImbFound and close > bullishImbTop
        bool bullishComponentsRespected = bullishObConfirmed and bullishObRetested and close >= bullishObBottom and close >= bullishImbBottom
        bool bullishControllerAligned = controllerFound and controllerDirection == 1
        bool bullishDirectionEnabled = bullishControllerAligned ? cfg.allowControllerAlignedFoundationEntry : cfg.allowEarlyCounterControllerFoundationEntry
        bool bullishRetestNow = bullishImbFound and not bullishImbUsed and bar_index > bullishImbFormationBar and bullishZoneOverlap and bullishOutsideClose

        if bullishDirectionEnabled and bullishRetestNow and bullishComponentsRespected
            bullishImbUsed := true
            buySignal := true
            signalZoneTop := bullishImbTop
            signalZoneBottom := bullishImbBottom
            signalObTop := bullishObTop
            signalObBottom := bullishObBottom
            signalSourceBar := bullishImbFormationBar

        bool bearishZoneOverlap = bearishImbFound and high >= bearishImbBottom and low <= bearishImbTop
        bool bearishOutsideClose = bearishImbFound and close < bearishImbBottom
        bool bearishComponentsRespected = bearishObConfirmed and bearishObRetested and close <= bearishObTop and close <= bearishImbTop
        bool bearishControllerAligned = controllerFound and controllerDirection == -1
        bool bearishDirectionEnabled = bearishControllerAligned ? cfg.allowControllerAlignedFoundationEntry : cfg.allowEarlyCounterControllerFoundationEntry
        bool bearishRetestNow = bearishImbFound and not bearishImbUsed and bar_index > bearishImbFormationBar and bearishZoneOverlap and bearishOutsideClose

        if bearishDirectionEnabled and bearishRetestNow and bearishComponentsRespected
            bearishImbUsed := true
            sellSignal := true
            signalZoneTop := bearishImbTop
            signalZoneBottom := bearishImbBottom
            signalObTop := bearishObTop
            signalObBottom := bearishObBottom
            signalSourceBar := bearishImbFormationBar

    FoundationSignal.new(buySignal, sellSignal, signalZoneTop, signalZoneBottom, signalObTop, signalObBottom, signalSourceBar)

export run(EnigmaConfig cfg) =>
    baseEngine.EnigmaConfig baseConfig = baseEngine.newConfig(
        cfg.enableBot,
        cfg.orderQuantity,
        cfg.forceFlatBy450,
        cfg.enableSequenceEngine,
        cfg.requireFoundationObImbPair,
        cfg.allowOpposingImbFoundationPair,
        cfg.allowControllerAlignedFoundationEntry,
        cfg.allowEarlyCounterControllerFoundationEntry,
        cfg.maximumEarlyFoundationExtensionPoints,
        cfg.requireFreshFoundationSignal,
        cfg.useNestedBgobMidpointConfirmation,
        cfg.allowMacro950FoundationExpectancy,
        cfg.usePhaseExtremeFoundationCandidates,
        cfg.requireAmMacroReclaim,
        cfg.showSequenceStateLabels,
        cfg.enablePriorRespectedFpiReversal,
        cfg.enforcePremiumDiscountEntries,
        cfg.requireDirectionalBodyForFpiFailure,
        cfg.entriesOnlyMode,
        cfg.showFpiBoxes,
        cfg.fpiBoxTransparency,
        cfg.showFpiTags,
        cfg.showPeriodDividers,
        cfg.showCleanTradeText,
        cfg.showExecutionTriangles,
        cfg.showClosedTradeLines,
        cfg.showPeriodTradeTables,
        cfg.showSessionResults,
        cfg.showConfluenceStatus,
        cfg.showOneMinuteDrawingsThrough15m,
        cfg.tradeTableGap,
        cfg.tradeTableHeight,
        cfg.enableEnigmaManagement,
        cfg.enigmaMinimumExpansionPoints,
        cfg.enigmaExpansionPullbackPoints,
        cfg.enigmaMinimumLegBars,
        cfg.enigmaCautionWarnings,
        cfg.enigmaHardWarnings,
        cfg.enigmaGivebackWatchPoints,
        cfg.enigmaMaximumGivebackPoints,
        cfg.enigmaOpposingConfirmations,
        cfg.requireAuthorityFailureForCautionExit,
        cfg.enableCatalogAudit,
        cfg.enforceCatalogGate,
        cfg.showCatalogAuditLabel
    )

    baseEngine.EnigmaOutput baseSignals = baseEngine.run(baseConfig)
    FoundationSignal foundation = foundationStep(cfg)

    var bool foundationTradeActive = false
    var bool foundationFillSeen = false
    var int foundationDirection = 0
    var int foundationEntryBar = na
    var float foundationEntryPrice = na
    var float foundationInitialStop = na
    var float foundationWorkingStop = na
    var float foundationTarget = na

    bool supplementalBuyNow = false
    bool supplementalSellNow = false
    bool supplementalExitNow = false
    int supplementalClosedDirection = 0

    bool baseOrderNow = baseSignals.buyEntry or baseSignals.sellEntry or baseSignals.exitSignal
    bool flatBeforeCloseProcessing = strategy.position_size == 0 and not foundationTradeActive

    if cfg.enableBot and flatBeforeCloseProcessing and not baseOrderNow
        if foundation.buy
            foundationEntryPrice := close
            foundationInitialStop := math.min(foundation.obBottom, foundation.zoneBottom) - syminfo.mintick
            foundationWorkingStop := foundationInitialStop
            foundationTarget := foundationEntryPrice + FIXED_TARGET_POINTS
            foundationDirection := 1
            foundationEntryBar := bar_index
            foundationTradeActive := true
            foundationFillSeen := false
            strategy.entry(FOUNDATION_ORDER_ID, strategy.long, qty = cfg.orderQuantity, comment = "BUY FOUNDATION")
            strategy.exit(FOUNDATION_PROTECTION_ID, FOUNDATION_ORDER_ID, stop = foundationWorkingStop, limit = foundationTarget)
            supplementalBuyNow := true
            if cfg.showCleanTradeText
                label.new(bar_index, low, "BUY\nPOST-OB IMB", style = label.style_label_up, color = color.new(#198754, 0), textcolor = color.white, size = size.small)
        else if foundation.sell
            foundationEntryPrice := close
            foundationInitialStop := math.max(foundation.obTop, foundation.zoneTop) + syminfo.mintick
            foundationWorkingStop := foundationInitialStop
            foundationTarget := foundationEntryPrice - FIXED_TARGET_POINTS
            foundationDirection := -1
            foundationEntryBar := bar_index
            foundationTradeActive := true
            foundationFillSeen := false
            strategy.entry(FOUNDATION_ORDER_ID, strategy.short, qty = cfg.orderQuantity, comment = "SELL FOUNDATION")
            strategy.exit(FOUNDATION_PROTECTION_ID, FOUNDATION_ORDER_ID, stop = foundationWorkingStop, limit = foundationTarget)
            supplementalSellNow := true
            if cfg.showCleanTradeText
                label.new(bar_index, high, "SELL\nPOST-OB IMB", style = label.style_label_down, color = color.new(#c92a2a, 0), textcolor = color.white, size = size.small)

    if foundationTradeActive
        if foundationDirection == 1 and strategy.position_size > 0
            foundationFillSeen := true
            if high - foundationEntryPrice >= BREAK_EVEN_TRIGGER_POINTS
                foundationWorkingStop := math.max(foundationWorkingStop, foundationEntryPrice)
            strategy.exit(FOUNDATION_PROTECTION_ID, FOUNDATION_ORDER_ID, stop = foundationWorkingStop, limit = foundationTarget)
        else if foundationDirection == -1 and strategy.position_size < 0
            foundationFillSeen := true
            if foundationEntryPrice - low >= BREAK_EVEN_TRIGGER_POINTS
                foundationWorkingStop := math.min(foundationWorkingStop, foundationEntryPrice)
            strategy.exit(FOUNDATION_PROTECTION_ID, FOUNDATION_ORDER_ID, stop = foundationWorkingStop, limit = foundationTarget)

        int nowMinute = minuteFromTimestamp(time)
        if cfg.forceFlatBy450 and nowMinute >= FORCE_FLAT_MINUTE - 1
            strategy.close(FOUNDATION_ORDER_ID, comment = "FORCE FLAT")

        if foundationFillSeen and strategy.position_size == 0 and bar_index > foundationEntryBar
            supplementalExitNow := true
            supplementalClosedDirection := foundationDirection
            foundationTradeActive := false
            foundationFillSeen := false
            foundationDirection := 0
            foundationEntryBar := na
            foundationEntryPrice := na
            foundationInitialStop := na
            foundationWorkingStop := na
            foundationTarget := na

    EnigmaOutput.new(
        baseSignals.buyEntry or supplementalBuyNow,
        baseSignals.sellEntry or supplementalSellNow,
        baseSignals.exitSignal or supplementalExitNow,
        supplementalExitNow ? supplementalClosedDirection : baseSignals.closedDirection,
        baseSignals.catalogAvailable,
        baseSignals.catalogDirectionAllowed,
        baseSignals.catalogApprovedBias,
        baseSignals.catalogResolvedState,
        baseSignals.catalogTerminalAction,
        baseSignals.catalogSweepEvent,
        baseSignals.catalogStructure,
        baseSignals.catalogSummary
    )
