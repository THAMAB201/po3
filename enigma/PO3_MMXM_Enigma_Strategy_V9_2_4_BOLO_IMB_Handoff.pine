//@version=6
strategy(
    "PO3 MMXM Enigma V9.2.4 BOLO IMB Handoff",
    shorttitle = "PO3E924H",
    overlay = true,
    max_labels_count = 500,
    max_boxes_count = 500,
    max_lines_count = 500,
    max_bars_back = 150,
    initial_capital = 100000,
    pyramiding = 0,
    process_orders_on_close = true,
    calc_on_order_fills = false,
    calc_on_every_tick = false,
    use_bar_magnifier = true,
    fill_orders_on_standard_ohlc = true,
    default_qty_type = strategy.fixed,
    default_qty_value = 5,
    margin_long = 1,
    margin_short = 1,
    commission_type = strategy.commission.cash_per_contract,
    commission_value = 0
)

import SunovaBeach/PO3MMXMMarketModel/3 as market
import SunovaBeach/PO3MMXMDecisionModel/2 as decision

// =============================================================================
// Inputs
// =============================================================================
string G_ENGINE = "Engine"
bool enableBot = input.bool(true, "Enable Strategy Orders", group = G_ENGINE)
float orderQuantity = input.float(5.0, "Order Quantity", minval = 1.0, step = 1.0, group = G_ENGINE)
bool tradeDecisionSessionsOnly = input.bool(true, "Orders Only During Decision Sessions", group = G_ENGINE)
bool forceFlat = input.bool(true, "Force Flat", group = G_ENGINE)
int forceFlatHour = input.int(16, "Force-Flat Hour", minval = 9, maxval = 17, group = G_ENGINE)
int forceFlatMinute = input.int(50, "Force-Flat Minute", minval = 0, maxval = 59, group = G_ENGINE)

string G_SESSION = "Decision Sessions (New York)"
int amStartHour = input.int(9, "AM Hour", minval = 0, maxval = 23, group = G_SESSION, inline = "AM")
int amStartMinute = input.int(30, "Minute", minval = 0, maxval = 59, group = G_SESSION, inline = "AM")
int lunchStartHour = input.int(11, "Lunch Hour", minval = 0, maxval = 23, group = G_SESSION, inline = "L")
int lunchStartMinute = input.int(30, "Minute", minval = 0, maxval = 59, group = G_SESSION, inline = "L")
int pmStartHour = input.int(13, "PM Hour", minval = 0, maxval = 23, group = G_SESSION, inline = "PM")
int pmStartMinute = input.int(30, "Minute", minval = 0, maxval = 59, group = G_SESSION, inline = "PM")
bool ignoreSessionBoundaryGapFpi = input.bool(false, "Stocks/RTH: Ignore FPI Crossing Session Start", group = G_SESSION)
int macroStartOffsetMinutes = input.int(20, "First Macro Start Offset", minval = 1, maxval = 60, group = G_SESSION)
int macroWindowMinutes = input.int(20, "First Macro Duration", minval = 1, maxval = 60, group = G_SESSION)
bool enableDirectMacroRetest = input.bool(true, "Trade First Macro FPI Retest", group = G_SESSION)
bool enableOrbSafeguard = input.bool(false, "ORB Safeguard For Opposite Trades", group = G_SESSION)
int orbMinutes = input.int(15, "ORB Length", minval = 5, maxval = 30, group = G_SESSION)

string G_RISK = "Risk / Campaign Management"
float maximumStopPoints = input.float(50.0, "Maximum Stop (points)", minval = 0.25, step = 0.25, group = G_RISK)
float deliveryTargetPoints = input.float(150.0, "Delivery Target (points)", minval = 0.25, step = 0.25, group = G_RISK)
bool judasUsesNoFixedTarget = input.bool(true, "Judas Holds Until Later-Window Reversal", group = G_RISK)
bool deliveryUsesFixedTarget = input.bool(true, "Delivery Uses Fixed Target", group = G_RISK)
int structuralBufferTicks = input.int(1, "Structure Stop Buffer (ticks)", minval = 0, maxval = 20, group = G_RISK)

string G_STRUCTURE = "One-Minute Structure Model"
int obSearchBars = input.int(6, "BOLO Search Bars", minval = 2, maxval = 20, group = G_STRUCTURE)
bool enablePrimaryOb = input.bool(true, "BOLO OB Retest", group = G_STRUCTURE)
bool enableGenericImb = input.bool(true, "IMB Retest", group = G_STRUCTURE)
bool enablePostObImb = input.bool(true, "Post-BOLO IMB Retest", group = G_STRUCTURE)
bool enableBgob = input.bool(true, "BGOB Retest", group = G_STRUCTURE)
bool rejectBgobBeyondMidpoint = input.bool(true, "Reject BGOB Retest Beyond 50%", group = G_STRUCTURE)

string G_PROTOCOL = "Judas / Delivery Protocol"
bool enableJudasTrades = input.bool(true, "Allow Judas Trade Against Session FPI", group = G_PROTOCOL)
bool requireLaterWindowForJudasEnd = input.bool(true, "Judas Ends Only In Later 30m Window", group = G_PROTOCOL)
bool requireFoundationAndImb = input.bool(true, "Judas End Requires Foundation + IMB", group = G_PROTOCOL)
bool allowObFoundation = input.bool(true, "BOLO OB Can End Judas", group = G_PROTOCOL)
bool allowBgobFoundation = input.bool(true, "BGOB Can End Judas", group = G_PROTOCOL)
bool allowPostObFoundation = input.bool(true, "Post-BOLO IMB Can End Judas", group = G_PROTOCOL)
bool allowImbFoundation = input.bool(true, "IMB Alone Can End Judas When Pair Requirement Is Off", group = G_PROTOCOL)

string G_VISUAL = "Visuals"
bool showAllDrawings = input.bool(false, "Show All Drawings", group = G_VISUAL)
bool showFpiBoxes = input.bool(true, "Show FPI Boxes", group = G_VISUAL)
bool showStructureBoxes = input.bool(true, "Show BOLO OB / IMB / BGOB", group = G_VISUAL)
bool showSignals = input.bool(true, "Show Entry / Exit Labels", group = G_VISUAL)
bool showWindowDividers = input.bool(true, "Show 30m Dividers", group = G_VISUAL)
int zoneTransparency = input.int(86, "Zone Transparency", minval = 60, maxval = 95, group = G_VISUAL)

bool drawFpiBoxes = showAllDrawings and showFpiBoxes
bool drawStructureBoxes = showAllDrawings and showStructureBoxes
bool drawSignals = showAllDrawings and showSignals
bool drawWindowDividers = showAllDrawings and showWindowDividers

// =============================================================================
// Constants and helpers
// =============================================================================
int PHASE_WAIT = 0
int PHASE_SESSION = 1
int PHASE_JUDAS = 2
int PHASE_DELIVERY = 3

minuteValue(int h, int m) => h * 60 + m
amStart() => minuteValue(amStartHour, amStartMinute)
lunchStart() => minuteValue(lunchStartHour, lunchStartMinute)
pmStart() => minuteValue(pmStartHour, pmStartMinute)

sessionId(int minuteOfDay) =>
    minuteOfDay >= amStart() and minuteOfDay < lunchStart() ? 0 :
     minuteOfDay >= lunchStart() and minuteOfDay < pmStart() ? 1 :
     minuteOfDay >= pmStart() and minuteOfDay < market.SESSION_END_MINUTE ? 2 : -1

sessionStartMinute(int id) => id == 0 ? amStart() : id == 1 ? lunchStart() : id == 2 ? pmStart() : -1
sessionEndMinute(int id) => id == 0 ? lunchStart() : id == 1 ? pmStart() : id == 2 ? market.SESSION_END_MINUTE : -1
sessionName(int id) => id == 0 ? "AM" : id == 1 ? "LUNCH" : id == 2 ? "PM" : "OFF"
macroStartMinute(int id) => sessionStartMinute(id) >= 0 ? sessionStartMinute(id) + macroStartOffsetMinutes : -1
macroEndMinute(int id) => macroStartMinute(id) >= 0 ? int(math.min(sessionEndMinute(id), macroStartMinute(id) + macroWindowMinutes)) : -1
sideColor(int direction) => direction == market.DIR_LONG ? color.green : direction == market.DIR_SHORT ? color.red : color.gray

windowText(int windowId) =>
    if windowId < 0
        "-"
    else
        int startMinute = market.periodStartMinute(windowId)
        int h = int(math.floor(startMinute / 60.0))
        int m = startMinute % 60
        str.tostring(h, "00") + ":" + str.tostring(m, "00")

newZone(int leftTime, int rightTime, float top, float bottom, int direction, string zoneText, int transparency) =>
    box.new(
         left = leftTime,
         top = top,
         right = rightTime,
         bottom = bottom,
         xloc = xloc.bar_time,
         bgcolor = color.new(sideColor(direction), transparency),
         border_color = color.new(sideColor(direction), math.max(0, transparency - 25)),
         text = zoneText,
         text_color = color.new(color.white, 20),
         text_size = size.tiny
    )

copyStructure(target, source) =>
    target.active := source.active
    target.used := source.used
    target.direction := source.direction
    target.family := source.family
    target.top := source.top
    target.bottom := source.bottom
    target.bodyTop := source.bodyTop
    target.bodyBottom := source.bodyBottom
    target.invalidation := source.invalidation
    target.sourceBar := source.sourceBar
    target.sourceTime := source.sourceTime
    target.sourceWindow := source.sourceWindow
    target.parentId := source.parentId
    target.status := source.status
    target.breakBar := source.breakBar
    target.confirmBar := source.confirmBar
    target.retestCount := source.retestCount
    target.touching := source.touching
    target.ruleId := source.ruleId
    target.reason := source.reason
    0

armMoreExtreme(target, source, int direction) =>
    bool replace =
         source.active and (
              not target.active or
              target.used or
              target.status == market.STATUS_INVALID or
              direction == market.DIR_LONG and source.bottom < target.bottom or
              direction == market.DIR_SHORT and source.top > target.top
         )
    if replace
        copyStructure(target, source)
        target.status := market.STATUS_ARMED
        target.used := false
        target.confirmBar := na
        target.touching := false
    replace

updateRetest(structure, int family, string ruleId, string reason) =>
    signal = market.newSignal()
    int eligibleAfter = not na(structure.breakBar) ? structure.breakBar : structure.sourceBar
    if structure.active and not structure.used and structure.status == market.STATUS_ARMED and bar_index > eligibleAfter
        bool invalid = market.bodyCloseInvalidates(structure.direction, structure.invalidation, close)
        bool touch = market.overlaps(structure.top, structure.bottom, high, low)
        bool confirms = structure.direction == market.DIR_LONG ? close > structure.bodyTop : close < structure.bodyBottom
        if invalid
            structure.status := market.STATUS_INVALID
        else if touch and confirms
            structure.status := market.STATUS_CONFIRMED
            structure.confirmBar := bar_index
            signal := market.signalFromStructure(structure, family, true, false, ruleId, reason)
    signal

boundedStop(int direction, float entryPrice, float invalidation) =>
    float fixedStop = direction == market.DIR_LONG ? entryPrice - maximumStopPoints : entryPrice + maximumStopPoints
    float buffered = na(invalidation) ? na : direction == market.DIR_LONG ? invalidation - structuralBufferTicks * syminfo.mintick : invalidation + structuralBufferTicks * syminfo.mintick
    direction == market.DIR_LONG and not na(buffered) and buffered < entryPrice ? math.max(fixedStop, buffered) :
     direction == market.DIR_SHORT and not na(buffered) and buffered > entryPrice ? math.min(fixedStop, buffered) : fixedStop

// =============================================================================
// Persistent state
// =============================================================================
var sessionFpi = market.newStructure()
var macroFpi = market.newStructure()
var bullOb = market.newStructure()
var bearOb = market.newStructure()
var bullImb = market.newStructure()
var bearImb = market.newStructure()
var postObImb = market.newStructure()
var judasFoundation = market.newStructure()
var judasSupportImb = market.newStructure()

var array<bool> windowFpiFound = array.new<bool>(market.LAST_WINDOW_ID + 1, false)
var array<bool> bgobActive = array.new<bool>(market.LAST_WINDOW_ID + 1, false)
var array<bool> bgobUsed = array.new<bool>(market.LAST_WINDOW_ID + 1, false)
var array<int> bgobDirection = array.new<int>(market.LAST_WINDOW_ID + 1, market.DIR_NONE)
var array<float> bgobTop = array.new<float>(market.LAST_WINDOW_ID + 1, na)
var array<float> bgobBottom = array.new<float>(market.LAST_WINDOW_ID + 1, na)
var array<int> bgobSourceBar = array.new<int>(market.LAST_WINDOW_ID + 1, na)
var array<int> bgobSourceTime = array.new<int>(market.LAST_WINDOW_ID + 1, na)
var array<int> bgobStatus = array.new<int>(market.LAST_WINDOW_ID + 1, market.STATUS_EMPTY)
var array<int> bgobBreakBar = array.new<int>(market.LAST_WINDOW_ID + 1, na)

var int activeSessionId = -1
var int activeWindow = -1
var bool sessionFpiFound = false
var bool macroFpiFound = false
var bool macroAccepted = false
var bool macroDisrespected = false
var int macroAcceptanceBar = na
var int structuralDirection = market.DIR_NONE
var int phase = PHASE_WAIT
var bool sessionFpiDisrespected = false
var bool judasCompleted = false
var int judasStartBar = na
var int judasStartWindow = -1
var bool judasFoundationValidated = false
var bool judasSupportTouched = false
var int judasReversalConfirmBar = na

// Frozen BOLO foundation and its required following IMB handoff.
var bool boloHandoffArmed = false
var int boloHandoffDirection = market.DIR_NONE
var int boloHandoffConfirmBar = na
var int boloHandoffWindow = -1
var float boloHandoffTop = na
var float boloHandoffBottom = na
var float boloHandoffInvalidation = na

var float orbHigh = na
var float orbLow = na
var bool orbLocked = false
var bool parentObActive = false
var int parentObDirection = market.DIR_NONE
var int parentObId = -1
var int parentObRespectBar = na

var bool tradeActive = false
var bool tradeIsJudas = false
var int tradeDirection = market.DIR_NONE
var int tradeEntryWindow = -1
var int tradeEntrySession = -1
var int tradeEntryBar = na
var float tradeEntryPrice = na
var float tradeStop = na
var float tradeTarget = na
var float tradeZoneTop = na
var float tradeZoneBottom = na
var float tradeInvalidation = na
var int tradeFamily = market.FAMILY_NONE
var string activeRule = ""
var string lastAction = "WAIT"
var int observedClosedTrades = 0
var bool orderSubmittedNow = false
var int submittedDirectionNow = market.DIR_NONE

var array<box> drawings = array.new<box>()
var array<label> labels = array.new<label>()
var array<line> dividers = array.new<line>()

// =============================================================================
// Time state and resets
// =============================================================================
bool isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
bool confirmedBar = barstate.isconfirmed
int nowMinute = market.minuteOfDay(0)
int currentSession = sessionId(nowMinute)
int currentWindow = market.windowFromMinute(nowMinute)
bool scheduleValid = amStart() < lunchStart() and lunchStart() < pmStart() and pmStart() < market.SESSION_END_MINUTE
bool inDecisionSession = scheduleValid and currentSession >= 0
bool newDecisionSession = inDecisionSession and currentSession != activeSessionId
bool newWindow = inDecisionSession and currentWindow >= 0 and currentWindow != activeWindow
bool inAmOpeningWindow = currentSession == 0 and nowMinute >= amStart() and nowMinute < amStart() + 30
int forceFlatAt = forceFlatHour * 60 + forceFlatMinute

orderSubmittedNow := false
submittedDirectionNow := market.DIR_NONE

if newDecisionSession
    activeSessionId := currentSession
    activeWindow := currentWindow
    sessionFpi := market.newStructure()
    macroFpi := market.newStructure()
    bullOb := market.newStructure()
    bearOb := market.newStructure()
    bullImb := market.newStructure()
    bearImb := market.newStructure()
    postObImb := market.newStructure()
    judasFoundation := market.newStructure()
    judasSupportImb := market.newStructure()
    sessionFpiFound := false
    macroFpiFound := false
    macroAccepted := false
    macroDisrespected := false
    macroAcceptanceBar := na
    structuralDirection := market.DIR_NONE
    phase := PHASE_WAIT
    sessionFpiDisrespected := false
    judasCompleted := false
    judasStartBar := na
    judasStartWindow := -1
    judasFoundationValidated := false
    judasSupportTouched := false
    judasReversalConfirmBar := na
    boloHandoffArmed := false
    boloHandoffDirection := market.DIR_NONE
    boloHandoffConfirmBar := na
    boloHandoffWindow := -1
    boloHandoffTop := na
    boloHandoffBottom := na
    boloHandoffInvalidation := na
    orbHigh := na
    orbLow := na
    orbLocked := false
    parentObActive := false
    parentObDirection := market.DIR_NONE
    parentObId := -1
    parentObRespectBar := na
    for i = 0 to market.LAST_WINDOW_ID
        array.set(windowFpiFound, i, false)
        array.set(bgobActive, i, false)
        array.set(bgobUsed, i, false)
        array.set(bgobDirection, i, market.DIR_NONE)
        array.set(bgobTop, i, na)
        array.set(bgobBottom, i, na)
        array.set(bgobSourceBar, i, na)
        array.set(bgobSourceTime, i, na)
        array.set(bgobStatus, i, market.STATUS_EMPTY)
        array.set(bgobBreakBar, i, na)

if newWindow
    activeWindow := currentWindow
    if drawWindowDividers
        line divider = line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.new(color.gray, 82), style = line.style_dotted)
        array.push(dividers, divider)

// Logic-only ORB. It is never highlighted.
int orbStart = sessionStartMinute(currentSession)
int orbEnd = orbStart >= 0 ? orbStart + orbMinutes : -1
if inDecisionSession and enableOrbSafeguard
    if nowMinute >= orbStart and nowMinute < orbEnd
        orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
        orbLow := na(orbLow) ? low : math.min(orbLow, low)
    if not orbLocked and nowMinute >= orbEnd and not na(orbHigh) and not na(orbLow)
        orbLocked := true

// =============================================================================
// Closed trade reconciliation
// =============================================================================
if strategy.closedtrades > observedClosedTrades
    for i = observedClosedTrades to strategy.closedtrades - 1
        float exitPrice = strategy.closedtrades.exit_price(i)
        float sizeValue = strategy.closedtrades.size(i)
        int closedDirection = sizeValue > 0 ? market.DIR_LONG : market.DIR_SHORT
        if drawSignals
            label exitLabel = label.new(bar_index, exitPrice, closedDirection == market.DIR_LONG ? "close buy" : "close sell", style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)
            array.push(labels, exitLabel)
    observedClosedTrades := strategy.closedtrades
    if strategy.position_size == 0
        tradeActive := false
        tradeIsJudas := false
        tradeDirection := market.DIR_NONE
        tradeEntryWindow := -1
        tradeEntrySession := -1
        tradeEntryBar := na
        tradeEntryPrice := na
        tradeStop := na
        tradeTarget := na
        tradeZoneTop := na
        tradeZoneBottom := na
        tradeInvalidation := na
        tradeFamily := market.FAMILY_NONE
        activeRule := ""

// =============================================================================
// FPI detection, Session FPI, Macro FPI and BGOB seeds
// =============================================================================
fpiEvent = market.detectFpi()
int firstFpiMinute = fpiEvent.valid ? market.minuteOfDay(2) : -1
int eventSession = fpiEvent.valid ? sessionId(fpiEvent.middleMinute) : -1
int eventSessionStart = sessionStartMinute(eventSession)
bool crossesSessionStart = eventSession >= 0 and firstFpiMinute < eventSessionStart
bool passesGapFilter = not ignoreSessionBoundaryGapFpi or not crossesSessionStart
bool eligibleFpi = isOneMinute and confirmedBar and inDecisionSession and fpiEvent.valid and fpiEvent.sourceWindow >= 0 and eventSession == currentSession and passesGapFilter
bool firstFpiForWindow = eligibleFpi and not array.get(windowFpiFound, fpiEvent.sourceWindow)

if firstFpiForWindow
    array.set(windowFpiFound, fpiEvent.sourceWindow, true)
    if drawFpiBoxes
        int rightTime = time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000
        box fpiBox = newZone(fpiEvent.sourceTime, rightTime, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, windowText(fpiEvent.sourceWindow) + " FPI", zoneTransparency)
        array.push(drawings, fpiBox)
    if enableBgob
        array.set(bgobActive, fpiEvent.sourceWindow, true)
        array.set(bgobUsed, fpiEvent.sourceWindow, false)
        array.set(bgobDirection, fpiEvent.sourceWindow, fpiEvent.direction)
        array.set(bgobTop, fpiEvent.sourceWindow, fpiEvent.thirdHigh)
        array.set(bgobBottom, fpiEvent.sourceWindow, fpiEvent.thirdLow)
        array.set(bgobSourceBar, fpiEvent.sourceWindow, bar_index)
        array.set(bgobSourceTime, fpiEvent.sourceWindow, time)
        array.set(bgobStatus, fpiEvent.sourceWindow, market.STATUS_ARMED)
        array.set(bgobBreakBar, fpiEvent.sourceWindow, na)
        if drawStructureBoxes
            box bgobBox = newZone(time, time + (sessionEndMinute(currentSession) - nowMinute) * 60000, fpiEvent.thirdHigh, fpiEvent.thirdLow, fpiEvent.direction, fpiEvent.direction == market.DIR_LONG ? "Bullish BGOB" : "Bearish BGOB", math.max(70, zoneTransparency - 8))
            array.push(drawings, bgobBox)

bool belongsToSession = eligibleFpi and fpiEvent.middleMinute >= sessionStartMinute(currentSession) and fpiEvent.middleMinute < sessionEndMinute(currentSession)
if belongsToSession and not sessionFpiFound
    sessionFpi := market.structureFromFpi(fpiEvent, market.FAMILY_NONE, "SESSION-FPI", "SESSION_FPI")
    sessionFpiFound := true
    structuralDirection := fpiEvent.direction
    phase := PHASE_SESSION
    if drawFpiBoxes
        box sessionBox = newZone(fpiEvent.sourceTime, time + (sessionEndMinute(currentSession) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, sessionName(currentSession) + " SESSION FPI", math.max(65, zoneTransparency - 12))
        array.push(drawings, sessionBox)

int activeMacroStart = macroStartMinute(currentSession)
int activeMacroEnd = macroEndMinute(currentSession)
bool belongsToMacro = belongsToSession and activeMacroStart >= 0 and fpiEvent.middleMinute >= activeMacroStart and fpiEvent.middleMinute < activeMacroEnd
if belongsToMacro and not macroFpiFound
    macroFpi := market.structureFromFpi(fpiEvent, market.FAMILY_NONE, "MACRO-FPI", "FIRST_MACRO_FPI")
    macroFpiFound := true
    macroAccepted := false
    macroDisrespected := false
    macroAcceptanceBar := na
    if drawFpiBoxes
        box macroBox = newZone(fpiEvent.sourceTime, time + (sessionEndMinute(currentSession) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, sessionName(currentSession) + " FIRST MACRO FPI", math.max(65, zoneTransparency - 8))
        array.push(drawings, macroBox)

// Session direction is fixed. Disrespect starts Judas; it never rewrites bias.
if sessionFpiFound and not judasCompleted and bar_index > sessionFpi.sourceBar
    bool disrespectNow = market.bodyCloseInvalidates(structuralDirection, structuralDirection == market.DIR_LONG ? sessionFpi.bottom : sessionFpi.top, close)
    if enableJudasTrades and disrespectNow and phase != PHASE_JUDAS
        phase := PHASE_JUDAS
        sessionFpiDisrespected := true
        judasStartBar := bar_index
        judasStartWindow := currentWindow
        judasFoundation := market.newStructure()
        judasSupportImb := market.newStructure()
        judasFoundationValidated := false
        judasSupportTouched := false
        judasReversalConfirmBar := na
        boloHandoffArmed := false
        boloHandoffDirection := market.DIR_NONE
        boloHandoffConfirmBar := na
        boloHandoffWindow := -1
        boloHandoffTop := na
        boloHandoffBottom := na
        boloHandoffInvalidation := na

// Macro lifecycle.
bool macroDirectRetestNow = false
bool macroOppositeRetestNow = false
if macroFpiFound and bar_index > macroFpi.sourceBar
    bool acceptedNow = market.directionalClose(macroFpi.direction, macroFpi.top, macroFpi.bottom, close)
    bool touchedNow = market.overlaps(macroFpi.top, macroFpi.bottom, high, low)
    bool failedNow = market.bodyCloseInvalidates(macroFpi.direction, macroFpi.direction == market.DIR_LONG ? macroFpi.bottom : macroFpi.top, close)
    if failedNow
        macroDisrespected := true
    if not macroAccepted and acceptedNow
        macroAccepted := true
        macroAcceptanceBar := bar_index
    else if enableDirectMacroRetest and macroAccepted and not macroDisrespected and bar_index > nz(macroAcceptanceBar, -1) and touchedNow and acceptedNow
        macroDirectRetestNow := true
    if macroDisrespected and bar_index > nz(macroAcceptanceBar, macroFpi.sourceBar)
        int oppositeDirection = -macroFpi.direction
        bool oppositeOutside = oppositeDirection == market.DIR_LONG ? close > macroFpi.top and close > open : close < macroFpi.bottom and close < open
        if touchedNow and oppositeOutside
            macroOppositeRetestNow := true

macroDirectSignal = market.newSignal()
if macroDirectRetestNow
    macroDirectSignal := market.makeSignal(macroFpi.direction, market.FAMILY_PRIOR_FPI, macroFpi.top, macroFpi.bottom, macroFpi.direction == market.DIR_LONG ? macroFpi.bottom : macroFpi.top, macroFpi.sourceBar, macroFpi.sourceTime, macroFpi.sourceWindow, macroFpi.parentId, true, false, macroFpi.direction == market.DIR_LONG ? "MACRO-FPI-RETEST-BUY" : "MACRO-FPI-RETEST-SELL", "FIRST_MACRO_ACCEPT_RETEST")

macroOppositeSignal = market.newSignal()
if macroOppositeRetestNow
    int oppositeDirection = -macroFpi.direction
    macroOppositeSignal := market.makeSignal(oppositeDirection, market.FAMILY_30M_REVERSAL, macroFpi.top, macroFpi.bottom, oppositeDirection == market.DIR_LONG ? macroFpi.bottom : macroFpi.top, macroFpi.sourceBar, macroFpi.sourceTime, macroFpi.sourceWindow, macroFpi.parentId, true, true, oppositeDirection == market.DIR_LONG ? "MACRO-FPI-REV-BUY" : "MACRO-FPI-REV-SELL", "FIRST_MACRO_DISRESPECT_RETEST")

// =============================================================================
// Structure permissions and creation
// =============================================================================
int judasDirection = structuralDirection == market.DIR_NONE ? market.DIR_NONE : -structuralDirection
bool openingStandbyInventory = inAmOpeningWindow and enableJudasTrades and not judasCompleted
bool allowBothInventories = phase == PHASE_JUDAS and not judasCompleted or openingStandbyInventory
bool allowBullStructures = sessionFpiFound and (structuralDirection == market.DIR_LONG or allowBothInventories and judasDirection == market.DIR_LONG)
bool allowBearStructures = sessionFpiFound and (structuralDirection == market.DIR_SHORT or allowBothInventories and judasDirection == market.DIR_SHORT)
bool bullCanConfirm = not inAmOpeningWindow or structuralDirection == market.DIR_LONG or phase == PHASE_JUDAS and judasDirection == market.DIR_LONG
bool bearCanConfirm = not inAmOpeningWindow or structuralDirection == market.DIR_SHORT or phase == PHASE_JUDAS and judasDirection == market.DIR_SHORT

// Per-bar BOLO confirmation created directly by the displacement FPI.
boloFormationSignal = market.newSignal()

if eligibleFpi and sessionFpiFound
    if enableGenericImb and fpiEvent.sourceBar != sessionFpi.sourceBar
        if fpiEvent.direction == market.DIR_LONG and allowBullStructures
            candidate = market.structureFromFpi(fpiEvent, market.FAMILY_IMB_RETEST, "IMB-BULL-01", "BULL_IMB")
            if armMoreExtreme(bullImb, candidate, market.DIR_LONG) and drawStructureBoxes
                box imbBox = newZone(fpiEvent.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, market.DIR_LONG, "Bullish IMB", zoneTransparency)
                array.push(drawings, imbBox)
        else if fpiEvent.direction == market.DIR_SHORT and allowBearStructures
            candidate = market.structureFromFpi(fpiEvent, market.FAMILY_IMB_RETEST, "IMB-BEAR-01", "BEAR_IMB")
            if armMoreExtreme(bearImb, candidate, market.DIR_SHORT) and drawStructureBoxes
                box imbBox = newZone(fpiEvent.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, market.DIR_SHORT, "Bearish IMB", zoneTransparency)
                array.push(drawings, imbBox)

    if enablePrimaryOb
        obSeed = market.detectBoloObSeed(fpiEvent.direction, obSearchBars, fpiEvent.sourceWindow)
        if obSeed.active and obSeed.direction == market.DIR_LONG and allowBullStructures
            bool replaced = armMoreExtreme(bullOb, obSeed, market.DIR_LONG)
            if replaced and drawStructureBoxes
                box obBox = newZone(obSeed.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, obSeed.top, obSeed.bottom, market.DIR_LONG, "Bullish BOLO OB", zoneTransparency)
                array.push(drawings, obBox)
            bool middleTouchedBolo = market.overlaps(bullOb.top, bullOb.bottom, high[1], low[1])
            bool displacementConfirmedBolo = bullOb.active and middleTouchedBolo and close[1] > bullOb.bodyTop and close[1] > open[1]
            if displacementConfirmedBolo and bullCanConfirm
                bullOb.status := market.STATUS_CONFIRMED
                bullOb.confirmBar := bar_index
                boloFormationSignal := market.signalFromStructure(bullOb, market.FAMILY_PRIMARY_OB, true, false, "BOLO-BULL-02", "BULLISH_BOLO_DISPLACEMENT_RESPECT")
        else if obSeed.active and obSeed.direction == market.DIR_SHORT and allowBearStructures
            bool replaced = armMoreExtreme(bearOb, obSeed, market.DIR_SHORT)
            if replaced and drawStructureBoxes
                box obBox = newZone(obSeed.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, obSeed.top, obSeed.bottom, market.DIR_SHORT, "Bearish BOLO OB", zoneTransparency)
                array.push(drawings, obBox)
            bool middleTouchedBolo = market.overlaps(bearOb.top, bearOb.bottom, high[1], low[1])
            bool displacementConfirmedBolo = bearOb.active and middleTouchedBolo and close[1] < bearOb.bodyBottom and close[1] < open[1]
            if displacementConfirmedBolo and bearCanConfirm
                bearOb.status := market.STATUS_CONFIRMED
                bearOb.confirmBar := bar_index
                boloFormationSignal := market.signalFromStructure(bearOb, market.FAMILY_PRIMARY_OB, true, false, "BOLO-BEAR-02", "BEARISH_BOLO_DISPLACEMENT_RESPECT")

    if enablePostObImb and parentObActive and fpiEvent.direction == parentObDirection and bar_index > parentObRespectBar
        candidate = market.structureFromFpi(fpiEvent, market.FAMILY_POST_OB_IMB, "POSTOB-01", "POST_BOLO_IMB")
        if armMoreExtreme(postObImb, candidate, fpiEvent.direction) and drawStructureBoxes
            box postBox = newZone(fpiEvent.sourceTime, time + (market.periodEndMinute(fpiEvent.sourceWindow) - nowMinute) * 60000, fpiEvent.top, fpiEvent.bottom, fpiEvent.direction, "Post-BOLO IMB", zoneTransparency)
            array.push(drawings, postBox)

    if phase == PHASE_JUDAS and fpiEvent.sourceWindow > judasStartWindow
        candidate = market.structureFromFpi(fpiEvent, market.FAMILY_IMB_RETEST, "JUDAS-SUPPORT", "LOWEST_OR_HIGHEST_IMB_SUPPORT")
        bool replaceSupport = not judasSupportImb.active or structuralDirection == market.DIR_LONG and candidate.bottom < judasSupportImb.bottom or structuralDirection == market.DIR_SHORT and candidate.top > judasSupportImb.top
        if replaceSupport
            copyStructure(judasSupportImb, candidate)
            judasSupportImb.status := market.STATUS_ARMED
            judasSupportTouched := false

// =============================================================================
// Structure signals
// =============================================================================
bullObRetestSignal = enablePrimaryOb and bullCanConfirm ? updateRetest(bullOb, market.FAMILY_PRIMARY_OB, "BOLO-BULL-02", "BULLISH_BOLO_RETEST_RESPECT") : market.newSignal()
bearObRetestSignal = enablePrimaryOb and bearCanConfirm ? updateRetest(bearOb, market.FAMILY_PRIMARY_OB, "BOLO-BEAR-02", "BEARISH_BOLO_RETEST_RESPECT") : market.newSignal()

bullObSignal = boloFormationSignal.valid and boloFormationSignal.direction == market.DIR_LONG ? market.copySignal(boloFormationSignal) : market.copySignal(bullObRetestSignal)
bearObSignal = boloFormationSignal.valid and boloFormationSignal.direction == market.DIR_SHORT ? market.copySignal(boloFormationSignal) : market.copySignal(bearObRetestSignal)

bullImbSignal = enableGenericImb and bullCanConfirm ? updateRetest(bullImb, market.FAMILY_IMB_RETEST, "IMB-BULL-02", "BULL_IMB_RETEST") : market.newSignal()
bearImbSignal = enableGenericImb and bearCanConfirm ? updateRetest(bearImb, market.FAMILY_IMB_RETEST, "IMB-BEAR-02", "BEAR_IMB_RETEST") : market.newSignal()
bool postObCanConfirm = not inAmOpeningWindow or postObImb.direction == structuralDirection or phase == PHASE_JUDAS and postObImb.direction == judasDirection
postObSignal = enablePostObImb and postObCanConfirm ? updateRetest(postObImb, market.FAMILY_POST_OB_IMB, "POSTOB-02", "POST_BOLO_IMB_RETEST") : market.newSignal()

bool shortOpenNow = strategy.position_size < 0 or tradeActive and tradeDirection == market.DIR_SHORT
bool longOpenNow = strategy.position_size > 0 or tradeActive and tradeDirection == market.DIR_LONG

if bullObSignal.valid
    parentObActive := true
    parentObDirection := market.DIR_LONG
    parentObId := bullObSignal.parentId
    parentObRespectBar := bar_index
    if shortOpenNow and structuralDirection == market.DIR_LONG
        boloHandoffArmed := true
        boloHandoffDirection := market.DIR_LONG
        boloHandoffConfirmBar := bar_index
        boloHandoffWindow := currentWindow
        boloHandoffTop := bullObSignal.top
        boloHandoffBottom := bullObSignal.bottom
        boloHandoffInvalidation := bullObSignal.bottom

if bearObSignal.valid
    parentObActive := true
    parentObDirection := market.DIR_SHORT
    parentObId := bearObSignal.parentId
    parentObRespectBar := bar_index
    if longOpenNow and structuralDirection == market.DIR_SHORT
        boloHandoffArmed := true
        boloHandoffDirection := market.DIR_SHORT
        boloHandoffConfirmBar := bar_index
        boloHandoffWindow := currentWindow
        boloHandoffTop := bearObSignal.top
        boloHandoffBottom := bearObSignal.bottom
        boloHandoffInvalidation := bearObSignal.top

// Preserve the FPI that confirms the BOLO as a post-BOLO IMB. Without this,
// the original code processed the FPI before parentObActive became true and lost it.
if enablePostObImb and eligibleFpi
    if bullObSignal.valid and fpiEvent.direction == market.DIR_LONG
        sameBarPostBolo = market.structureFromFpi(fpiEvent, market.FAMILY_POST_OB_IMB, "POSTBOLO-BULL-01", "POST_BOLO_BULL_IMB")
        armMoreExtreme(postObImb, sameBarPostBolo, market.DIR_LONG)
    else if bearObSignal.valid and fpiEvent.direction == market.DIR_SHORT
        sameBarPostBolo = market.structureFromFpi(fpiEvent, market.FAMILY_POST_OB_IMB, "POSTBOLO-BEAR-01", "POST_BOLO_BEAR_IMB")
        armMoreExtreme(postObImb, sameBarPostBolo, market.DIR_SHORT)

// =============================================================================
// BGOB lifecycle
// =============================================================================
bgobSignal = market.newSignal()
if enableBgob and confirmedBar and inDecisionSession
    for w = 0 to market.LAST_WINDOW_ID
        bool active = array.get(bgobActive, w)
        bool used = array.get(bgobUsed, w)
        int direction = array.get(bgobDirection, w)
        float topValue = array.get(bgobTop, w)
        float bottomValue = array.get(bgobBottom, w)
        int sourceBarValue = array.get(bgobSourceBar, w)
        int sourceTimeValue = array.get(bgobSourceTime, w)
        int statusValue = array.get(bgobStatus, w)
        int breakBarValue = array.get(bgobBreakBar, w)
        if active and not used and direction != market.DIR_NONE and not na(sourceBarValue) and bar_index > sourceBarValue
            if statusValue == market.STATUS_ARMED
                bool destroyed = direction == market.DIR_LONG ? close < bottomValue : close > topValue
                bool broken = direction == market.DIR_LONG ? close > topValue : close < bottomValue
                if destroyed
                    array.set(bgobStatus, w, market.STATUS_INVALID)
                    array.set(bgobActive, w, false)
                else if broken
                    array.set(bgobStatus, w, market.STATUS_BROKEN)
                    array.set(bgobBreakBar, w, bar_index)
            else if statusValue == market.STATUS_BROKEN and not na(breakBarValue) and bar_index > breakBarValue
                bool retest = market.overlaps(topValue, bottomValue, high, low)
                float midpoint = market.midpoint(topValue, bottomValue)
                bool tooDeep = direction == market.DIR_LONG ? low < midpoint : high > midpoint
                bool confirms = direction == market.DIR_LONG ? close > topValue and close > open : close < bottomValue and close < open
                bool bgobCanConfirm = not inAmOpeningWindow or direction == structuralDirection or phase == PHASE_JUDAS and direction == judasDirection
                if retest and rejectBgobBeyondMidpoint and tooDeep
                    array.set(bgobStatus, w, market.STATUS_INVALID)
                    array.set(bgobActive, w, false)
                else if retest and confirms and bgobCanConfirm
                    array.set(bgobStatus, w, market.STATUS_CONFIRMED)
                    candidate = market.makeSignal(direction, market.FAMILY_BGOB, topValue, bottomValue, direction == market.DIR_LONG ? bottomValue : topValue, sourceBarValue, sourceTimeValue, w, sourceTimeValue, true, false, direction == market.DIR_LONG ? "BGOB-BUY" : "BGOB-SELL", direction == market.DIR_LONG ? "BULLISH_BGOB_RETEST_RESPECT" : "BEARISH_BGOB_RETEST_RESPECT")
                    if not bgobSignal.valid or decision.familyPriority(candidate.family) >= decision.familyPriority(bgobSignal.family)
                        bgobSignal := market.copySignal(candidate)

// =============================================================================
// Direction-specific signal buckets
// =============================================================================
bullBaseSignal = market.newSignal()
if bgobSignal.valid and bgobSignal.direction == market.DIR_LONG
    bullBaseSignal := market.copySignal(bgobSignal)
else if bullObSignal.valid
    bullBaseSignal := market.copySignal(bullObSignal)
else if postObSignal.valid and postObSignal.direction == market.DIR_LONG
    bullBaseSignal := market.copySignal(postObSignal)
else if bullImbSignal.valid
    bullBaseSignal := market.copySignal(bullImbSignal)
else if macroDirectSignal.valid and macroDirectSignal.direction == market.DIR_LONG
    bullBaseSignal := market.copySignal(macroDirectSignal)
else if macroOppositeSignal.valid and macroOppositeSignal.direction == market.DIR_LONG
    bullBaseSignal := market.copySignal(macroOppositeSignal)

bearBaseSignal = market.newSignal()
if bgobSignal.valid and bgobSignal.direction == market.DIR_SHORT
    bearBaseSignal := market.copySignal(bgobSignal)
else if bearObSignal.valid
    bearBaseSignal := market.copySignal(bearObSignal)
else if postObSignal.valid and postObSignal.direction == market.DIR_SHORT
    bearBaseSignal := market.copySignal(postObSignal)
else if bearImbSignal.valid
    bearBaseSignal := market.copySignal(bearImbSignal)
else if macroDirectSignal.valid and macroDirectSignal.direction == market.DIR_SHORT
    bearBaseSignal := market.copySignal(macroDirectSignal)
else if macroOppositeSignal.valid and macroOppositeSignal.direction == market.DIR_SHORT
    bearBaseSignal := market.copySignal(macroOppositeSignal)

// =============================================================================
// Judas reversal inventory
// =============================================================================
alignedFoundationSignal = structuralDirection == market.DIR_LONG ? market.copySignal(bullBaseSignal) : structuralDirection == market.DIR_SHORT ? market.copySignal(bearBaseSignal) : market.newSignal()

bool alignedSignalIsTrueFoundation =
     alignedFoundationSignal.valid and (
          alignedFoundationSignal.family == market.FAMILY_PRIMARY_OB and allowObFoundation or
          alignedFoundationSignal.family == market.FAMILY_BGOB and allowBgobFoundation or
          alignedFoundationSignal.family == market.FAMILY_POST_OB_IMB and allowPostObFoundation
     )

bool alignedSignalCanBeImbOnlyFoundation =
     not requireFoundationAndImb and allowImbFoundation and alignedFoundationSignal.valid and alignedFoundationSignal.family == market.FAMILY_IMB_RETEST

bool laterThanJudas = phase == PHASE_JUDAS and currentWindow > judasStartWindow
bool openingJudasCampaign = phase == PHASE_JUDAS and currentSession == 0 and judasStartWindow == market.windowFromMinute(amStart())
bool foundationWindowPass = alignedFoundationSignal.sourceWindow > judasStartWindow or openingJudasCampaign and laterThanJudas

// FIX: freeze the BOLO/BGOB/Post-BOLO foundation. The old version allowed the
// following IMB signal to overwrite judasFoundation with FAMILY_IMB_RETEST,
// which made openingFoundationQualified false exactly when the buy should fire.
if laterThanJudas and not judasFoundationValidated and (alignedSignalIsTrueFoundation or alignedSignalCanBeImbOnlyFoundation) and alignedFoundationSignal.direction == structuralDirection and foundationWindowPass
    market.setStructure(judasFoundation, alignedFoundationSignal.direction, alignedFoundationSignal.family, alignedFoundationSignal.top, alignedFoundationSignal.bottom, alignedFoundationSignal.top, alignedFoundationSignal.bottom, alignedFoundationSignal.invalidation, alignedFoundationSignal.sourceBar, alignedFoundationSignal.sourceTime, currentWindow, alignedFoundationSignal.parentId, market.STATUS_CONFIRMED, alignedFoundationSignal.ruleId, "FROZEN_LATER_WINDOW_FOUNDATION")
    judasFoundation.confirmBar := bar_index
    judasFoundationValidated := true

bool supportTouchNow = phase == PHASE_JUDAS and judasSupportImb.active and currentWindow > judasStartWindow and market.overlaps(judasSupportImb.top, judasSupportImb.bottom, high, low)
if supportTouchNow
    judasSupportTouched := true

bool supportConfirmedNow = phase == PHASE_JUDAS and judasSupportImb.active and currentWindow > judasStartWindow and judasSupportTouched and (structuralDirection == market.DIR_LONG ? close > judasSupportImb.top : close < judasSupportImb.bottom)

bool bullImbHeld = structuralDirection == market.DIR_LONG and (
     judasSupportImb.active and close > judasSupportImb.top or
     bullImb.active and bullImb.status != market.STATUS_INVALID and close > bullImb.top or
     bearImb.active and bearImb.status != market.STATUS_INVALID and close > bearImb.top or
     postObImb.active and postObImb.status != market.STATUS_INVALID and close > postObImb.top
)

bool bearImbHeld = structuralDirection == market.DIR_SHORT and (
     judasSupportImb.active and close < judasSupportImb.bottom or
     bearImb.active and bearImb.status != market.STATUS_INVALID and close < bearImb.bottom or
     bullImb.active and bullImb.status != market.STATUS_INVALID and close < bullImb.bottom or
     postObImb.active and postObImb.status != market.STATUS_INVALID and close < postObImb.bottom
)

bool directionalImbHeldNow = laterThanJudas and (bullImbHeld or bearImbHeld)
bool openingFoundationQualified = judasFoundationValidated and (judasFoundation.family == market.FAMILY_PRIMARY_OB or judasFoundation.family == market.FAMILY_BGOB or judasFoundation.family == market.FAMILY_POST_OB_IMB)
bool openingSupportHeldNow = openingJudasCampaign and laterThanJudas and openingFoundationQualified and directionalImbHeldNow
bool supportEvidencePass = supportConfirmedNow or openingSupportHeldNow
bool laterWindowPass = not requireLaterWindowForJudasEnd or laterThanJudas
bool reversalEvidencePass = requireFoundationAndImb ? judasFoundationValidated and supportEvidencePass : judasFoundationValidated

// Dedicated raw IMB handoff after a frozen BOLO. This bypasses the family
// priority bucket so the IMB cannot be hidden by a BOLO/BGOB on the same bar.
bool alignedImbRetestNow =
     boloHandoffDirection == market.DIR_LONG ? (bullImbSignal.valid or postObSignal.valid and postObSignal.direction == market.DIR_LONG) :
     boloHandoffDirection == market.DIR_SHORT ? (bearImbSignal.valid or postObSignal.valid and postObSignal.direction == market.DIR_SHORT) : false

bool boloHandoffWindowPass = boloHandoffArmed and not na(boloHandoffConfirmBar) and bar_index > boloHandoffConfirmBar and currentWindow >= boloHandoffWindow
bool oppositePositionStillOpen = boloHandoffDirection == market.DIR_LONG ? (strategy.position_size < 0 or tradeDirection == market.DIR_SHORT) : boloHandoffDirection == market.DIR_SHORT ? (strategy.position_size > 0 or tradeDirection == market.DIR_LONG) : false
bool boloImbHandoffReady = boloHandoffWindowPass and alignedImbRetestNow and oppositePositionStillOpen and boloHandoffDirection == structuralDirection

bool judasReversalReady = phase == PHASE_JUDAS and laterWindowPass and reversalEvidencePass or boloImbHandoffReady
judasReversalSignal = market.newSignal()

if judasReversalReady and bar_index != judasReversalConfirmBar
    float topValue = boloImbHandoffReady ? boloHandoffTop : judasFoundationValidated ? judasFoundation.top : judasSupportImb.top
    float bottomValue = boloImbHandoffReady ? boloHandoffBottom : judasFoundationValidated ? judasFoundation.bottom : judasSupportImb.bottom
    float invalidation = boloImbHandoffReady ? boloHandoffInvalidation : structuralDirection == market.DIR_LONG ? bottomValue : topValue
    int sourceWindowValue = boloImbHandoffReady ? currentWindow : judasFoundationValidated ? judasFoundation.sourceWindow : judasSupportImb.sourceWindow
    judasReversalSignal := market.makeSignal(structuralDirection, market.FAMILY_30M_REVERSAL, topValue, bottomValue, invalidation, bar_index, time, sourceWindowValue, -1, true, true, structuralDirection == market.DIR_LONG ? "JUDAS-END-BUY" : "JUDAS-END-SELL", boloImbHandoffReady ? "CONFIRMED_BOLO_THEN_IMB_RETEST_HANDOFF" : "LATER_WINDOW_FOUNDATION_AND_IMB_HELD")
    judasReversalConfirmBar := bar_index

// =============================================================================
// Selection, validation and order submission
// =============================================================================
int permittedDirection = phase == PHASE_JUDAS and not judasCompleted ? judasDirection : structuralDirection
bool orbPermission = not enableOrbSafeguard or permittedDirection == structuralDirection or orbLocked and (permittedDirection == market.DIR_LONG ? close > orbHigh : close < orbLow)
permittedSignal = permittedDirection == market.DIR_LONG ? market.copySignal(bullBaseSignal) : permittedDirection == market.DIR_SHORT ? market.copySignal(bearBaseSignal) : market.newSignal()
selectedSignal = market.newSignal()
if judasReversalSignal.valid
    selectedSignal := market.copySignal(judasReversalSignal)
else if orbPermission and permittedSignal.valid
    selectedSignal := market.copySignal(permittedSignal)

validationSignal = tradeDirection == market.DIR_LONG ? market.copySignal(bullBaseSignal) : tradeDirection == market.DIR_SHORT ? market.copySignal(bearBaseSignal) : market.newSignal()
if tradeActive and validationSignal.valid and validationSignal.direction == tradeDirection
    if not tradeIsJudas
        tradeZoneTop := validationSignal.top
        tradeZoneBottom := validationSignal.bottom
        tradeInvalidation := validationSignal.family == market.FAMILY_BGOB ? (tradeDirection == market.DIR_LONG ? validationSignal.bottom : validationSignal.top) : validationSignal.invalidation
        tradeFamily := validationSignal.family
        activeRule := validationSignal.ruleId
        lastAction := "HOLD DELIVERY | " + validationSignal.ruleId
    else
        lastAction := "HOLD JUDAS | " + validationSignal.ruleId

bool sessionOrderPermission = not tradeDecisionSessionsOnly or inDecisionSession
bool canSubmit = enableBot and isOneMinute and confirmedBar and sessionOrderPermission and nowMinute < forceFlatAt
bool reversingJudas = judasReversalSignal.valid and judasReversalSignal.direction == -tradeDirection and (tradeActive or strategy.position_size != 0) and (tradeIsJudas or boloImbHandoffReady)
bool crossSessionReversal = tradeActive and currentSession != tradeEntrySession and selectedSignal.valid and selectedSignal.direction == structuralDirection and selectedSignal.direction == -tradeDirection
bool freshEntry = not tradeActive and strategy.position_size == 0

if canSubmit and selectedSignal.valid and (freshEntry or reversingJudas or crossSessionReversal)
    bool entryIsJudas = phase == PHASE_JUDAS and selectedSignal.direction == judasDirection and not judasCompleted and not judasReversalSignal.valid
    bool entryIsDelivery = selectedSignal.direction == structuralDirection and not entryIsJudas
    float entryPrice = close
    float structureInvalidation = selectedSignal.family == market.FAMILY_BGOB ? (selectedSignal.direction == market.DIR_LONG ? selectedSignal.bottom : selectedSignal.top) : selectedSignal.invalidation
    float stopValue = boundedStop(selectedSignal.direction, entryPrice, structureInvalidation)
    float targetValue = entryIsJudas and judasUsesNoFixedTarget ? na : entryIsDelivery and deliveryUsesFixedTarget ? (selectedSignal.direction == market.DIR_LONG ? entryPrice + deliveryTargetPoints : entryPrice - deliveryTargetPoints) : na

    if reversingJudas or crossSessionReversal
        strategy.cancel("SLTP")

    strategy.entry("ENIGMA", selectedSignal.direction == market.DIR_LONG ? strategy.long : strategy.short, qty = orderQuantity, comment = selectedSignal.ruleId)
    strategy.exit("SLTP", from_entry = "ENIGMA", stop = stopValue, limit = targetValue, comment_profit = "TP", comment_loss = "SL")

    orderSubmittedNow := true
    submittedDirectionNow := selectedSignal.direction
    tradeActive := true
    tradeIsJudas := entryIsJudas
    tradeDirection := selectedSignal.direction
    tradeEntryWindow := currentWindow
    tradeEntrySession := currentSession
    tradeEntryBar := bar_index
    tradeEntryPrice := entryPrice
    tradeStop := stopValue
    tradeTarget := targetValue
    tradeZoneTop := selectedSignal.top
    tradeZoneBottom := selectedSignal.bottom
    tradeInvalidation := structureInvalidation
    tradeFamily := selectedSignal.family
    activeRule := selectedSignal.ruleId
    lastAction := market.sideText(selectedSignal.direction) + " | " + selectedSignal.ruleId

    if entryIsJudas
        judasStartWindow := currentWindow
        judasStartBar := bar_index

    if entryIsDelivery
        if inAmOpeningWindow and not judasReversalSignal.valid
            phase := PHASE_SESSION
        else
            phase := PHASE_DELIVERY
            judasCompleted := true
            sessionFpiDisrespected := false
            judasReversalConfirmBar := bar_index
            boloHandoffArmed := false
            boloHandoffDirection := market.DIR_NONE
            boloHandoffConfirmBar := na
            boloHandoffWindow := -1
            boloHandoffTop := na
            boloHandoffBottom := na
            boloHandoffInvalidation := na
            if structuralDirection == market.DIR_LONG
                bearOb := market.newStructure()
                bearImb := market.newStructure()
            else
                bullOb := market.newStructure()
                bullImb := market.newStructure()

    if selectedSignal.family == market.FAMILY_PRIMARY_OB
        if selectedSignal.direction == market.DIR_LONG
            bullOb.used := true
        else
            bearOb.used := true
    else if selectedSignal.family == market.FAMILY_IMB_RETEST
        if selectedSignal.direction == market.DIR_LONG
            bullImb.used := true
        else
            bearImb.used := true
    else if selectedSignal.family == market.FAMILY_POST_OB_IMB
        postObImb.used := true
    else if selectedSignal.family == market.FAMILY_BGOB
        for w = 0 to market.LAST_WINDOW_ID
            if array.get(bgobSourceBar, w) == selectedSignal.sourceBar and array.get(bgobDirection, w) == selectedSignal.direction
                array.set(bgobUsed, w, true)
                array.set(bgobActive, w, false)

    if drawSignals
        label entryLabel = label.new(bar_index, close, selectedSignal.direction == market.DIR_LONG ? "buy\n" + selectedSignal.ruleId : "sell\n" + selectedSignal.ruleId, style = selectedSignal.direction == market.DIR_LONG ? label.style_label_up : label.style_label_down, color = selectedSignal.direction == market.DIR_LONG ? color.green : color.red, textcolor = color.white, size = size.small)
        array.push(labels, entryLabel)

// =============================================================================
// Position management
// =============================================================================
if tradeActive and bar_index > tradeEntryBar
    if strategy.position_size != 0 and not na(strategy.position_avg_price)
        tradeEntryPrice := strategy.position_avg_price
    strategy.exit("SLTP", from_entry = "ENIGMA", stop = tradeStop, limit = tradeTarget, comment_profit = "TP", comment_loss = "SL")

    // Judas ignores ordinary local failure until the calculated BOLO -> IMB
    // reversal is complete. The reversal entry above closes the sell and buys.
    if not tradeIsJudas
        bool controllerDisrespected = market.bodyCloseInvalidates(tradeDirection, tradeInvalidation, close)
        if controllerDisrespected
            string exitReason = tradeFamily == market.FAMILY_BGOB ? "BGOB_DISRESPECT" : tradeFamily == market.FAMILY_PRIMARY_OB ? "BOLO_DISRESPECT" : "IMB_DISRESPECT"
            strategy.close("ENIGMA", comment = exitReason)
            lastAction := "CLOSE | " + exitReason

    if forceFlat and nowMinute >= forceFlatAt
        strategy.close("ENIGMA", comment = "FORCE_FLAT")
        lastAction := "CLOSE | FORCE_FLAT"

// =============================================================================
// Data-window outputs and alerts
// =============================================================================
plot(sessionFpiFound ? structuralDirection : na, "Structural Session FPI Direction", display = display.data_window)
plot(phase, "Campaign Phase", display = display.data_window)
plot(sessionFpiFound ? sessionFpi.top : na, "Session FPI Top", display = display.data_window)
plot(sessionFpiFound ? sessionFpi.bottom : na, "Session FPI Bottom", display = display.data_window)
plot(macroFpiFound ? macroFpi.direction : na, "First Macro FPI Direction", display = display.data_window)
plot(enableOrbSafeguard and orbLocked ? orbHigh : na, "ORB High", display = display.data_window)
plot(enableOrbSafeguard and orbLocked ? orbLow : na, "ORB Low", display = display.data_window)
plot(judasSupportImb.active ? judasSupportImb.top : na, "Judas Support IMB Top", display = display.data_window)
plot(judasSupportImb.active ? judasSupportImb.bottom : na, "Judas Support IMB Bottom", display = display.data_window)
plot(judasFoundationValidated ? judasFoundation.invalidation : na, "Frozen Judas Foundation Invalidation", display = display.data_window)
plot(boloHandoffArmed ? boloHandoffDirection : 0, "BOLO IMB Handoff Direction", display = display.data_window)
plot(bullOb.active ? bullOb.top : na, "Bullish BOLO Top", display = display.data_window)
plot(bullOb.active ? bullOb.bottom : na, "Bullish BOLO Bottom", display = display.data_window)
plot(bearOb.active ? bearOb.top : na, "Bearish BOLO Top", display = display.data_window)
plot(bearOb.active ? bearOb.bottom : na, "Bearish BOLO Bottom", display = display.data_window)
plot(tradeActive ? tradeDirection : 0, "Active Trade Direction", display = display.data_window)
plot(tradeActive ? tradeStop : na, "Active Stop", display = display.data_window)
plot(tradeActive ? tradeTarget : na, "Active Target", display = display.data_window)

alertcondition(orderSubmittedNow and submittedDirectionNow == market.DIR_LONG, "PO3 MMXM Buy", "PO3 MMXM Enigma BUY")
alertcondition(orderSubmittedNow and submittedDirectionNow == market.DIR_SHORT, "PO3 MMXM Sell", "PO3 MMXM Enigma SELL")
