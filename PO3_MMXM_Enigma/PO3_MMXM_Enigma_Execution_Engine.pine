        bearRevFoundationTop := na
        bearRevFoundationBottom := na
        bearRevFoundationObTop := na
        bearRevFoundationObBottom := na
        bearRevFoundationImbTop := na
        bearRevFoundationImbBottom := na
        bearRevFoundationWindow := -1
        bearRevFoundationAgainstFpiWindow := -1
        bearRevFoundationConfirmBar := na
        reversalModeActive := false
        reversalModeDirection := 0
        reversalModeStartWindow := -1
        reversalOpeningPairConsumed := false
        sessionExtremeHigh := high
        sessionExtremeLow := low
        lastSwingHighClose := na
        lastSwingLowClose := na
        currentPeriodHighestClose := close
        currentPeriodLowestClose := close
        frozenPriorSwingHighClose := na
        frozenPriorSwingLowClose := na
        if activeNyPhase != SESSION_PHASE_AM
            macro950Found := false
            macro950Direction := 0
            macro950Top := na
            macro950Bottom := na
            macro950FormationBar := na
            macro950InitialSignalUsed := false
            macro950AcceptanceConfirmed := false
            macro950AcceptanceBar := na
            macro950AuthorityDirection := 0
            macro950AuthorityBar := na
            macro950AuthorityRetestConfirmed := false
            macro950OppositeRetestPending := false
            macro950Box := na
            catalog.resetMacroRange(catalogRange)
            catalogSessionDisrespectedLatched := false
            macro950BgobActive := false
            macro950BgobOriginalDirection := 0
            macro950BgobDirection := 0
            macro950BgobTop := na
            macro950BgobBottom := na
            macro950BgobFormationBar := na
            macro950BgobStartTime := na
            macro950BgobFlipConfirmed := false
            macro950BgobFlipBar := na
            macro950BgobUsed := false
            macro950BgobBox := na

    // Build, freeze, and update the independent 9:50-10:10 range in one library call.
    catalog.updateMacroRange(catalogRange, inSession and isOneMinute and barstate.isconfirmed and activeNyPhase == SESSION_PHASE_AM, nowMinute, high, low, bar_index, MACRO_950_START_MINUTE, MACRO_950_END_MINUTE)

    // Session-FPI respect is independently latched for the catalog. A later reclaim
    // cannot silently restore the original controller's respected status.
    if inSession and isOneMinute and barstate.isconfirmed and sessionAnchorFpiFound and not catalogSessionDisrespectedLatched
        bool catalogSessionFailureClose = sessionAnchorDirection == 1 ? close < sessionAnchorBottom : sessionAnchorDirection == -1 ? close > sessionAnchorTop : false
        if catalogSessionFailureClose
            catalogSessionDisrespectedLatched := true

    // Reconcile broker-emulator fills from the resting 500-point target or armed break-even stop.
    // The emulator's actual fill price is used for every ledger and session point calculation.
    if recordedTradeOpen and not na(recordedEntryBar) and bar_index > recordedEntryBar and strategy.position_size == 0 and strategy.closedtrades > recordedClosedTradesAtEntry
        int closedTradeIndex = strategy.closedtrades - 1
        float brokerExitPrice = strategy.closedtrades.exit_price(closedTradeIndex)
        int brokerExitWindow = windowIdFromTimestamp(strategy.closedtrades.exit_time(closedTradeIndex))
        float fillTolerance = math.max(syminfo.mintick * 2.0, 0.01)
        bool targetExit = not na(recordedTarget) and math.abs(brokerExitPrice - recordedTarget) <= fillTolerance
        float brokerPoints = tradePoints(recordedTradeDirection, recordedEntry, brokerExitPrice)
        recordedTp := brokerExitPrice
        sessionClosedPoints += brokerPoints
        if recordedWindow >= 0 and recordedSlot >= 0
            writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, brokerPoints, false, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)
        drawExitTriangleNow := true
        drawExitTriangleDirection := recordedTradeDirection
        drawExitTrianglePrice := brokerExitPrice
        drawClosedTradeEntryBar := recordedEntryBar
        drawClosedTradeEntryPrice := recordedEntry
        closedDirectionNow := recordedTradeDirection
        exitNow := true
        recordedTradeOpen := false
        recordedEarlyReversal := false
        recordedNarrativeHoldConfirmed := false
        activeFpiValid := false
        activeSourceKind := SOURCE_NONE
        delayedFpiReversal := false
        fpiRequalificationWatch := false
        fpiRequalificationAcceptanceConfirmed := false
        fpiRequalificationAcceptanceBar := na
        campaignHoldAnchorFound := false
        campaignHoldAnchorWindow := -1
        campaignHoldAnchorTop := na
        campaignHoldAnchorBottom := na
        strategy.cancel(PROTECTION_ID)
        if targetExit
            // Reconciliation can occur on the first bar of the next period. Lock the
            // actual fill period, not whichever period is current when it is observed.
            targetLockWindow := brokerExitWindow
            targetWindowLock := brokerExitWindow >= 0 and brokerExitWindow == currentWindow

    if not recordedTradeOpen
        recoveryTradeWatchEligible := false
        recoveryTradeFpiWindow := -1
        recoveryTradeFpiTop := na
        recoveryTradeFpiBottom := na
        recoveryTradeAcceptanceSeen := false
        recoveryTradeAcceptanceBar := na

    // Every exact period gets a five-cell chart-anchored ledger. An open trade is held
    // through the divider while the next period waits for its own first FPI.
    if newPeriod
        if targetWindowLock and currentWindow != targetLockWindow
            targetWindowLock := false
            targetLockWindow := -1
        if openingFpiWindowLock and currentWindow != openingFpiLockWindow
            openingFpiWindowLock := false
            openingFpiLockWindow := -1
            openingFpiLockReleasedNow := true

        frozenPriorSwingHighClose := not na(lastSwingHighClose) ? lastSwingHighClose : currentPeriodHighestClose
        frozenPriorSwingLowClose := not na(lastSwingLowClose) ? lastSwingLowClose : currentPeriodLowestClose
        currentPeriodHighestClose := close
        currentPeriodLowestClose := close
        array.set(holdingByWindow, currentWindow, recordedTradeOpen or strategy.position_size != 0)

        if pendingFpi
            pendingFpi := false
            pendingAcceptanceConfirmed := false
            pendingAcceptanceBar := na
            if not na(pendingBox)
                box.set_border_color(pendingBox, color.new(#868e96, 35))

        // Foundation discovery is phase-wide when enabled. The lowest bullish OB/IMB
        // and highest bearish OB/IMB remain eligible after a 30-minute divider, so a
        // break in one interval and the confirming retest in the next interval are one
        // continuous sequence. Phase changes at 11:30 and 1:30 still clear all candidates.
        if not (cfg.enableSequenceEngine and cfg.usePhaseExtremeFoundationCandidates)
            bullishObRunActive := false
            bullishObCandidateFound := false
            bullishObBreakConfirmed := false
            bullishObCandidateUsed := false
            bearishObRunActive := false
            bearishObCandidateFound := false
            bearishObBreakConfirmed := false
            bearishObCandidateUsed := false
            bullishImbCandidateFound := false
            bullishImbBreakConfirmed := false
            bullishImbCandidateUsed := false
            bearishImbCandidateFound := false
            bearishImbBreakConfirmed := false
            bearishImbCandidateUsed := false
        // Opposing-IMB pair candidates already persist across dividers inside the
        // same AM, lunch, or PM phase, allowing either the IMB or OB to confirm first.

        stateWindow := currentWindow
        currentPeriodLow := low

        if drawPeriodTables and isOneMinute
            int tableLeft = minuteTimestamp(periodStartMinute(currentWindow)) + 60000
            int tableRight = minuteTimestamp(periodEndMinute(currentWindow)) - 60000
            int cellWidth = int(math.floor((tableRight - tableLeft) / 5.0))
            float tableTop = currentPeriodLow - cfg.tradeTableGap
            float tableBottom = tableTop - cfg.tradeTableHeight
            box tradeCell = makeLedgerCell(tableLeft, tableLeft + cellWidth, tableTop, tableBottom, "")
            box entryCell = makeLedgerCell(tableLeft + cellWidth, tableLeft + cellWidth * 2, tableTop, tableBottom, "")
            box slCell = makeLedgerCell(tableLeft + cellWidth * 2, tableLeft + cellWidth * 3, tableTop, tableBottom, "")
            box tpCell = makeLedgerCell(tableLeft + cellWidth * 3, tableLeft + cellWidth * 4, tableTop, tableBottom, "")
            box resultCell = makeLedgerCell(tableLeft + cellWidth * 4, tableRight, tableTop, tableBottom, "")
            array.set(tradeCellByWindow, currentWindow, tradeCell)
            array.set(entryCellByWindow, currentWindow, entryCell)
            array.set(slCellByWindow, currentWindow, slCell)
            array.set(tpCellByWindow, currentWindow, tpCell)
            array.set(resultCellByWindow, currentWindow, resultCell)
            renderLedger(ledger, currentWindow, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)

    // Keep the current period table a fixed distance beneath that period's lowest price.
    if inSession and currentWindow >= 0 and currentWindow == stateWindow
        sessionPriceLow := na(sessionPriceLow) ? low : math.min(sessionPriceLow, low)
        currentPeriodLow := na(currentPeriodLow) ? low : math.min(currentPeriodLow, low)
        currentPeriodHighestClose := na(currentPeriodHighestClose) ? close : math.max(currentPeriodHighestClose, close)
        currentPeriodLowestClose := na(currentPeriodLowestClose) ? close : math.min(currentPeriodLowestClose, close)
        if drawPeriodTables and isOneMinute
            float tableTop = currentPeriodLow - cfg.tradeTableGap
            float tableBottom = tableTop - cfg.tradeTableHeight
            box tradeCell = array.get(tradeCellByWindow, currentWindow)
            box entryCell = array.get(entryCellByWindow, currentWindow)
            box slCell = array.get(slCellByWindow, currentWindow)
            box tpCell = array.get(tpCellByWindow, currentWindow)
            box resultCell = array.get(resultCellByWindow, currentWindow)
            if not na(tradeCell)
                box.set_top(tradeCell, tableTop)
                box.set_bottom(tradeCell, tableBottom)
            if not na(entryCell)
                box.set_top(entryCell, tableTop)
                box.set_bottom(entryCell, tableBottom)
            if not na(slCell)
                box.set_top(slCell, tableTop)
                box.set_bottom(slCell, tableBottom)
            if not na(tpCell)
                box.set_top(tpCell, tableTop)
                box.set_bottom(tpCell, tableBottom)
            if not na(resultCell)
                box.set_top(resultCell, tableTop)
                box.set_bottom(resultCell, tableBottom)

    // Raw three-candle swing confirmation. The frozen level used by a later profitable-trade
    // delay is captured at the period boundary and is never moved after the opposing FPI appears.
    if inSession and isOneMinute and barstate.isconfirmed and bar_index >= 2
        bool newSwingHigh = high[1] > high[2] and high[1] >= high
        bool newSwingLow = low[1] < low[2] and low[1] <= low
        if newSwingHigh
            lastSwingHighClose := math.max(math.max(close[2], close[1]), close)
        if newSwingLow
            lastSwingLowClose := math.min(math.min(close[2], close[1]), close)

    // Per-bar first-FPI signal payload.
    bool mainSignalNow = false
    int mainSignalDirection = 0
    float mainSignalTop = na
    float mainSignalBottom = na
    int mainSignalWindow = -1
    box mainSignalBox = na
    bool mainSignalWasRetest = false
    int mainSignalOriginalDirection = 0
    bool mainSignalWasDisrespected = false
    bool mainSignalIsSessionAnchor = false
    int mainSignalStructureBar = na

    // Select and draw only the first FPI in every exact period, including 9:30. The middle
    // displacement candle assigns the FPI to its period; an FPI confirmed at the next
    // divider is still drawn in the correct prior period but cannot arm a late retest.
    if cfg.enableBot and isOneMinute and (inSession or sessionEnded) and barstate.isconfirmed
        int detectedDirection = fpiDirection()
        int middleMinute = minuteAt(1)
        int detectedWindow = middleWindow
        bool middleInMacro950 = middleMinute >= MACRO_950_START_MINUTE and middleMinute < MACRO_950_END_MINUTE
        bool middleInExactPeriod = detectedWindow >= 0 and middleMinute >= periodStartMinute(detectedWindow) and middleMinute < periodEndMinute(detectedWindow)
        bool firstFpiThisPeriod = middleInExactPeriod and not array.get(selectedByWindow, detectedWindow) and detectedDirection != 0

        if not macro950Found and middleInMacro950 and detectedDirection != 0
            macro950Found := true
            macro950Direction := detectedDirection
            macro950Top := fpiTop()
            macro950Bottom := fpiBottom()
            macro950FormationBar := bar_index
            macro950InitialSignalUsed := false
            macro950AcceptanceConfirmed := false
            macro950AcceptanceBar := na
            macro950AuthorityDirection := 0
            macro950AuthorityBar := na
            macro950BgobActive := true
            macro950BgobOriginalDirection := detectedDirection
            macro950BgobDirection := 0
            macro950BgobTop := high
            macro950BgobBottom := low
            macro950BgobFormationBar := bar_index
            macro950BgobStartTime := time
            macro950BgobFlipConfirmed := false
            macro950BgobFlipBar := na
            macro950BgobUsed := false
            macro950BgobBox := na
            if drawStructureVisuals
                macro950Box := box.new(left=time[2], top=macro950Top, right=minuteTimestamp(MACRO_950_TRADE_END), bottom=macro950Bottom, xloc=xloc.bar_time, border_color=fpiBorderColor(macro950Direction), border_width=2, bgcolor=fpiFillColor(macro950Direction, cfg.fpiBoxTransparency), text=drawStructureTags ? "9:50-10:10 FPI" + (macro950Direction == 1 ? "+" : "-") : "", text_size=size.large, text_color=fpiBorderColor(macro950Direction), text_halign=text.align_center, text_valign=text.align_center)

        if firstFpiThisPeriod
            array.set(selectedByWindow, detectedWindow, true)
            float selectedTop = fpiTop()
            float selectedBottom = fpiBottom()
            selectedFpiNow := true
            selectedFpiWindow := detectedWindow
            selectedFpiDirection := detectedDirection
            selectedFpiTop := selectedTop
            selectedFpiBottom := selectedBottom
            box selectedBox = na
            int eligibleControllerWindow = controllerWindowForPhase(activeNyPhase)
            bool selectedIsSessionAnchor = not sessionAnchorFpiFound and eligibleControllerWindow >= 0 and detectedWindow == eligibleControllerWindow
            array.set(intervalFpiOriginalDirection, detectedWindow, detectedDirection)
            array.set(intervalFpiTop, detectedWindow, selectedTop)
            array.set(intervalFpiBottom, detectedWindow, selectedBottom)
            array.set(intervalFpiThreeCandleHigh, detectedWindow, math.max(high, math.max(high[1], high[2])))
            array.set(intervalFpiThreeCandleLow, detectedWindow, math.min(low, math.min(low[1], low[2])))
            array.set(intervalFpiDisrespected, detectedWindow, false)
            array.set(intervalFpiRespected, detectedWindow, false)
            array.set(intervalFpiFormationBar, detectedWindow, bar_index)
            array.set(intervalFpiPersistentAcceptanceSeen, detectedWindow, false)
            array.set(intervalFpiPersistentAcceptanceBar, detectedWindow, na)
            bool selectedOpposesSession = sessionAnchorFpiFound and detectedDirection != sessionAnchorDirection
            bool holdingSessionTrade = recordedTradeOpen and recordedTradeDirection == sessionAnchorDirection
            array.set(pullbackByWindow, detectedWindow, selectedOpposesSession and holdingSessionTrade)

            // The selected FPI's third candle is the only BGOB candidate for this period.
            // It remains eligible only while price has not traded through the candle edge
            // adjoining the FPI. The full candle high/low is the BGOB zone.
            array.set(bgobValidByWindow, detectedWindow, true)
            array.set(bgobUsedByWindow, detectedWindow, false)
            array.set(bgobDirectionByWindow, detectedWindow, detectedDirection)
            array.set(bgobTopByWindow, detectedWindow, high)
            array.set(bgobBottomByWindow, detectedWindow, low)
            array.set(bgobFormationBarByWindow, detectedWindow, bar_index)
            array.set(bgobBreakConfirmedByWindow, detectedWindow, false)
            array.set(bgobBreakBarByWindow, detectedWindow, na)

            if drawStructureVisuals
                int selectedLeft = math.max(time[2], minuteTimestamp(periodStartMinute(detectedWindow)))
                selectedBox := box.new(left=selectedLeft, top=selectedTop, right=minuteTimestamp(periodEndMinute(detectedWindow)), bottom=selectedBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(detectedDirection), border_width=2, bgcolor=fpiFillColor(detectedDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? periodLabel(detectedWindow) + " FPI" + (detectedDirection == 1 ? "+" : "-") : "", text_size=size.large, text_color=fpiBorderColor(detectedDirection), text_halign=text.align_center, text_valign=text.align_center)

            if selectedIsSessionAnchor
                sessionAnchorFpiFound := true
                sessionAnchorDirection := detectedDirection
                sessionAnchorTop := selectedTop
                sessionAnchorBottom := selectedBottom
                sessionAnchorWindow := detectedWindow
                sessionAnchorBar := bar_index
                sessionAnchorBox := selectedBox
                sessionFpiRegime := SESSION_REGIME_UNRESOLVED
                sessionAlignmentProvenByLaterFpi := false
                sessionAnchorResolutionComplete := false
                sessionAnchorAcceptanceConfirmed := false
                sessionAnchorAcceptanceBar := na

            // Non-anchor FPIs remain pending until acceptance plus a later confirmed
            // retest, or until a close through the far edge confirms the opposite side.
            if currentWindow == detectedWindow and not selectedIsSessionAnchor
                pendingFpi := true
                pendingDirection := detectedDirection
                pendingTop := selectedTop
                pendingBottom := selectedBottom
                pendingBar := bar_index
                pendingWindow := detectedWindow
                pendingBox := selectedBox
                pendingAcceptanceConfirmed := false
                pendingAcceptanceBar := na

    // A failed profitable recovery remains flat until the first selected FPI from a
    // strictly later exact period. Formation releases the time lock; entry still
    // requires that interval's completed structural validation.
    bool failedRecoveryWaitReleasedNow = failedRecoveryWait and selectedFpiNow and selectedFpiWindow > failedRecoveryExitWindow
    if failedRecoveryWaitReleasedNow
        failedRecoveryWait := false
        failedRecoveryExitWindow := -1

    // Symmetric first-two-post-controller conflict regime. For a bullish controller, both FPI zones
    // must be wholly below the session FPI. For a bearish session, both must be wholly
    // above it. A later FPI wholly back on the aligned side releases reversal mode.
    int reversalFirstWindow = sessionAnchorWindow >= 0 ? sessionAnchorWindow + 1 : -1
    int reversalSecondWindow = sessionAnchorWindow >= 0 ? sessionAnchorWindow + 2 : -1
    bool reversalOpeningPairAvailable = sessionAnchorFpiFound and reversalSecondWindow <= LAST_WINDOW_ID and reversalFirstWindow >= 0 and array.get(selectedByWindow, reversalFirstWindow) and array.get(selectedByWindow, reversalSecondWindow)
    bool reversalOpeningPairConflicts = false
    if reversalOpeningPairAvailable
        float firstConflictTop = array.get(intervalFpiTop, reversalFirstWindow)
        float firstConflictBottom = array.get(intervalFpiBottom, reversalFirstWindow)
        float secondConflictTop = array.get(intervalFpiTop, reversalSecondWindow)
        float secondConflictBottom = array.get(intervalFpiBottom, reversalSecondWindow)
        reversalOpeningPairConflicts := sessionAnchorDirection == 1 ? firstConflictTop < sessionAnchorBottom and secondConflictTop < sessionAnchorBottom : firstConflictBottom > sessionAnchorTop and secondConflictBottom > sessionAnchorTop

    if not reversalModeActive and not reversalOpeningPairConsumed and reversalOpeningPairConflicts
        reversalModeActive := true
        reversalModeDirection := -sessionAnchorDirection
        reversalModeStartWindow := reversalSecondWindow
        reversalOpeningPairConsumed := true
        reversalModeActivatedNow := true
        sessionFpiRegime := SESSION_REGIME_JUDAS
        sessionAlignmentProvenByLaterFpi := false
        campaignHoldAnchorFound := false
        campaignHoldAnchorWindow := -1
        campaignHoldAnchorTop := na
        campaignHoldAnchorBottom := na
        campaignReentryWait := false
        campaignReentryExitWindow := -1
        campaignReentryAlignedOnly := false
        intervalReentryWait := false
        intervalReentryExitWindow := -1
        intervalReentryDirection := 0
        delayedFpiReversal := false

    if reversalModeActive and selectedFpiNow and selectedFpiWindow > reversalModeStartWindow
        bool selectedFpiRestoresSessionSide = sessionAnchorDirection == 1 ? selectedFpiBottom > sessionAnchorTop : selectedFpiTop < sessionAnchorBottom
        if selectedFpiRestoresSessionSide
            reversalModeActive := false
            reversalModeDirection := 0
            reversalModeStartWindow := -1
            reversalModeReleasedNow := true
            sessionFpiRegime := SESSION_REGIME_ALIGNED
            sessionAlignmentProvenByLaterFpi := true
            intervalReentryWait := false
            intervalReentryExitWindow := -1
            intervalReentryDirection := 0
            delayedFpiReversal := false

    // The first session FPI uses the same strict state machine but is retained even
    // if it forms at a divider. Bullish requires close above the top, then a later
    // zone retest that closes above the top. Bearish is exactly symmetric.
    if sessionAnchorFpiFound and not sessionAnchorResolutionComplete and isOneMinute and inSession and barstate.isconfirmed and not na(sessionAnchorBar) and bar_index > sessionAnchorBar
        bool sessionAnchorFailure = (sessionAnchorDirection == 1 ? close < sessionAnchorBottom : close > sessionAnchorTop) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-sessionAnchorDirection))
        bool sessionAnchorAcceptanceClose = sessionAnchorDirection == 1 ? close > sessionAnchorTop : close < sessionAnchorBottom
        bool sessionAnchorZoneRetest = low <= sessionAnchorTop and high >= sessionAnchorBottom
        if sessionAnchorFailure
            sessionAnchorResolutionComplete := true
            sessionAnchorAcceptanceConfirmed := false
            sessionAnchorAcceptanceBar := na
            sessionFpiRegime := SESSION_REGIME_JUDAS
            mainSignalNow := true
            mainSignalDirection := -sessionAnchorDirection
            mainSignalTop := sessionAnchorTop
            mainSignalBottom := sessionAnchorBottom
            mainSignalWindow := sessionAnchorWindow
            mainSignalBox := sessionAnchorBox
            mainSignalWasRetest := false
            mainSignalOriginalDirection := sessionAnchorDirection
            mainSignalWasDisrespected := true
            mainSignalIsSessionAnchor := true
            mainSignalStructureBar := sessionAnchorBar
            if not na(sessionAnchorBox)
                box.set_border_width(sessionAnchorBox, 3)
                box.set_border_color(sessionAnchorBox, color.new(#f08c00, 0))
        else if not sessionAnchorAcceptanceConfirmed
            if sessionAnchorAcceptanceClose
                sessionAnchorAcceptanceConfirmed := true
                sessionAnchorAcceptanceBar := bar_index
                if not na(sessionAnchorBox)
                    box.set_border_color(sessionAnchorBox, color.new(#1971c2, 0))
        else if not na(sessionAnchorAcceptanceBar) and bar_index > sessionAnchorAcceptanceBar and sessionAnchorZoneRetest and sessionAnchorAcceptanceClose
            sessionAnchorResolutionComplete := true
            sessionFpiRegime := SESSION_REGIME_ALIGNED
            mainSignalNow := true
            mainSignalDirection := sessionAnchorDirection
            mainSignalTop := sessionAnchorTop
            mainSignalBottom := sessionAnchorBottom
            mainSignalWindow := sessionAnchorWindow
            mainSignalBox := sessionAnchorBox
            mainSignalWasRetest := true
            mainSignalOriginalDirection := sessionAnchorDirection
            mainSignalWasDisrespected := false
            mainSignalIsSessionAnchor := true
            mainSignalStructureBar := sessionAnchorBar
            if not na(sessionAnchorBox)
                box.set_border_width(sessionAnchorBox, 3)
                box.set_border_color(sessionAnchorBox, color.new(#1971c2, 0))

    // Every later selected FPI follows the same acceptance -> later retest sequence.
    // No-retest continuation is observation only and cannot create a trade.
    if pendingFpi and not mainSignalNow and isOneMinute and inSession and barstate.isconfirmed and currentWindow == pendingWindow and bar_index > pendingBar
        bool pendingCloseDisrespect = (pendingDirection == 1 ? close < pendingBottom : close > pendingTop) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-pendingDirection))
        bool pendingAcceptanceClose = pendingDirection == 1 ? close > pendingTop : close < pendingBottom
        bool pendingZoneRetest = low <= pendingTop and high >= pendingBottom
        if pendingCloseDisrespect
            pendingFpi := false
            pendingAcceptanceConfirmed := false
            pendingAcceptanceBar := na
            mainSignalNow := true
            mainSignalDirection := -pendingDirection
            mainSignalTop := pendingTop
            mainSignalBottom := pendingBottom
            mainSignalWindow := pendingWindow
            mainSignalBox := pendingBox
            mainSignalWasRetest := false
            mainSignalOriginalDirection := pendingDirection
            mainSignalWasDisrespected := true
            mainSignalIsSessionAnchor := false
            mainSignalStructureBar := pendingBar
            if not na(pendingBox)
                box.set_border_width(pendingBox, 3)
                box.set_border_color(pendingBox, color.new(#f08c00, 0))
        else if not pendingAcceptanceConfirmed
            if pendingAcceptanceClose
                pendingAcceptanceConfirmed := true
                pendingAcceptanceBar := bar_index
                if not na(pendingBox)
                    box.set_border_color(pendingBox, color.new(#1971c2, 0))
        else if not na(pendingAcceptanceBar) and bar_index > pendingAcceptanceBar and pendingZoneRetest and pendingAcceptanceClose
            pendingFpi := false
            pendingAcceptanceConfirmed := false
            pendingAcceptanceBar := na
            mainSignalNow := true
            mainSignalDirection := pendingDirection
            mainSignalTop := pendingTop
            mainSignalBottom := pendingBottom
            mainSignalWindow := pendingWindow
            mainSignalBox := pendingBox
            mainSignalWasRetest := true
            mainSignalOriginalDirection := pendingDirection
            mainSignalWasDisrespected := false
            mainSignalIsSessionAnchor := false
            mainSignalStructureBar := pendingBar
            if not na(pendingBox)
                box.set_border_width(pendingBox, 3)
                box.set_border_color(pendingBox, color.new(#1971c2, 0))

    if mainSignalNow and mainSignalWindow >= 0
        array.set(intervalFpiRespected, mainSignalWindow, not mainSignalWasDisrespected)

    // After an anchor-FPI exit, no same-period recovery is permitted. A later exact
    // period must validate an FPI back in the permanent session direction first.
    bool campaignReentryAlignmentNow = campaignReentryWait and mainSignalNow and mainSignalWindow > campaignReentryExitWindow and mainSignalOriginalDirection == sessionAnchorDirection and not mainSignalWasDisrespected
    if campaignReentryAlignmentNow
        campaignReentryWait := false
        campaignReentryExitWindow := -1
        campaignReentryAlignedOnly := true

    // Losing the final prior support/resistance interval closes first and then waits.
    // Only a respected FPI in a strictly later window and in the exited trade's
    // direction releases the lock; that later interval still needs matching structure.
    bool intervalReentryAlignmentNow = intervalReentryWait and mainSignalNow and mainSignalWindow > intervalReentryExitWindow and mainSignalOriginalDirection == intervalReentryDirection and not mainSignalWasDisrespected
    if intervalReentryAlignmentNow
        intervalReentryWait := false
        intervalReentryExitWindow := -1
        intervalReentryDirection := 0

    // The first selected FPI in 9:30-10:00 has a dedicated failure outcome. Any
    // confirmed close-disrespect closes the open trade, suppresses the immediate
    // opposite entry, and locks new entries until the 10:00 divider.
    bool openingFpiDisrespectNow = sessionAnchorFpiFound and sessionAnchorWindow == controllerWindowForPhase(activeNyPhase) and currentWindow == sessionAnchorWindow and not openingFpiDisrespectConsumed and not na(sessionAnchorBar) and bar_index > sessionAnchorBar and (sessionAnchorDirection == 1 ? close < sessionAnchorBottom : close > sessionAnchorTop) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-sessionAnchorDirection))
    if openingFpiDisrespectNow
        openingFpiDisrespectConsumed := true
        openingFpiWindowLock := true
        openingFpiLockWindow := 0
        sessionFpiRegime := SESSION_REGIME_JUDAS
        sessionAlignmentProvenByLaterFpi := false
        // Initial resolution normally emits an opposite signal; the opening rule is
        // close-and-wait, so that payload is explicitly consumed instead.
        if mainSignalIsSessionAnchor
            mainSignalNow := false

    // Initial disrespect does not erase the first session FPI. It starts a Judas
    // phase in the opposing direction. Only a later exact-period FPI pointing in the
    // session direction and being respected can prove alignment and end that phase.
    bool sessionAnchorDisrespectedNow = sessionAnchorFpiFound and sessionFpiRegime == SESSION_REGIME_ALIGNED and not sessionAlignmentProvenByLaterFpi and not na(sessionAnchorBar) and bar_index > sessionAnchorBar and (sessionAnchorDirection == 1 ? close < sessionAnchorBottom : close > sessionAnchorTop) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-sessionAnchorDirection))
    if sessionAnchorDisrespectedNow
        sessionFpiRegime := SESSION_REGIME_JUDAS

    bool sessionAlignmentProofNow = sessionAnchorFpiFound and sessionFpiRegime == SESSION_REGIME_JUDAS and mainSignalNow and not mainSignalIsSessionAnchor and mainSignalWindow > sessionAnchorWindow and mainSignalOriginalDirection == sessionAnchorDirection and not mainSignalWasDisrespected
    if sessionAlignmentProofNow
        sessionFpiRegime := SESSION_REGIME_ALIGNED
        sessionAlignmentProvenByLaterFpi := true

    // The first FPI whose displacement candle occurs from 9:50 through 10:09 is a
    // persistent AM authority during 10:00-11:30. Its intended direction requires an
    // outside acceptance close, then a later physical retest and another outside close.
    // A far-edge close only nominates the opposing authority; a later retest and outside close confirms it.
    bool macro950SignalNow = false
    int macro950SignalDirection = 0
    bool macro950SignalWasRetest = false
    bool macro950WindowActive = cfg.enableBot and activeNyPhase == SESSION_PHASE_AM and macro950Found and isOneMinute and inSession and barstate.isconfirmed and nowMinute >= MACRO_950_AUTHORITY_START and nowMinute < MACRO_950_TRADE_END
    bool macro950CanExecuteNow = nowMinute >= MACRO_950_TRADE_START or recordedTradeOpen or strategy.position_size != 0

    if macro950WindowActive and not macro950InitialSignalUsed and bar_index > macro950FormationBar
        bool macro950ZoneRetest = low <= macro950Top and high >= macro950Bottom
        bool macro950AcceptanceClose = macro950Direction == 1 ? close > macro950Top : close < macro950Bottom
        bool macro950FarEdgeFailure = (macro950Direction == 1 ? close < macro950Bottom : close > macro950Top) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-macro950Direction))
        if macro950FarEdgeFailure
            // A completed close through the far edge is itself the reversal authorization.
            // A previously confirmed OB/IMB foundation may execute on this close; no
            // redundant second Macro-FPI retest is required.
            macro950SignalNow := macro950CanExecuteNow
            macro950SignalDirection := -macro950Direction
            macro950SignalWasRetest := false
            macro950InitialSignalUsed := true
            macro950AuthorityDirection := -macro950Direction
            macro950AuthorityBar := bar_index
            macro950AuthorityRetestConfirmed := true
            macro950OppositeRetestPending := false
            macro950AcceptanceConfirmed := false
            macro950AcceptanceBar := na
        else if not macro950AcceptanceConfirmed
            if macro950AcceptanceClose
                // A close on the intended side establishes the original Macro-FPI bias.
                // The later retest still upgrades that authority to fully retest-confirmed.
                macro950AcceptanceConfirmed := true
                macro950AcceptanceBar := bar_index
                macro950AuthorityDirection := macro950Direction
                macro950AuthorityBar := bar_index
                macro950AuthorityRetestConfirmed := false
                macro950OppositeRetestPending := false
        else if not na(macro950AcceptanceBar) and bar_index > macro950AcceptanceBar and macro950ZoneRetest and macro950AcceptanceClose
            macro950SignalNow := macro950CanExecuteNow
            macro950SignalDirection := macro950Direction
            macro950SignalWasRetest := true
            macro950InitialSignalUsed := true
            macro950AuthorityDirection := macro950Direction
            macro950AuthorityBar := bar_index
            macro950AuthorityRetestConfirmed := true
            macro950OppositeRetestPending := false
            macro950AcceptanceConfirmed := false
            macro950AcceptanceBar := na
        if macro950SignalNow
            delayedFpiReversal := false
            if not na(macro950Box)
                box.set_border_width(macro950Box, 3)
                box.set_border_color(macro950Box, fpiBorderColor(macro950SignalDirection))

    if macro950WindowActive and macro950OppositeRetestPending and not na(macro950AuthorityBar) and bar_index > macro950AuthorityBar
        bool macro950PendingRetest = low <= macro950Top and high >= macro950Bottom
        bool macro950PendingOutsideClose = macro950AuthorityDirection == 1 ? close > macro950Top : close < macro950Bottom
        if macro950PendingRetest and macro950PendingOutsideClose
            macro950AuthorityRetestConfirmed := true
            macro950OppositeRetestPending := false
            macro950SignalNow := macro950CanExecuteNow
            macro950SignalDirection := macro950AuthorityDirection
            macro950SignalWasRetest := true
            macro950AuthorityBar := bar_index

    if macro950WindowActive and macro950InitialSignalUsed and not na(macro950AuthorityBar) and bar_index > macro950AuthorityBar
        int macro950EconomicDirection = recordedTradeOpen ? recordedTradeDirection : positionDirection()
        bool macro950ZoneRetest = low <= macro950Top and high >= macro950Bottom
        bool macro950OriginalAcceptanceClose = macro950Direction == 1 ? close > macro950Top : close < macro950Bottom
        bool macro950OriginalFailureClose = (macro950Direction == 1 ? close < macro950Bottom : close > macro950Top) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-macro950Direction))
        if macro950AuthorityDirection == macro950Direction and macro950OriginalFailureClose
            macro950AuthorityDirection := -macro950Direction
            macro950AuthorityRetestConfirmed := true
            macro950OppositeRetestPending := false
            macro950SignalNow := macro950CanExecuteNow
            macro950SignalDirection := macro950AuthorityDirection
            macro950SignalWasRetest := false
            macro950AuthorityBar := bar_index
            macro950AcceptanceConfirmed := false
            macro950AcceptanceBar := na
            delayedFpiReversal := false
        else if macro950AuthorityDirection == macro950Direction and macro950OriginalAcceptanceClose and macro950EconomicDirection != macro950AuthorityDirection
            // The FPI was already validated by a later retest before 10:00. A flat
            // strategy may execute that stored authority once fresh entries open.
            macro950SignalNow := macro950CanExecuteNow
            macro950SignalDirection := macro950AuthorityDirection
            macro950SignalWasRetest := true
            macro950AuthorityBar := bar_index
        else if macro950AuthorityDirection == -macro950Direction
            if macro950OriginalAcceptanceClose and not macro950AcceptanceConfirmed
                macro950AcceptanceConfirmed := true
                macro950AcceptanceBar := bar_index
            else if macro950AcceptanceConfirmed and not na(macro950AcceptanceBar) and bar_index > macro950AcceptanceBar and macro950ZoneRetest and macro950OriginalAcceptanceClose
                macro950AuthorityDirection := macro950Direction
                macro950AuthorityRetestConfirmed := true
                macro950OppositeRetestPending := false
                macro950SignalNow := macro950CanExecuteNow
                macro950SignalDirection := macro950Direction
                macro950SignalWasRetest := true
                macro950AuthorityBar := bar_index
                macro950AcceptanceConfirmed := false
                macro950AcceptanceBar := na
                delayedFpiReversal := false
            else if macro950OriginalFailureClose and macro950EconomicDirection != macro950AuthorityDirection
                macro950SignalNow := macro950CanExecuteNow
                macro950SignalDirection := macro950AuthorityDirection
                macro950SignalWasRetest := false
                macro950AuthorityBar := bar_index
        if macro950SignalNow and not na(macro950Box)
            box.set_border_width(macro950Box, 3)
            box.set_border_color(macro950Box, fpiBorderColor(macro950SignalDirection))

    // Phase-extreme order-block engine. Every completed run is retained in the library.
    // The active bullish candidate is the lowest RESPECTED surviving bullish OB;
    // the active bearish candidate is the highest RESPECTED surviving bearish OB.
    // A lower/higher unconfirmed or failed candidate can no longer hide a valid setup.
    bool orderBlockSignalNow = false
    int orderBlockSignalDirection = 0
    float orderBlockSignalTop = na
    float orderBlockSignalBottom = na
    int orderBlockSignalSourceBar = na
    int orderBlockSignalSourceWindow = -1
    box orderBlockSignalBox = na
    bool seriesObValidationNow = false
    int seriesObValidationDirection = 0
    float seriesObValidationTop = na
    float seriesObValidationBottom = na
    int seriesObValidationEndBar = na

    if cfg.enableBot and isOneMinute and inSession and barstate.isconfirmed
        stateManager.ObDecision obDecision = stateManager.stepObRegistry(
            obRegistryState,
            sessionStart or nyPhaseChanged,
            activeNyPhase,
            bar_index,
            time,
            open,
            high,
            low,
            close
        )

        bullishObCandidateFound := obDecision.bullFound
        bullishObCandidateTop := obDecision.bullTop
        bullishObCandidateBottom := obDecision.bullBottom
        bullishObCandidateStartTime := obDecision.bullStartTime
        bullishObCandidateEndBar := obDecision.bullEndBar
        bullishObBreakConfirmed := obDecision.bullBreakConfirmed
        bullishObBreakBar := obDecision.bullBreakBar
        bullishObCandidateUsed := obDecision.bullUsed

        bearishObCandidateFound := obDecision.bearFound
        bearishObCandidateTop := obDecision.bearTop
        bearishObCandidateBottom := obDecision.bearBottom
        bearishObCandidateStartTime := obDecision.bearStartTime
        bearishObCandidateEndBar := obDecision.bearEndBar
        bearishObBreakConfirmed := obDecision.bearBreakConfirmed
        bearishObBreakBar := obDecision.bearBreakBar
        bearishObCandidateUsed := obDecision.bearUsed

        // A close beyond the complete consecutive-candle series validates the OB.
        // It arms the OB half of a later OB + inverse-IMB sequence; it is not a
        // standalone entry and does not require an immediate OB retest.
        if obDecision.bullValidation
            seriesObValidationNow := true
            seriesObValidationDirection := 1
            seriesObValidationTop := obDecision.bullValidationTop
            seriesObValidationBottom := obDecision.bullValidationBottom
            seriesObValidationEndBar := obDecision.bullValidationEndBar
            if drawStructureVisuals
                box.new(left=obDecision.bullValidationStartTime, top=seriesObValidationTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=seriesObValidationBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(1), border_width=2, bgcolor=fpiFillColor(1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BULLISH SERIES OB VALIDATED" : "", text_size=size.large, text_color=fpiBorderColor(1), text_halign=text.align_center, text_valign=text.align_center)
        else if obDecision.bearValidation
            seriesObValidationNow := true
            seriesObValidationDirection := -1
            seriesObValidationTop := obDecision.bearValidationTop
            seriesObValidationBottom := obDecision.bearValidationBottom
            seriesObValidationEndBar := obDecision.bearValidationEndBar
            if drawStructureVisuals
                box.new(left=obDecision.bearValidationStartTime, top=seriesObValidationTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=seriesObValidationBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(-1), border_width=2, bgcolor=fpiFillColor(-1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BEARISH SERIES OB VALIDATED" : "", text_size=size.large, text_color=fpiBorderColor(-1), text_halign=text.align_center, text_valign=text.align_center)

        if obDecision.bullSignal
            orderBlockSignalNow := true
            orderBlockSignalDirection := 1
            orderBlockSignalTop := obDecision.bullSignalTop
            orderBlockSignalBottom := obDecision.bullSignalBottom
            orderBlockSignalSourceBar := obDecision.bullSignalEndBar
            orderBlockSignalSourceWindow := windowIdFromTimestamp(obDecision.bullSignalStartTime)
            if drawStructureVisuals
                orderBlockSignalBox := box.new(left=obDecision.bullSignalStartTime, top=orderBlockSignalTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=orderBlockSignalBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(1), border_width=2, bgcolor=fpiFillColor(1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BULLISH RESPECTED OB" : "", text_size=size.large, text_color=fpiBorderColor(1), text_halign=text.align_center, text_valign=text.align_center)
        else if obDecision.bearSignal
            orderBlockSignalNow := true
            orderBlockSignalDirection := -1
            orderBlockSignalTop := obDecision.bearSignalTop
            orderBlockSignalBottom := obDecision.bearSignalBottom
            orderBlockSignalSourceBar := obDecision.bearSignalEndBar
            orderBlockSignalSourceWindow := windowIdFromTimestamp(obDecision.bearSignalStartTime)
            if drawStructureVisuals
                orderBlockSignalBox := box.new(left=obDecision.bearSignalStartTime, top=orderBlockSignalTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=orderBlockSignalBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(-1), border_width=2, bgcolor=fpiFillColor(-1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BEARISH RESPECTED OB" : "", text_size=size.large, text_color=fpiBorderColor(-1), text_halign=text.align_center, text_valign=text.align_center)

    // Dedicated 9:50 Macro BGOB lifecycle.
    // The original Macro-FPI third candle becomes an opposite-direction breaker only
    // after a completed close through the corresponding far edge. It then remains
    // active across later AM intervals until its first valid retest or failure.
    bool macro950BgobSignalNow = false
    int macro950BgobSignalDirection = 0
    float macro950BgobSignalTop = na
    float macro950BgobSignalBottom = na
    int macro950BgobSignalFormationBar = na

    if cfg.enableBot and isOneMinute and activeNyPhase == SESSION_PHASE_AM and inSession and barstate.isconfirmed and macro950BgobActive and not macro950BgobUsed and not na(macro950BgobFormationBar) and bar_index > macro950BgobFormationBar
        if not macro950BgobFlipConfirmed
            bool macroBgobCloseThroughFarEdge = macro950BgobOriginalDirection == -1 ? close > macro950BgobTop : close < macro950BgobBottom
            if macroBgobCloseThroughFarEdge
                macro950BgobFlipConfirmed := true
                macro950BgobDirection := -macro950BgobOriginalDirection
                macro950BgobFlipBar := bar_index
                if drawStructureVisuals
                    macro950BgobBox := box.new(left=macro950BgobStartTime, top=macro950BgobTop, right=minuteTimestamp(NY_AM_END_MINUTE), bottom=macro950BgobBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(macro950BgobDirection), border_width=2, bgcolor=fpiFillColor(macro950BgobDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? "9:50 MACRO BGOB" + (macro950BgobDirection == 1 ? "+" : "-") : "", text_size=size.large, text_color=fpiBorderColor(macro950BgobDirection), text_halign=text.align_center, text_valign=text.align_center)
        else if not na(macro950BgobFlipBar) and bar_index > macro950BgobFlipBar
            float macroBgobMidpoint = (macro950BgobTop + macro950BgobBottom) / 2.0
            bool macroBgobRetest = low <= macro950BgobTop and high >= macro950BgobBottom
            bool macroBgobFailed = macro950BgobDirection == 1 ? low < macroBgobMidpoint : high > macroBgobMidpoint
            bool macroBgobDirectionalClose = macro950BgobDirection == 1 ? close > macro950BgobTop and close > open : close < macro950BgobBottom and close < open
            if macroBgobRetest and macroBgobFailed
                macro950BgobActive := false
            else if macroBgobRetest and macroBgobDirectionalClose
                macro950BgobUsed := true
                macro950BgobSignalNow := true
                macro950BgobSignalDirection := macro950BgobDirection
                macro950BgobSignalTop := macro950BgobTop
                macro950BgobSignalBottom := macro950BgobBottom
                macro950BgobSignalFormationBar := macro950BgobFormationBar

    // Untested-FPI BGOB lifecycle, independently retained for every exact 30-minute period:
    //   formation = selected FPI's third candle full range,
    //   break = a later close beyond that candle in the FPI direction while its near edge holds,
    //   retest = a still-later overlap plus bullish close above the high / bearish close below the low.
    // A wick beyond the far edge invalidates the BGOB before it can signal. Each BGOB is one-shot.
    bool bgobSignalNow = false
    int bgobSignalDirection = 0
    float bgobSignalTop = na
    float bgobSignalBottom = na
    int bgobSignalWindow = -1
    int bgobSignalFormationBar = na

    // Discover every imbalance while retaining the phase extreme through 30-minute
    // dividers. The lowest bullish / highest bearish imbalance is the structural
    // candidate. It must break away, then receive a later overlap and outside close.
    if cfg.enableBot and isOneMinute and inSession and barstate.isconfirmed
        int intervalImbalanceDirection = fpiDirection()
        if middleWindow == currentWindow and intervalImbalanceDirection != 0
            float intervalImbalanceTop = fpiTop()
            float intervalImbalanceBottom = fpiBottom()
            if currentWindow >= 0
                bool outerBgobExists = array.get(bgobValidByWindow, currentWindow) or array.get(bgobUsedByWindow, currentWindow)
                int outerBgobDirection = array.get(bgobDirectionByWindow, currentWindow)
                float outerBgobTop = array.get(bgobTopByWindow, currentWindow)
                float outerBgobBottom = array.get(bgobBottomByWindow, currentWindow)
                bool nestedInsideOuter = outerBgobExists and outerBgobDirection == intervalImbalanceDirection and not na(outerBgobTop) and not na(outerBgobBottom) and intervalImbalanceTop <= outerBgobTop and intervalImbalanceBottom >= outerBgobBottom
                if nestedInsideOuter
                    bool replaceNested = not array.get(nestedBgobImbValidByWindow, currentWindow) or (intervalImbalanceDirection == 1 ? intervalImbalanceBottom < array.get(nestedBgobImbBottomByWindow, currentWindow) : intervalImbalanceTop > array.get(nestedBgobImbTopByWindow, currentWindow))
                    if replaceNested
                        array.set(nestedBgobImbValidByWindow, currentWindow, true)
                        array.set(nestedBgobImbUsedByWindow, currentWindow, false)
                        array.set(nestedBgobImbDirectionByWindow, currentWindow, intervalImbalanceDirection)
                        array.set(nestedBgobImbTopByWindow, currentWindow, intervalImbalanceTop)
                        array.set(nestedBgobImbBottomByWindow, currentWindow, intervalImbalanceBottom)
                        array.set(nestedBgobOuterTopByWindow, currentWindow, outerBgobTop)
                        array.set(nestedBgobOuterBottomByWindow, currentWindow, outerBgobBottom)
                        array.set(nestedBgobImbFormationBarByWindow, currentWindow, bar_index)
                        array.set(nestedBgobImbStartTimeByWindow, currentWindow, time[2])
                        array.set(nestedBgobImbBreakConfirmedByWindow, currentWindow, false)
                        array.set(nestedBgobImbBreakBarByWindow, currentWindow, na)
            if intervalImbalanceDirection == 1
                bool replaceBullishImbalance = not bullishImbCandidateFound or intervalImbalanceBottom < bullishImbCandidateBottom
                if replaceBullishImbalance
                    bullishImbCandidateFound := true
                    bullishImbCandidateTop := intervalImbalanceTop
                    bullishImbCandidateBottom := intervalImbalanceBottom
                    bullishImbFormationBar := bar_index
                    bullishImbStartTime := time[2]
                    bullishImbBreakConfirmed := false
                    bullishImbBreakBar := na
                    bullishImbCandidateUsed := false
            else
                bool replaceBearishImbalance = not bearishImbCandidateFound or intervalImbalanceTop > bearishImbCandidateTop
                if replaceBearishImbalance
                    bearishImbCandidateFound := true
                    bearishImbCandidateTop := intervalImbalanceTop
                    bearishImbCandidateBottom := intervalImbalanceBottom
                    bearishImbFormationBar := bar_index
                    bearishImbStartTime := time[2]
                    bearishImbBreakConfirmed := false
                    bearishImbBreakBar := na
                    bearishImbCandidateUsed := false

            if cfg.allowOpposingImbFoundationPair
                if intervalImbalanceDirection == -1
                    bool replaceLowerBearImb = not bullPairBearImbFound or na(bullPairBearImbBottom) or intervalImbalanceBottom < bullPairBearImbBottom
                    if replaceLowerBearImb
                        bullPairBearImbFound := true
                        bullPairBearImbTop := intervalImbalanceTop
                        bullPairBearImbBottom := intervalImbalanceBottom
                        bullPairBearImbFormationBar := bar_index
                        bullPairBearImbStartTime := time[2]
                        bullPairBearImbWindow := currentWindow
                        bullPairBearImbReclaimConfirmed := false
                        bullPairBearImbReclaimBar := na
                        bullPairBearImbUsed := false
                else if intervalImbalanceDirection == 1
                    bool replaceHigherBullImb = not bearPairBullImbFound or na(bearPairBullImbTop) or intervalImbalanceTop > bearPairBullImbTop
                    if replaceHigherBullImb
                        bearPairBullImbFound := true
                        bearPairBullImbTop := intervalImbalanceTop
                        bearPairBullImbBottom := intervalImbalanceBottom
                        bearPairBullImbFormationBar := bar_index
                        bearPairBullImbStartTime := time[2]
                        bearPairBullImbWindow := currentWindow
                        bearPairBullImbReclaimConfirmed := false
                        bearPairBullImbReclaimBar := na
                        bearPairBullImbUsed := false

        if bullishImbCandidateFound and not bullishImbCandidateUsed and bar_index > bullishImbFormationBar
            if close < bullishImbCandidateBottom
                bullishImbCandidateFound := false
            else if not bullishImbBreakConfirmed and close > bullishImbCandidateTop
                bullishImbBreakConfirmed := true
                bullishImbBreakBar := bar_index
            else if bullishImbBreakConfirmed and bar_index > bullishImbBreakBar
                bool bullishImbalanceRetest = low <= bullishImbCandidateTop and high >= bullishImbCandidateBottom
                if bullishImbalanceRetest and close > bullishImbCandidateTop
                    bullishImbCandidateUsed := true
                    bgobSignalNow := true
                    bgobSignalDirection := 1
                    bgobSignalTop := bullishImbCandidateTop
                    bgobSignalBottom := bullishImbCandidateBottom
                    bgobSignalWindow := currentWindow
                    bgobSignalFormationBar := bullishImbFormationBar
                    if drawStructureVisuals
                        box.new(left=bullishImbStartTime, top=bullishImbCandidateTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=bullishImbCandidateBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(1), border_width=2, bgcolor=fpiFillColor(1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BULLISH IMB" : "", text_size=size.large, text_color=fpiBorderColor(1), text_halign=text.align_center, text_valign=text.align_center)

        if bearishImbCandidateFound and not bearishImbCandidateUsed and bar_index > bearishImbFormationBar
            if close > bearishImbCandidateTop
                bearishImbCandidateFound := false
            else if not bearishImbBreakConfirmed and close < bearishImbCandidateBottom
                bearishImbBreakConfirmed := true
                bearishImbBreakBar := bar_index
            else if bearishImbBreakConfirmed and bar_index > bearishImbBreakBar
                bool bearishImbalanceRetest = high >= bearishImbCandidateBottom and low <= bearishImbCandidateTop
                if bearishImbalanceRetest and close < bearishImbCandidateBottom
                    bearishImbCandidateUsed := true
                    bgobSignalNow := true
                    bgobSignalDirection := -1
                    bgobSignalTop := bearishImbCandidateTop
                    bgobSignalBottom := bearishImbCandidateBottom
                    bgobSignalWindow := currentWindow
                    bgobSignalFormationBar := bearishImbFormationBar
                    if drawStructureVisuals
                        box.new(left=bearishImbStartTime, top=bearishImbCandidateTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=bearishImbCandidateBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(-1), border_width=2, bgcolor=fpiFillColor(-1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BEARISH IMB" : "", text_size=size.large, text_color=fpiBorderColor(-1), text_halign=text.align_center, text_valign=text.align_center)

    // Opposing IMB reversal component. This is not a direct trade and is not BGOB.
    // It is one half of an OB + IMB sequence. The second completed component triggers.
    bool bullOpposingImbSignalNow = false
    float bullOpposingImbTop = na
    float bullOpposingImbBottom = na
    int bullOpposingImbWindow = -1
    bool bearOpposingImbSignalNow = false
    float bearOpposingImbTop = na
    float bearOpposingImbBottom = na
    int bearOpposingImbWindow = -1

    if cfg.allowOpposingImbFoundationPair and cfg.enableBot and isOneMinute and inSession and barstate.isconfirmed
        if bullPairBearImbFound and not bullPairBearImbUsed and not na(bullPairBearImbFormationBar) and bar_index > bullPairBearImbFormationBar
            if not bullPairBearImbReclaimConfirmed
                if close > bullPairBearImbTop
                    bullPairBearImbReclaimConfirmed := true
                    bullPairBearImbReclaimBar := bar_index
            else
                if close < bullPairBearImbBottom
                    bullPairBearImbReclaimConfirmed := false
                    bullPairBearImbReclaimBar := na
                else if not na(bullPairBearImbReclaimBar) and bar_index > bullPairBearImbReclaimBar
                    bool bullPairRetest = low <= bullPairBearImbTop and high >= bullPairBearImbBottom
                    if bullPairRetest and close > bullPairBearImbTop
                        bullPairBearImbUsed := true
                        bullOpposingImbSignalNow := true
                        bullOpposingImbTop := bullPairBearImbTop
                        bullOpposingImbBottom := bullPairBearImbBottom
                        bullOpposingImbWindow := bullPairBearImbWindow
                        int bullPairStoreWindow = currentWindow >= 0 ? currentWindow : bullPairBearImbWindow
                        if bullPairStoreWindow >= 0
                            array.set(intervalBullOpposingImbValidated, bullPairStoreWindow, true)
                        if drawStructureVisuals
                            box.new(left=bullPairBearImbStartTime, top=bullPairBearImbTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=bullPairBearImbBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(1), border_width=2, bgcolor=fpiFillColor(1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BULLISH INVERSE IMB" : "", text_size=size.large, text_color=fpiBorderColor(1), text_halign=text.align_center, text_valign=text.align_center)

        if bearPairBullImbFound and not bearPairBullImbUsed and not na(bearPairBullImbFormationBar) and bar_index > bearPairBullImbFormationBar
            if not bearPairBullImbReclaimConfirmed
                if close < bearPairBullImbBottom
                    bearPairBullImbReclaimConfirmed := true
                    bearPairBullImbReclaimBar := bar_index
            else
                if close > bearPairBullImbTop
                    bearPairBullImbReclaimConfirmed := false
                    bearPairBullImbReclaimBar := na
                else if not na(bearPairBullImbReclaimBar) and bar_index > bearPairBullImbReclaimBar
                    bool bearPairRetest = high >= bearPairBullImbBottom and low <= bearPairBullImbTop
                    if bearPairRetest and close < bearPairBullImbBottom
                        bearPairBullImbUsed := true
                        bearOpposingImbSignalNow := true
                        bearOpposingImbTop := bearPairBullImbTop
                        bearOpposingImbBottom := bearPairBullImbBottom
                        bearOpposingImbWindow := bearPairBullImbWindow
                        int bearPairStoreWindow = currentWindow >= 0 ? currentWindow : bearPairBullImbWindow
                        if bearPairStoreWindow >= 0
                            array.set(intervalBearOpposingImbValidated, bearPairStoreWindow, true)
                        if drawStructureVisuals
                            box.new(left=bearPairBullImbStartTime, top=bearPairBullImbTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=bearPairBullImbBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(-1), border_width=2, bgcolor=fpiFillColor(-1, cfg.fpiBoxTransparency), text=drawStructureTags ? "BEARISH INVERSE IMB" : "", text_size=size.large, text_color=fpiBorderColor(-1), text_halign=text.align_center, text_valign=text.align_center)

    if cfg.enableBot and isOneMinute and inSession and barstate.isconfirmed
        for candidateWindow = 0 to LAST_WINDOW_ID
            bool candidateValid = array.get(bgobValidByWindow, candidateWindow)
            bool candidateUsed = array.get(bgobUsedByWindow, candidateWindow)
            int candidateDirection = array.get(bgobDirectionByWindow, candidateWindow)
            float candidateTop = array.get(bgobTopByWindow, candidateWindow)
            float candidateBottom = array.get(bgobBottomByWindow, candidateWindow)
            int candidateFormationBar = array.get(bgobFormationBarByWindow, candidateWindow)
            bool candidateBreakConfirmed = array.get(bgobBreakConfirmedByWindow, candidateWindow)
            int candidateBreakBar = array.get(bgobBreakBarByWindow, candidateWindow)

            if candidateWindow == currentWindow and candidateValid and not candidateUsed and candidateDirection != 0 and not na(candidateFormationBar) and bar_index > candidateFormationBar
                bool tradedThroughFpiEdge = candidateDirection == 1 ? low < candidateBottom : high > candidateTop

                if tradedThroughFpiEdge
                    array.set(bgobValidByWindow, candidateWindow, false)
                else if not candidateBreakConfirmed
                    bool brokeAway = candidateDirection == 1 ? close > candidateTop : close < candidateBottom
                    if brokeAway
                        array.set(bgobBreakConfirmedByWindow, candidateWindow, true)
                        array.set(bgobBreakBarByWindow, candidateWindow, bar_index)
                else if not na(candidateBreakBar) and bar_index > candidateBreakBar
                    bool retestedFullCandle = high >= candidateBottom and low <= candidateTop
                    float candidateMidpoint = (candidateTop + candidateBottom) / 2.0
                    bool penetratedBeyondMidpoint = candidateDirection == 1 ? low < candidateMidpoint : high > candidateMidpoint
                    bool directionalOutsideClose = candidateDirection == 1 ? close > candidateTop and close > open : close < candidateBottom and close < open
                    bool successfulRetest = retestedFullCandle and not penetratedBeyondMidpoint and directionalOutsideClose

                    if retestedFullCandle and penetratedBeyondMidpoint
                        array.set(bgobValidByWindow, candidateWindow, false)
                    else if successfulRetest
                        // Consume every simultaneous valid retest once. The most recent period
                        // wins if an unusually large candle confirms more than one zone at once.
                        array.set(bgobUsedByWindow, candidateWindow, true)
                        array.set(bgobValidByWindow, candidateWindow, false)
                        if candidateWindow >= bgobSignalWindow
                            bgobSignalNow := true
                            bgobSignalDirection := candidateDirection
                            bgobSignalTop := candidateTop
                            bgobSignalBottom := candidateBottom
                            bgobSignalWindow := candidateWindow
                            bgobSignalFormationBar := candidateFormationBar

    // An IMB fully inside a same-direction BGOB is a precision trigger.
    // The outer BGOB already supplies displacement and structural authority, so the
    // inner IMB enters on its FIRST later retest plus directional outside close.
    // The outer BGOB midpoint remains the invalidation/hold boundary.
    bool nestedBgobImbSignalNow = false
    int nestedBgobImbSignalDirection = 0
    float nestedBgobImbSignalOuterTop = na
    float nestedBgobImbSignalOuterBottom = na
    float nestedBgobImbSignalInnerTop = na
    float nestedBgobImbSignalInnerBottom = na
    int nestedBgobImbSignalWindow = -1
    int nestedBgobImbSignalFormationBar = na
    int nestedBgobImbSignalStartTime = na

    if cfg.enableBot and isOneMinute and inSession and barstate.isconfirmed and currentWindow >= 0
        bool nestedValid = array.get(nestedBgobImbValidByWindow, currentWindow)
        bool nestedUsed = array.get(nestedBgobImbUsedByWindow, currentWindow)
        int nestedDirection = array.get(nestedBgobImbDirectionByWindow, currentWindow)
        float nestedTop = array.get(nestedBgobImbTopByWindow, currentWindow)
        float nestedBottom = array.get(nestedBgobImbBottomByWindow, currentWindow)
        float nestedOuterTop = array.get(nestedBgobOuterTopByWindow, currentWindow)
        float nestedOuterBottom = array.get(nestedBgobOuterBottomByWindow, currentWindow)
        int nestedFormationBar = array.get(nestedBgobImbFormationBarByWindow, currentWindow)
        bool nestedBreakConfirmed = array.get(nestedBgobImbBreakConfirmedByWindow, currentWindow)
        int nestedBreakBar = array.get(nestedBgobImbBreakBarByWindow, currentWindow)

        if nestedValid and not nestedUsed and nestedDirection != 0 and not na(nestedFormationBar) and bar_index > nestedFormationBar
            float nestedOuterMidpoint = (nestedOuterTop + nestedOuterBottom) / 2.0
            bool outerFoundationFailed = nestedDirection == 1 ? low < nestedOuterMidpoint : high > nestedOuterMidpoint
            bool nestedRetest = low <= nestedTop and high >= nestedBottom
            float nestedMidpoint = (nestedTop + nestedBottom) / 2.0
            // The outer BGOB already proves displacement. The inner IMB only times the
            // entry, so its first rejection close may confirm from the midpoint instead
            // of waiting for a full close through the far edge of the inner zone.
            bool nestedDirectionalClose = nestedDirection == 1 ? close > (cfg.useNestedBgobMidpointConfirmation ? nestedMidpoint : nestedTop) and close > open : close < (cfg.useNestedBgobMidpointConfirmation ? nestedMidpoint : nestedBottom) and close < open
            if outerFoundationFailed
                array.set(nestedBgobImbValidByWindow, currentWindow, false)
            else if nestedRetest and nestedDirectionalClose
                array.set(nestedBgobImbUsedByWindow, currentWindow, true)
                array.set(nestedBgobImbBreakConfirmedByWindow, currentWindow, true)
                array.set(nestedBgobImbBreakBarByWindow, currentWindow, bar_index)
                nestedBgobImbSignalNow := true
                nestedBgobImbSignalDirection := nestedDirection
                nestedBgobImbSignalOuterTop := nestedOuterTop
                nestedBgobImbSignalOuterBottom := nestedOuterBottom
                nestedBgobImbSignalInnerTop := nestedTop
                nestedBgobImbSignalInnerBottom := nestedBottom
                nestedBgobImbSignalWindow := currentWindow
                nestedBgobImbSignalFormationBar := nestedFormationBar
                nestedBgobImbSignalStartTime := array.get(nestedBgobImbStartTimeByWindow, currentWindow)

    if nestedBgobImbSignalNow
        // Nested timing takes priority because it is the more precise confirmation,
        // while the complete BGOB remains the governing structural zone.
        bgobSignalNow := true
        bgobSignalDirection := nestedBgobImbSignalDirection
        bgobSignalTop := nestedBgobImbSignalOuterTop
        bgobSignalBottom := nestedBgobImbSignalOuterBottom
        bgobSignalWindow := nestedBgobImbSignalWindow
        bgobSignalFormationBar := nestedBgobImbSignalFormationBar
        if drawStructureVisuals
            box.new(left=nestedBgobImbSignalStartTime, top=nestedBgobImbSignalInnerTop, right=minuteTimestamp(periodEndMinute(currentWindow)), bottom=nestedBgobImbSignalInnerBottom, xloc=xloc.bar_time, border_color=fpiBorderColor(nestedBgobImbSignalDirection), border_width=2, bgcolor=fpiFillColor(nestedBgobImbSignalDirection, cfg.fpiBoxTransparency), text=drawStructureTags ? "IMB INSIDE BGOB" : "", text_size=size.large, text_color=fpiBorderColor(nestedBgobImbSignalDirection), text_halign=text.align_center, text_valign=text.align_center)

    if macro950BgobSignalNow
        // A confirmed Macro BGOB is both executable structure and durable MMBM/MMSM
        // confluence. Its source candle remains the governing structural zone.
        bgobSignalNow := true
        bgobSignalDirection := macro950BgobSignalDirection
        bgobSignalTop := macro950BgobSignalTop
        bgobSignalBottom := macro950BgobSignalBottom
        bgobSignalWindow := currentWindow
        bgobSignalFormationBar := macro950BgobSignalFormationBar

    // Component events used by the order-independent sequence engine.
    // A series-OB validation arms the OB. A later inverse-IMB retest may be the
    // executable second component without waiting for another OB retest.
    bool bullishObComponentNow = orderBlockSignalNow and orderBlockSignalDirection == 1
    bool bearishObComponentNow = orderBlockSignalNow and orderBlockSignalDirection == -1
    bool bullishAlignedImbComponentNow = bgobSignalNow and bgobSignalDirection == 1
    bool bearishAlignedImbComponentNow = bgobSignalNow and bgobSignalDirection == -1
    bool bullishImbComponentNow = bullishAlignedImbComponentNow or bullOpposingImbSignalNow
    bool bearishImbComponentNow = bearishAlignedImbComponentNow or bearOpposingImbSignalNow
    float bullishImbComponentTop = bullOpposingImbSignalNow ? bullOpposingImbTop : bullishAlignedImbComponentNow ? bgobSignalTop : na
    float bullishImbComponentBottom = bullOpposingImbSignalNow ? bullOpposingImbBottom : bullishAlignedImbComponentNow ? bgobSignalBottom : na
    float bearishImbComponentTop = bearOpposingImbSignalNow ? bearOpposingImbTop : bearishAlignedImbComponentNow ? bgobSignalTop : na
    float bearishImbComponentBottom = bearOpposingImbSignalNow ? bearOpposingImbBottom : bearishAlignedImbComponentNow ? bgobSignalBottom : na

    // FPI context alone never enters. A valid interval entry requires:
    // accepted/respected FPI -> later physical retest/rejection -> fresh OB or BGOB
    // whose source belongs to this exact 30-minute interval.
    bool intervalFoundationSignalNow = false
    int intervalFoundationSignalDirection = 0
    float intervalFoundationSignalTop = na
    float intervalFoundationSignalBottom = na
    int intervalFoundationSignalKind = SOURCE_NONE
    if currentWindow >= 0 and array.get(selectedByWindow, currentWindow)
        int intervalOriginalDirection = array.get(intervalFpiOriginalDirection, currentWindow)
        float intervalSelectedTop = array.get(intervalFpiTop, currentWindow)
        float intervalSelectedBottom = array.get(intervalFpiBottom, currentWindow)
        bool intervalFailureClose = (intervalOriginalDirection == 1 ? close < intervalSelectedBottom : close > intervalSelectedTop) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-intervalOriginalDirection))

        if intervalFailureClose
            array.set(intervalFpiDisrespected, currentWindow, true)

        bool intervalIsDisrespected = array.get(intervalFpiDisrespected, currentWindow)
        bool intervalFpiRespectConfirmed = array.get(intervalFpiRespected, currentWindow) and not intervalIsDisrespected
        bool currentIntervalObSignal = orderBlockSignalNow and orderBlockSignalSourceWindow == currentWindow
        bool currentIntervalBgobSignal = bgobSignalNow and bgobSignalWindow == currentWindow
        bool rawStructureSignal = currentIntervalObSignal or currentIntervalBgobSignal
        int rawStructureDirection = currentIntervalObSignal ? orderBlockSignalDirection : currentIntervalBgobSignal ? bgobSignalDirection : 0

        if currentIntervalObSignal
            if orderBlockSignalDirection == 1
                array.set(intervalBullStructureValidated, currentWindow, true)
                array.set(intervalBullObValidated, currentWindow, true)
                array.set(intervalBullStructureTop, currentWindow, orderBlockSignalTop)
                array.set(intervalBullStructureBottom, currentWindow, orderBlockSignalBottom)
                array.set(intervalBullStructureKind, currentWindow, SOURCE_ORDER_BLOCK)
            else
                array.set(intervalBearStructureValidated, currentWindow, true)
                array.set(intervalBearObValidated, currentWindow, true)
                array.set(intervalBearStructureTop, currentWindow, orderBlockSignalTop)
                array.set(intervalBearStructureBottom, currentWindow, orderBlockSignalBottom)
                array.set(intervalBearStructureKind, currentWindow, SOURCE_ORDER_BLOCK)

        if currentIntervalBgobSignal
            if bgobSignalDirection == 1
                array.set(intervalBullStructureValidated, currentWindow, true)
                array.set(intervalBullImbValidated, currentWindow, true)
                array.set(intervalBullStructureTop, currentWindow, bgobSignalTop)
                array.set(intervalBullStructureBottom, currentWindow, bgobSignalBottom)
                array.set(intervalBullStructureKind, currentWindow, SOURCE_BGOB)
            else
                array.set(intervalBearStructureValidated, currentWindow, true)
                array.set(intervalBearImbValidated, currentWindow, true)
                array.set(intervalBearStructureTop, currentWindow, bgobSignalTop)
                array.set(intervalBearStructureBottom, currentWindow, bgobSignalBottom)
                array.set(intervalBearStructureKind, currentWindow, SOURCE_BGOB)

        // Opposite-current-FPI structures are reserved for the sequence engine below.
        bool bullishSequenceContext = cfg.enableSequenceEngine and intervalOriginalDirection == -1
        bool bearishSequenceContext = cfg.enableSequenceEngine and intervalOriginalDirection == 1
        bool bullishFpiStateAllows = reversalModeActive ? reversalModeDirection == 1 and intervalOriginalDirection == 1 : intervalOriginalDirection == 1
        bool bearishFpiStateAllows = reversalModeActive ? reversalModeDirection == -1 and intervalOriginalDirection == -1 : intervalOriginalDirection == -1
        bool bullishFoundationReady = array.get(intervalBullStructureValidated, currentWindow)
        bool bearishFoundationReady = array.get(intervalBearStructureValidated, currentWindow)
        bool bullishTriggerNow = intervalFpiRespectConfirmed and rawStructureSignal and rawStructureDirection == 1
        bool bearishTriggerNow = intervalFpiRespectConfirmed and rawStructureSignal and rawStructureDirection == -1

        if bullishFpiStateAllows and bullishFoundationReady and bullishTriggerNow and not bullishSequenceContext and not array.get(intervalBullEntryUsed, currentWindow)
            intervalFoundationSignalNow := true
            intervalFoundationSignalDirection := 1
            intervalFoundationSignalTop := array.get(intervalBullStructureTop, currentWindow)
            intervalFoundationSignalBottom := array.get(intervalBullStructureBottom, currentWindow)
            intervalFoundationSignalKind := array.get(intervalBullStructureKind, currentWindow)
        else if bearishFpiStateAllows and bearishFoundationReady and bearishTriggerNow and not bearishSequenceContext and not array.get(intervalBearEntryUsed, currentWindow)
            intervalFoundationSignalNow := true
            intervalFoundationSignalDirection := -1
            intervalFoundationSignalTop := array.get(intervalBearStructureTop, currentWindow)
            intervalFoundationSignalBottom := array.get(intervalBearStructureBottom, currentWindow)
            intervalFoundationSignalKind := array.get(intervalBearStructureKind, currentWindow)

    // Find the most recent opposing interval FPI in the active NY phase. A pair may
    // begin in one 30-minute window and complete in the next; the current window's FPI
    // must not erase a valid earlier Judas/reversal sequence.
    int latestBullAgainstFpiWindow = -1
    int latestBearAgainstFpiWindow = -1
    if currentWindow >= 0
        int sequencePhaseStart = phaseStartWindow(activeNyPhase)
        for sequenceWindow = sequencePhaseStart to currentWindow
            if array.get(selectedByWindow, sequenceWindow)
                int sequenceFpiDirection = array.get(intervalFpiOriginalDirection, sequenceWindow)
                if sequenceFpiDirection == -1
                    latestBullAgainstFpiWindow := sequenceWindow
                else if sequenceFpiDirection == 1
                    latestBearAgainstFpiWindow := sequenceWindow

    // The 9:50 Macro FPI governs the complete AM campaign, not only 10:00-10:30.
    // Before a far-edge reversal, its original direction supplies the imbalance half
    // of an OB + Macro-FPI foundation. After a confirmed far-edge reversal, the new
    // authority direction supplies that component through 11:30.
    bool macro950FoundationWindowActive = cfg.allowMacro950FoundationExpectancy and activeNyPhase == SESSION_PHASE_AM and macro950Found and nowMinute >= MACRO_950_TRADE_START and nowMinute < NY_AM_END_MINUTE
    int macro950ResolvedFoundationDirection = macro950AuthorityRetestConfirmed and macro950AuthorityDirection != 0 ? macro950AuthorityDirection : macro950Direction
    bool bullishMacro950FoundationExpectation = macro950FoundationWindowActive and macro950ResolvedFoundationDirection == 1
    bool bearishMacro950FoundationExpectation = macro950FoundationWindowActive and macro950ResolvedFoundationDirection == -1
    bool bullishMacro950ComponentPulseNow = macro950SignalNow and macro950SignalDirection == 1
    bool bearishMacro950ComponentPulseNow = macro950SignalNow and macro950SignalDirection == -1

    // Persistent stage-aware sequence builder. The phase-extreme OB and IMB do not
    // both need to complete an additional retest. Once both components have accepted
    // away from their zones, the first respected retest of either component may trigger.
    // This preserves the user's order-independent rule:
    //   IMB retest first -> later OB retest is the signal.
    //   OB retest first  -> later IMB retest is the signal.
    if cfg.enableSequenceEngine and isOneMinute and inSession and barstate.isconfirmed
        bool bullishSequenceContextActive = latestBullAgainstFpiWindow >= 0 or bullishMacro950FoundationExpectation
        bool bearishSequenceContextActive = latestBearAgainstFpiWindow >= 0 or bearishMacro950FoundationExpectation

        bool bullObArmed = bullishObCandidateFound and bullishObBreakConfirmed and not na(bullishObCandidateTop) and not na(bullishObCandidateBottom)
        bool bullOpposingImbArmed = cfg.allowOpposingImbFoundationPair and bullPairBearImbFound and bullPairBearImbReclaimConfirmed and not na(bullPairBearImbTop) and not na(bullPairBearImbBottom)
        bool bullAlignedImbArmed = bullishImbCandidateFound and bullishImbBreakConfirmed and not na(bullishImbCandidateTop) and not na(bullishImbCandidateBottom)
        bool bullMacroImbArmed = bullishMacro950FoundationExpectation and not na(macro950Top) and not na(macro950Bottom)
        bool bullImbArmed = bullOpposingImbArmed or bullAlignedImbArmed or bullMacroImbArmed
        bool bullObRetestNow = bullishObComponentNow
        bool bullImbRetestNow = bullishImbComponentNow or bullishMacro950ComponentPulseNow
        bool bullPairRetestTriggerNow = bullishSequenceContextActive and ((bullObRetestNow and bullImbArmed) or (bullImbRetestNow and bullObArmed))

        if bullishSequenceContextActive and (bullObArmed or bullImbArmed or bullObRetestNow or bullImbRetestNow)
            if bullRevFoundationUsed and bullPairRetestTriggerNow
                bullRevFoundationBuilding := false
                bullRevFoundationReady := false
                bullRevFoundationUsed := false
                bullRevFoundationHasOb := false
                bullRevFoundationHasImb := false
                bullRevFoundationTop := na
                bullRevFoundationBottom := na
                bullRevFoundationObTop := na
                bullRevFoundationObBottom := na
                bullRevFoundationImbTop := na
                bullRevFoundationImbBottom := na
                bullRevFoundationWindow := -1
                bullRevFoundationAgainstFpiWindow := -1
                bullRevFoundationConfirmBar := na
            bullRevFoundationBuilding := true
            bullRevFoundationHasOb := bullObArmed or bullObRetestNow
            bullRevFoundationHasImb := bullImbArmed or bullImbRetestNow

            float bullSelectedTop = na
            float bullSelectedBottom = na
            if bullObArmed or bullObRetestNow
                bullSelectedTop := bullishObCandidateTop
                bullSelectedBottom := bullishObCandidateBottom
            bool bullMacroComponentSelected = (bullMacroImbArmed and bullObRetestNow) or (bullishMacro950ComponentPulseNow and bullObArmed)
            float bullImbTopCandidate = bullMacroComponentSelected ? macro950Top : (bullOpposingImbArmed or bullOpposingImbSignalNow) ? bullPairBearImbTop : (bullAlignedImbArmed or bullishAlignedImbComponentNow) ? bullishImbCandidateTop : (bullMacroImbArmed or bullishMacro950ComponentPulseNow) ? macro950Top : na
            float bullImbBottomCandidate = bullMacroComponentSelected ? macro950Bottom : (bullOpposingImbArmed or bullOpposingImbSignalNow) ? bullPairBearImbBottom : (bullAlignedImbArmed or bullishAlignedImbComponentNow) ? bullishImbCandidateBottom : (bullMacroImbArmed or bullishMacro950ComponentPulseNow) ? macro950Bottom : na
            if not na(bullImbBottomCandidate) and (na(bullSelectedBottom) or bullImbBottomCandidate < bullSelectedBottom)
                bullSelectedTop := bullImbTopCandidate
                bullSelectedBottom := bullImbBottomCandidate
            if bullObArmed or bullObRetestNow
                bullRevFoundationObTop := bullishObCandidateTop
                bullRevFoundationObBottom := bullishObCandidateBottom
            if bullImbArmed or bullImbRetestNow
                bullRevFoundationImbTop := bullImbTopCandidate
                bullRevFoundationImbBottom := bullImbBottomCandidate
            if not na(bullSelectedBottom)
                bullRevFoundationTop := bullSelectedTop
                bullRevFoundationBottom := bullSelectedBottom
            bullRevFoundationAgainstFpiWindow := latestBullAgainstFpiWindow

            bool bullComponentsRespectedNow = not na(bullRevFoundationObBottom) and not na(bullRevFoundationImbBottom) and close >= bullRevFoundationObBottom and close >= bullRevFoundationImbBottom
            if bullPairRetestTriggerNow and bullRevFoundationHasOb and bullRevFoundationHasImb and bullComponentsRespectedNow
                bullRevFoundationReady := true
                bullRevFoundationWindow := currentWindow
                bullRevFoundationConfirmBar := bar_index

        bool bearObArmed = bearishObCandidateFound and bearishObBreakConfirmed and not na(bearishObCandidateTop) and not na(bearishObCandidateBottom)
        bool bearOpposingImbArmed = cfg.allowOpposingImbFoundationPair and bearPairBullImbFound and bearPairBullImbReclaimConfirmed and not na(bearPairBullImbTop) and not na(bearPairBullImbBottom)
        bool bearAlignedImbArmed = bearishImbCandidateFound and bearishImbBreakConfirmed and not na(bearishImbCandidateTop) and not na(bearishImbCandidateBottom)
        bool bearMacroImbArmed = bearishMacro950FoundationExpectation and not na(macro950Top) and not na(macro950Bottom)
        bool bearImbArmed = bearOpposingImbArmed or bearAlignedImbArmed or bearMacroImbArmed
        bool bearObRetestNow = bearishObComponentNow
        bool bearImbRetestNow = bearishImbComponentNow or bearishMacro950ComponentPulseNow
        bool bearPairRetestTriggerNow = bearishSequenceContextActive and ((bearObRetestNow and bearImbArmed) or (bearImbRetestNow and bearObArmed))

        if bearishSequenceContextActive and (bearObArmed or bearImbArmed or bearObRetestNow or bearImbRetestNow)
            if bearRevFoundationUsed and bearPairRetestTriggerNow
                bearRevFoundationBuilding := false
                bearRevFoundationReady := false
                bearRevFoundationUsed := false
                bearRevFoundationHasOb := false
                bearRevFoundationHasImb := false
                bearRevFoundationTop := na
                bearRevFoundationBottom := na
                bearRevFoundationObTop := na
                bearRevFoundationObBottom := na
                bearRevFoundationImbTop := na
                bearRevFoundationImbBottom := na
                bearRevFoundationWindow := -1
                bearRevFoundationAgainstFpiWindow := -1
                bearRevFoundationConfirmBar := na
            bearRevFoundationBuilding := true
            bearRevFoundationHasOb := bearObArmed or bearObRetestNow
            bearRevFoundationHasImb := bearImbArmed or bearImbRetestNow

            float bearSelectedTop = na
            float bearSelectedBottom = na
            if bearObArmed or bearObRetestNow
                bearSelectedTop := bearishObCandidateTop
                bearSelectedBottom := bearishObCandidateBottom
            bool bearMacroComponentSelected = (bearMacroImbArmed and bearObRetestNow) or (bearishMacro950ComponentPulseNow and bearObArmed)
            float bearImbTopCandidate = bearMacroComponentSelected ? macro950Top : (bearOpposingImbArmed or bearOpposingImbSignalNow) ? bearPairBullImbTop : (bearAlignedImbArmed or bearishAlignedImbComponentNow) ? bearishImbCandidateTop : (bearMacroImbArmed or bearishMacro950ComponentPulseNow) ? macro950Top : na
            float bearImbBottomCandidate = bearMacroComponentSelected ? macro950Bottom : (bearOpposingImbArmed or bearOpposingImbSignalNow) ? bearPairBullImbBottom : (bearAlignedImbArmed or bearishAlignedImbComponentNow) ? bearishImbCandidateBottom : (bearMacroImbArmed or bearishMacro950ComponentPulseNow) ? macro950Bottom : na
            if not na(bearImbTopCandidate) and (na(bearSelectedTop) or bearImbTopCandidate > bearSelectedTop)
                bearSelectedTop := bearImbTopCandidate
                bearSelectedBottom := bearImbBottomCandidate
            if bearObArmed or bearObRetestNow
                bearRevFoundationObTop := bearishObCandidateTop
                bearRevFoundationObBottom := bearishObCandidateBottom
            if bearImbArmed or bearImbRetestNow
                bearRevFoundationImbTop := bearImbTopCandidate
                bearRevFoundationImbBottom := bearImbBottomCandidate
            if not na(bearSelectedTop)
                bearRevFoundationTop := bearSelectedTop
                bearRevFoundationBottom := bearSelectedBottom
            bearRevFoundationAgainstFpiWindow := latestBearAgainstFpiWindow

            bool bearComponentsRespectedNow = not na(bearRevFoundationObTop) and not na(bearRevFoundationImbTop) and close <= bearRevFoundationObTop and close <= bearRevFoundationImbTop
            if bearPairRetestTriggerNow and bearRevFoundationHasOb and bearRevFoundationHasImb and bearComponentsRespectedNow
                bearRevFoundationReady := true
                bearRevFoundationWindow := currentWindow
                bearRevFoundationConfirmBar := bar_index

    // Resolve stored reversal foundations. When the pair agrees with the active
    // Session and original Macro direction, the second confirmed component may enter
    // during Judas delivery. Counter-controller transitions still require full reclaim.
    bool reversalFoundationSignalNow = false
    int reversalFoundationSignalDirection = 0
    float reversalFoundationSignalTop = na
    float reversalFoundationSignalBottom = na
    int reversalFoundationSignalWindow = -1
    int reversalFoundationSignalAgainstFpiWindow = -1
    bool reversalFoundationEarlyEntryNow = false
    bool reversalFoundationNarrativeConfirmedNow = false

    if cfg.enableSequenceEngine and isOneMinute and inSession and barstate.isconfirmed
        bool bullFoundationFailed = bullRevFoundationBuilding and ((not na(bullRevFoundationObBottom) and close < bullRevFoundationObBottom) or (not na(bullRevFoundationImbBottom) and close < bullRevFoundationImbBottom))
        if bullFoundationFailed
            bullRevFoundationBuilding := false
            bullRevFoundationReady := false
            bullRevFoundationUsed := false
            bullRevFoundationHasOb := false
            bullRevFoundationHasImb := false
            bullRevFoundationTop := na
            bullRevFoundationBottom := na
            bullRevFoundationObTop := na
            bullRevFoundationObBottom := na
            bullRevFoundationImbTop := na
            bullRevFoundationImbBottom := na
            bullRevFoundationWindow := -1
            bullRevFoundationAgainstFpiWindow := -1
            bullRevFoundationConfirmBar := na

        bool bearFoundationFailed = bearRevFoundationBuilding and ((not na(bearRevFoundationObTop) and close > bearRevFoundationObTop) or (not na(bearRevFoundationImbTop) and close > bearRevFoundationImbTop))
        if bearFoundationFailed
            bearRevFoundationBuilding := false
            bearRevFoundationReady := false
            bearRevFoundationUsed := false
            bearRevFoundationHasOb := false
            bearRevFoundationHasImb := false
            bearRevFoundationTop := na
            bearRevFoundationBottom := na
            bearRevFoundationObTop := na
            bearRevFoundationObBottom := na
            bearRevFoundationImbTop := na
            bearRevFoundationImbBottom := na
            bearRevFoundationWindow := -1
            bearRevFoundationAgainstFpiWindow := -1
            bearRevFoundationConfirmBar := na

        bool bullAgainstFpiValid = bullRevFoundationAgainstFpiWindow >= 0 and array.get(selectedByWindow, bullRevFoundationAgainstFpiWindow) and array.get(intervalFpiOriginalDirection, bullRevFoundationAgainstFpiWindow) == -1
        float bullAgainstFpiTop = bullAgainstFpiValid ? array.get(intervalFpiTop, bullRevFoundationAgainstFpiWindow) : na
        bool bullLocalFpiReclaimed = bullAgainstFpiValid and close > bullAgainstFpiTop
        bool bullSessionReclaimed = not sessionAnchorFpiFound or close > sessionAnchorTop
        bool bullMacroReclaimed = activeNyPhase != SESSION_PHASE_AM or not cfg.requireAmMacroReclaim or not macro950Found or (macro950AuthorityDirection == 1 and macro950AuthorityRetestConfirmed)
        bool bullControllerAligned = sessionAnchorFpiFound and sessionAnchorDirection == 1
        bool bullMacroOriginAligned = activeNyPhase != SESSION_PHASE_AM or not macro950Found or macro950Direction == 1
        bool bullMacroFoundationPermission = bullishMacro950FoundationExpectation
        bool bullMacroCloseOverride = activeNyPhase == SESSION_PHASE_AM and macro950Found and macro950Direction == -1 and macro950AuthorityDirection == 1 and macro950AuthorityRetestConfirmed
        bool bullCounterControllerSetup = sessionAnchorFpiFound and sessionAnchorDirection == -1
        bool bullComponentsStillRespected = not na(bullRevFoundationObBottom) and not na(bullRevFoundationImbBottom) and close >= bullRevFoundationObBottom and close >= bullRevFoundationImbBottom
        bool bullFreshFoundationConfirmation = not na(bullRevFoundationConfirmBar) and bar_index == bullRevFoundationConfirmBar
        bool bullInverseImbRetestConfirmation = bullFreshFoundationConfirmation and bullOpposingImbSignalNow and bullRevFoundationHasOb and close > bullRevFoundationImbTop
        bool bullAlignedImbRetestConfirmation = bullFreshFoundationConfirmation and bullishAlignedImbComponentNow and bullRevFoundationHasOb and close > bullRevFoundationImbTop
        bool bullObRetestConfirmation = bullFreshFoundationConfirmation and orderBlockSignalNow and orderBlockSignalDirection == 1 and bullRevFoundationHasImb
        // Inverse-IMB confirmation is structural. The retest candle may close red;
        // what matters is that it overlaps the inverted zone and closes above its top.
        bool bullDirectionalConfirmationClose = bullFreshFoundationConfirmation and (bullInverseImbRetestConfirmation or bullAlignedImbRetestConfirmation or (bullObRetestConfirmation and close > open))
        bool bullConfirmedFromSecondComponent = bullInverseImbRetestConfirmation or bullAlignedImbRetestConfirmation or bullObRetestConfirmation
        float bullFoundationExtensionPoints = not na(bullishObCandidateTop) ? math.max(0.0, close - bullishObCandidateTop) : 1000000.0
        bool bullFoundationNotChased = bullFoundationExtensionPoints <= cfg.maximumEarlyFoundationExtensionPoints
        bool bullQualifiedEarlyPermission = cfg.allowEarlyCounterControllerFoundationEntry and bullCounterControllerSetup and bullFreshFoundationConfirmation and bullConfirmedFromSecondComponent and bullDirectionalConfirmationClose and bullComponentsStillRespected and bullFoundationNotChased
        stateManager.FoundationEntryDecision bullFoundationDecision = stateManager.resolveFoundationEntry(
            1,
            bullRevFoundationReady,
            bullRevFoundationHasOb,
            bullRevFoundationHasImb,
            bullComponentsStillRespected,
            bullRevFoundationUsed,
            bullRevFoundationConfirmBar,
            bar_index,
            bullDirectionalConfirmationClose,
            bullControllerAligned,
            bullMacroOriginAligned,
            bullMacroFoundationPermission,
            bullCounterControllerSetup,
            bullLocalFpiReclaimed,
            bullSessionReclaimed,
            bullMacroReclaimed,
            bullMacroCloseOverride,
            reversalModeActive,
            reversalModeDirection,
            cfg.allowControllerAlignedFoundationEntry,
            bullQualifiedEarlyPermission
        )
        // A stored foundation cannot wait several candles for a later permission event.
        // The structural confirmation candle is the entry; later Macro reclaim upgrades
        // an existing position into campaign hold instead of creating a delayed entry.
        bool bullSequenceReadyNow = bullFoundationDecision.enterNow and (not cfg.requireFreshFoundationSignal or bullFreshFoundationConfirmation)

        bool bearAgainstFpiValid = bearRevFoundationAgainstFpiWindow >= 0 and array.get(selectedByWindow, bearRevFoundationAgainstFpiWindow) and array.get(intervalFpiOriginalDirection, bearRevFoundationAgainstFpiWindow) == 1
        float bearAgainstFpiBottom = bearAgainstFpiValid ? array.get(intervalFpiBottom, bearRevFoundationAgainstFpiWindow) : na
        bool bearLocalFpiReclaimed = bearAgainstFpiValid and close < bearAgainstFpiBottom
        bool bearSessionReclaimed = not sessionAnchorFpiFound or close < sessionAnchorBottom
        bool bearMacroReclaimed = activeNyPhase != SESSION_PHASE_AM or not cfg.requireAmMacroReclaim or not macro950Found or (macro950AuthorityDirection == -1 and macro950AuthorityRetestConfirmed)
        bool bearControllerAligned = sessionAnchorFpiFound and sessionAnchorDirection == -1
        bool bearMacroOriginAligned = activeNyPhase != SESSION_PHASE_AM or not macro950Found or macro950Direction == -1
        bool bearMacroFoundationPermission = bearishMacro950FoundationExpectation
        bool bearMacroCloseOverride = activeNyPhase == SESSION_PHASE_AM and macro950Found and macro950Direction == 1 and macro950AuthorityDirection == -1 and macro950AuthorityRetestConfirmed
        bool bearCounterControllerSetup = sessionAnchorFpiFound and sessionAnchorDirection == 1
        bool bearComponentsStillRespected = not na(bearRevFoundationObTop) and not na(bearRevFoundationImbTop) and close <= bearRevFoundationObTop and close <= bearRevFoundationImbTop
        bool bearFreshFoundationConfirmation = not na(bearRevFoundationConfirmBar) and bar_index == bearRevFoundationConfirmBar
        bool bearInverseImbRetestConfirmation = bearFreshFoundationConfirmation and bearOpposingImbSignalNow and bearRevFoundationHasOb and close < bearRevFoundationImbBottom
        bool bearAlignedImbRetestConfirmation = bearFreshFoundationConfirmation and bearishAlignedImbComponentNow and bearRevFoundationHasOb and close < bearRevFoundationImbBottom
        bool bearObRetestConfirmation = bearFreshFoundationConfirmation and orderBlockSignalNow and orderBlockSignalDirection == -1 and bearRevFoundationHasImb
        bool bearDirectionalConfirmationClose = bearFreshFoundationConfirmation and (bearInverseImbRetestConfirmation or bearAlignedImbRetestConfirmation or (bearObRetestConfirmation and close < open))
        bool bearConfirmedFromSecondComponent = bearInverseImbRetestConfirmation or bearAlignedImbRetestConfirmation or bearObRetestConfirmation
        float bearFoundationExtensionPoints = not na(bearishObCandidateBottom) ? math.max(0.0, bearishObCandidateBottom - close) : 1000000.0
        bool bearFoundationNotChased = bearFoundationExtensionPoints <= cfg.maximumEarlyFoundationExtensionPoints
        bool bearQualifiedEarlyPermission = cfg.allowEarlyCounterControllerFoundationEntry and bearCounterControllerSetup and bearFreshFoundationConfirmation and bearConfirmedFromSecondComponent and bearDirectionalConfirmationClose and bearComponentsStillRespected and bearFoundationNotChased
        stateManager.FoundationEntryDecision bearFoundationDecision = stateManager.resolveFoundationEntry(
            -1,
            bearRevFoundationReady,
            bearRevFoundationHasOb,
            bearRevFoundationHasImb,
            bearComponentsStillRespected,
            bearRevFoundationUsed,
            bearRevFoundationConfirmBar,
            bar_index,
            bearDirectionalConfirmationClose,
            bearControllerAligned,
            bearMacroOriginAligned,
            bearMacroFoundationPermission,
            bearCounterControllerSetup,
            bearLocalFpiReclaimed,
            bearSessionReclaimed,
            bearMacroReclaimed,
            bearMacroCloseOverride,
            reversalModeActive,
            reversalModeDirection,
            cfg.allowControllerAlignedFoundationEntry,
            bearQualifiedEarlyPermission
        )
        bool bearSequenceReadyNow = bearFoundationDecision.enterNow and (not cfg.requireFreshFoundationSignal or bearFreshFoundationConfirmation)

        if bullSequenceReadyNow
            reversalFoundationSignalNow := true
            reversalFoundationSignalDirection := 1
            reversalFoundationSignalTop := bullRevFoundationTop
            reversalFoundationSignalBottom := bullRevFoundationBottom
            reversalFoundationSignalWindow := bullRevFoundationWindow
            reversalFoundationSignalAgainstFpiWindow := bullRevFoundationAgainstFpiWindow
            reversalFoundationEarlyEntryNow := bullFoundationDecision.earlyReversal
            reversalFoundationNarrativeConfirmedNow := bullFoundationDecision.narrativeConfirmed
        else if bearSequenceReadyNow
            reversalFoundationSignalNow := true
            reversalFoundationSignalDirection := -1
            reversalFoundationSignalTop := bearRevFoundationTop
            reversalFoundationSignalBottom := bearRevFoundationBottom
            reversalFoundationSignalWindow := bearRevFoundationWindow
            reversalFoundationSignalAgainstFpiWindow := bearRevFoundationAgainstFpiWindow
            reversalFoundationEarlyEntryNow := bearFoundationDecision.earlyReversal
            reversalFoundationNarrativeConfirmedNow := bearFoundationDecision.narrativeConfirmed

        if cfg.showSequenceStateLabels and reversalFoundationSignalNow
            string sequenceLabel = reversalFoundationEarlyEntryNow ? (reversalFoundationSignalDirection == 1 ? "EARLY BULL FOUNDATION ENTRY" : "EARLY BEAR FOUNDATION ENTRY") : reversalFoundationSignalDirection == 1 ? "BULL NARRATIVE FOUNDATION" : "BEAR NARRATIVE FOUNDATION"
            label.new(x=bar_index, y=reversalFoundationSignalDirection == 1 ? low : high, text=sequenceLabel, yloc=yloc.price, style=label.style_none, textcolor=reversalFoundationSignalDirection == 1 ? color.new(#2b8a3e, 0) : color.new(#c92a2a, 0), size=size.small, textalign=text.align_center)

    // A fully validated interval becomes a durable support interval when bullish or
    // resistance interval when bearish. Qualification requires BOTH the interval FPI
    // respect sequence and a matching structural break/retest/outside-close sequence.
    // The lower bullish / higher bearish component is the interval's master boundary,
    // so a deeper foundation can remain valid after a nearer FPI is disrespected.
    if currentWindow >= 0 and array.get(selectedByWindow, currentWindow) and isOneMinute and inSession and barstate.isconfirmed
        int authorityDirection = array.get(intervalFpiOriginalDirection, currentWindow)
        bool authorityFpiReady = array.get(intervalFpiRespected, currentWindow) and not array.get(intervalFpiDisrespected, currentWindow)
        bool authorityStructureReady = authorityDirection == 1 ? array.get(intervalBullStructureValidated, currentWindow) : array.get(intervalBearStructureValidated, currentWindow)
        if authorityDirection != 0 and authorityFpiReady and authorityStructureReady
            float authorityFpiBoundary = authorityDirection == 1 ? array.get(intervalFpiBottom, currentWindow) : array.get(intervalFpiTop, currentWindow)
            float authorityStructureTop = authorityDirection == 1 ? array.get(intervalBullStructureTop, currentWindow) : array.get(intervalBearStructureTop, currentWindow)
            float authorityStructureBottom = authorityDirection == 1 ? array.get(intervalBullStructureBottom, currentWindow) : array.get(intervalBearStructureBottom, currentWindow)
            int authorityStructureKind = authorityDirection == 1 ? array.get(intervalBullStructureKind, currentWindow) : array.get(intervalBearStructureKind, currentWindow)
            float authorityStructureBoundary = authorityStructureKind == SOURCE_BGOB ? (authorityStructureTop + authorityStructureBottom) / 2.0 : authorityDirection == 1 ? authorityStructureBottom : authorityStructureTop
            bool structureIsMaster = authorityDirection == 1 ? authorityStructureBoundary <= authorityFpiBoundary : authorityStructureBoundary >= authorityFpiBoundary
            float candidateAuthorityBoundary = structureIsMaster ? authorityStructureBoundary : authorityFpiBoundary
            int candidateAuthorityKind = structureIsMaster ? authorityStructureKind : SOURCE_FPI
            bool authorityAlreadyQualified = array.get(intervalAuthorityQualified, currentWindow)
            bool authorityCurrentlyValid = array.get(intervalAuthorityValid, currentWindow)
            float existingAuthorityBoundary = array.get(intervalAuthorityBoundary, currentWindow)
            bool candidateIsMoreExtreme = na(existingAuthorityBoundary) or (authorityDirection == 1 ? candidateAuthorityBoundary < existingAuthorityBoundary : candidateAuthorityBoundary > existingAuthorityBoundary)
            if not authorityAlreadyQualified or (authorityCurrentlyValid and candidateIsMoreExtreme)
                array.set(intervalAuthorityQualified, currentWindow, true)
                array.set(intervalAuthorityValid, currentWindow, true)
                array.set(intervalAuthorityDirection, currentWindow, authorityDirection)
                array.set(intervalAuthorityBoundary, currentWindow, candidateAuthorityBoundary)
                array.set(intervalAuthorityKind, currentWindow, candidateAuthorityKind)
                array.set(intervalAuthorityQualifiedBar, currentWindow, bar_index)

    // Only completed prior windows can hold a later trade; the current interval may
    // qualify now, but it cannot count as its own historical support/resistance.
    int priorIntervalAuthorityCountBefore = 0
    if recordedTradeOpen and strategy.position_size != 0 and currentWindow > 0
        for authorityWindow = recordedTradePhaseStartWindow to LAST_WINDOW_ID
            bool isPriorMatchingAuthority = authorityWindow < currentWindow and array.get(intervalAuthorityValid, authorityWindow) and array.get(intervalAuthorityDirection, authorityWindow) == recordedTradeDirection
            if isPriorMatchingAuthority
                priorIntervalAuthorityCountBefore += 1

    if isOneMinute and inSession and barstate.isconfirmed
        for authorityWindow = 0 to LAST_WINDOW_ID
            if array.get(intervalAuthorityValid, authorityWindow)
                int validAuthorityDirection = array.get(intervalAuthorityDirection, authorityWindow)
                float validAuthorityBoundary = array.get(intervalAuthorityBoundary, authorityWindow)
                int validAuthorityKind = array.get(intervalAuthorityKind, authorityWindow)
                int validAuthorityBar = array.get(intervalAuthorityQualifiedBar, authorityWindow)
                bool authorityBoundaryFailed = validAuthorityKind == SOURCE_BGOB ? (validAuthorityDirection == 1 ? low < validAuthorityBoundary : high > validAuthorityBoundary) : (validAuthorityDirection == 1 ? close < validAuthorityBoundary : close > validAuthorityBoundary)
                bool authorityBodyConfirmed = validAuthorityKind != SOURCE_FPI or not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-validAuthorityDirection)
                bool authorityFailed = not na(validAuthorityBar) and bar_index > validAuthorityBar and authorityBoundaryFailed and authorityBodyConfirmed
                if authorityFailed
                    array.set(intervalAuthorityValid, authorityWindow, false)

    int validSupportIntervalCount = 0
    int validResistanceIntervalCount = 0
    int priorIntervalAuthorityCountAfter = 0
    for authorityWindow = 0 to LAST_WINDOW_ID
        if array.get(intervalAuthorityValid, authorityWindow)
            int survivingAuthorityDirection = array.get(intervalAuthorityDirection, authorityWindow)
            if survivingAuthorityDirection == 1
                validSupportIntervalCount += 1
            else if survivingAuthorityDirection == -1
                validResistanceIntervalCount += 1
            bool isPriorMatchingSurvivor = recordedTradeOpen and strategy.position_size != 0 and authorityWindow >= recordedTradePhaseStartWindow and authorityWindow < currentWindow and survivingAuthorityDirection == recordedTradeDirection
            if isPriorMatchingSurvivor
                priorIntervalAuthorityCountAfter += 1

    bool priorIntervalHoldActive = recordedTradeOpen and strategy.position_size != 0 and priorIntervalAuthorityCountAfter > 0
    bool priorIntervalAuthorityLostNow = recordedTradeOpen and strategy.position_size != 0 and priorIntervalAuthorityCountBefore > 0 and priorIntervalAuthorityCountAfter == 0

    // Register every independently respected structure that points with the first
    // session FPI. Regular 9:30 FPI/BGOB state is excluded from the retained stack;
    // the dedicated 9:30 close-and-wait rule owns that opening period. The special
    // 9:50 structure and a validated session order block are explicit exceptions.
    if sessionAnchorFpiFound and isOneMinute and inSession and barstate.isconfirmed
        if mainSignalNow and mainSignalWindow > sessionAnchorWindow and mainSignalOriginalDirection == sessionAnchorDirection and not mainSignalWasDisrespected
            addConfluence(confluenceKind, confluenceSourceBar, confluenceWindow, confluenceTop, confluenceBottom, confluenceBoundary, confluenceValid, confluenceStructureBox, SOURCE_FPI, mainSignalStructureBar, mainSignalWindow, sessionAnchorDirection, mainSignalTop, mainSignalBottom, mainSignalBox)
        if activeNyPhase == SESSION_PHASE_AM and nowMinute >= MACRO_950_TRADE_START and macro950InitialSignalUsed and macro950AuthorityDirection == sessionAnchorDirection
            addConfluence(confluenceKind, confluenceSourceBar, confluenceWindow, confluenceTop, confluenceBottom, confluenceBoundary, confluenceValid, confluenceStructureBox, SOURCE_MACRO_950, macro950FormationBar, 1, sessionAnchorDirection, macro950Top, macro950Bottom, macro950Box)
        if bgobSignalNow and bgobSignalWindow > sessionAnchorWindow and bgobSignalDirection == sessionAnchorDirection
            addConfluence(confluenceKind, confluenceSourceBar, confluenceWindow, confluenceTop, confluenceBottom, confluenceBoundary, confluenceValid, confluenceStructureBox, SOURCE_BGOB, bgobSignalFormationBar, bgobSignalWindow, sessionAnchorDirection, bgobSignalTop, bgobSignalBottom, na)
        if orderBlockSignalNow and orderBlockSignalDirection == sessionAnchorDirection
            addConfluence(confluenceKind, confluenceSourceBar, confluenceWindow, confluenceTop, confluenceBottom, confluenceBoundary, confluenceValid, confluenceStructureBox, SOURCE_ORDER_BLOCK, orderBlockSignalSourceBar, orderBlockSignalSourceWindow, sessionAnchorDirection, orderBlockSignalTop, orderBlockSignalBottom, orderBlockSignalBox)

    // A1 regression rule: establish the foundation before invalidating individual
    // structures. For a bullish session it is the lowest boundary; for a bearish
    // session it is the highest. Failure of a higher/lower secondary structure only
    // removes that structure. The aligned trade remains held while the foundation survives.
    int confluenceCountBefore = 0
    float confluenceMasterBefore = na
    int confluenceMasterKindBefore = SOURCE_NONE
    float confluenceMasterTopBefore = na
    float confluenceMasterBottomBefore = na
    int confluenceStructureCount = array.size(confluenceKind)
    if sessionAnchorFpiFound and confluenceStructureCount > 0
        for structureIndex = 0 to confluenceStructureCount - 1
            if array.get(confluenceValid, structureIndex)
                float holdBoundary = array.get(confluenceBoundary, structureIndex)
                bool becomesFoundation = na(confluenceMasterBefore) or (sessionAnchorDirection == 1 ? holdBoundary < confluenceMasterBefore : holdBoundary > confluenceMasterBefore)
                confluenceCountBefore += 1
                if becomesFoundation
                    confluenceMasterBefore := holdBoundary
                    confluenceMasterKindBefore := array.get(confluenceKind, structureIndex)
                    confluenceMasterTopBefore := array.get(confluenceTop, structureIndex)
                    confluenceMasterBottomBefore := array.get(confluenceBottom, structureIndex)

    if sessionAnchorFpiFound and confluenceStructureCount > 0 and isOneMinute and inSession and barstate.isconfirmed
        for structureIndex = 0 to confluenceStructureCount - 1
            if array.get(confluenceValid, structureIndex)
                int structureKind = array.get(confluenceKind, structureIndex)
                float structureBoundary = array.get(confluenceBoundary, structureIndex)
                int structureBar = array.get(confluenceSourceBar, structureIndex)
                bool structureFailed = bar_index > structureBar and (structureKind == SOURCE_BGOB ? (sessionAnchorDirection == 1 ? low < structureBoundary : high > structureBoundary) : (sessionAnchorDirection == 1 ? close < structureBoundary : close > structureBoundary))
                if structureFailed
                    array.set(confluenceValid, structureIndex, false)
                    box failedStructureBox = array.get(confluenceStructureBox, structureIndex)
                    if not na(failedStructureBox)
                        box.set_border_color(failedStructureBox, color.new(#f08c00, 0))
                        box.set_border_width(failedStructureBox, 2)

    int sessionConfluenceValidCount = 0
    float sessionConfluenceMasterBoundary = na
    int sessionConfluenceMasterKind = SOURCE_NONE
    float sessionConfluenceMasterTop = na
    float sessionConfluenceMasterBottom = na
    if sessionAnchorFpiFound and confluenceStructureCount > 0
        for structureIndex = 0 to confluenceStructureCount - 1
            if array.get(confluenceValid, structureIndex)
                float survivingBoundary = array.get(confluenceBoundary, structureIndex)
                bool becomesSurvivingFoundation = na(sessionConfluenceMasterBoundary) or (sessionAnchorDirection == 1 ? survivingBoundary < sessionConfluenceMasterBoundary : survivingBoundary > sessionConfluenceMasterBoundary)
                sessionConfluenceValidCount += 1
                if becomesSurvivingFoundation
                    sessionConfluenceMasterBoundary := survivingBoundary
                    sessionConfluenceMasterKind := array.get(confluenceKind, structureIndex)
                    sessionConfluenceMasterTop := array.get(confluenceTop, structureIndex)
                    sessionConfluenceMasterBottom := array.get(confluenceBottom, structureIndex)

    float confluenceTolerance = syminfo.mintick * 0.5
    bool confluenceFoundationLostNow = confluenceCountBefore > 0 and (sessionConfluenceValidCount == 0 or (sessionAnchorDirection == 1 ? sessionConfluenceMasterBoundary > confluenceMasterBefore + confluenceTolerance : sessionConfluenceMasterBoundary < confluenceMasterBefore - confluenceTolerance))
    if confluenceFoundationLostNow
        // Once the foundation is gone, all higher bullish / lower bearish entries in
        // that stack lose their common hold authority. A later validated structure
        // must establish a fresh aligned stack.
        if confluenceStructureCount > 0
            for structureIndex = 0 to confluenceStructureCount - 1
                if array.get(confluenceValid, structureIndex)
                    array.set(confluenceValid, structureIndex, false)
                    box invalidatedStructureBox = array.get(confluenceStructureBox, structureIndex)
                    if not na(invalidatedStructureBox)
                        box.set_border_color(invalidatedStructureBox, color.new(#f08c00, 0))
                        box.set_border_width(invalidatedStructureBox, 2)
        sessionConfluenceValidCount := 0
        sessionConfluenceMasterBoundary := na
        sessionConfluenceMasterKind := SOURCE_NONE
        sessionConfluenceMasterTop := na
        sessionConfluenceMasterBottom := na
        sessionFpiRegime := SESSION_REGIME_JUDAS
        sessionAlignmentProvenByLaterFpi := false

    bool validOrderBlockConfluence = false
    if confluenceStructureCount > 0
        for structureIndex = 0 to confluenceStructureCount - 1
            validOrderBlockConfluence := validOrderBlockConfluence or (array.get(confluenceValid, structureIndex) and array.get(confluenceKind, structureIndex) == SOURCE_ORDER_BLOCK)
    if validOrderBlockConfluence and not confluenceFoundationLostNow
        // A fully validated order-block retest is allowed to preserve or restore the
        // permanent session-FPI direction even if a nearer same-direction FPI failed.
        sessionFpiRegime := SESSION_REGIME_ALIGNED
        sessionAlignmentProvenByLaterFpi := true

    bool sessionConfluenceBiasActive = sessionAnchorFpiFound and sessionConfluenceValidCount > 0 and not confluenceFoundationLostNow
    bool sessionConfluenceHoldActive = sessionConfluenceBiasActive and recordedTradeOpen and strategy.position_size != 0 and recordedTradeDirection == sessionAnchorDirection
    bool confluenceFoundationExitNow = confluenceFoundationLostNow and recordedTradeOpen and strategy.position_size != 0 and recordedTradeDirection == sessionAnchorDirection

    bool macro950GateActive = macro950WindowActive and macro950AuthorityDirection != 0
    int sessionExpectedDirection = sessionFpiRegime == SESSION_REGIME_JUDAS ? -sessionAnchorDirection : sessionAnchorDirection
    bool sessionRegimeGateActive = sessionAnchorFpiFound and sessionFpiRegime != SESSION_REGIME_UNRESOLVED and not macro950GateActive

    // Track maximum favorable excursion for the active economic trade. At 80 points,
    // the resting protective stop moves to the recorded entry price.
    if recordedTradeOpen and not na(recordedEntryBar) and bar_index > recordedEntryBar
        float favorablePointsNow = recordedTradeDirection == 1 ? high - recordedEntry : recordedEntry - low
        recordedMaxProfitPoints := math.max(recordedMaxProfitPoints, favorablePointsNow)
        if not recordedBreakEvenArmed and recordedMaxProfitPoints >= BREAK_EVEN_TRIGGER_POINTS
            recordedBreakEvenArmed := true
            recordedSl := recordedEntry
            if recordedWindow >= 0 and recordedSlot >= 0
                writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, na, true, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)

    // Special profitable recovery failure. This applies only when the trade entered
    // beyond the wrong side of its same-direction FPI, later reclaimed the complete
    // zone, and then close-disrespected the far edge within the next five candles.
    bool profitableRecoveryFailureNow = false
    if recoveryTradeWatchEligible and recordedTradeOpen and strategy.position_size != 0 and isOneMinute and inSession and barstate.isconfirmed and not na(recordedEntryBar) and bar_index > recordedEntryBar
        bool recoveryAcceptanceClose = recordedTradeDirection == 1 ? close > recoveryTradeFpiTop : close < recoveryTradeFpiBottom
        if not recoveryTradeAcceptanceSeen
            if recoveryAcceptanceClose
                recoveryTradeAcceptanceSeen := true
                recoveryTradeAcceptanceBar := bar_index
        else if not na(recoveryTradeAcceptanceBar)
            int candlesAfterRecovery = bar_index - recoveryTradeAcceptanceBar
            if candlesAfterRecovery > FAILED_RECOVERY_CONFIRMATION_BARS
                recoveryTradeWatchEligible := false
            else if candlesAfterRecovery >= 1
                bool recoveryFarEdgeFailure = recordedTradeDirection == 1 ? close < recoveryTradeFpiBottom : close > recoveryTradeFpiTop
                profitableRecoveryFailureNow := recordedMaxProfitPoints >= FAILED_RECOVERY_PROFIT_POINTS and recoveryFarEdgeFailure and fpiFailureBodyConfirmed(recordedTradeDirection, cfg.requireDirectionalBodyForFpiFailure)

    // Count distinct touch episodes of the currently authoritative FPI. Consecutive bars
    // inside the zone are one retest. The second distinct retest forces a flat state first.
    bool activeFpiSecondRetestExitNow = false
    if not sessionConfluenceHoldActive and activeFpiValid and activeSourceKind != SOURCE_NONE and activeSourceKind != SOURCE_BGOB and activeSourceKind != SOURCE_ORDER_BLOCK and activeSourceKind != SOURCE_REVERSAL_FOUNDATION and not activeSecondRetestConsumed and not na(activeFpiBar) and bar_index > activeFpiBar
        bool activeZoneTouch = low <= activeTop and high >= activeBottom
        if activeZoneTouch and not activeTouchedLast
            activeRetestCount += 1
            if activeRetestCount >= 2 and recordedTradeOpen and strategy.position_size != 0 and fpiFailureBodyConfirmed(recordedTradeDirection, cfg.requireDirectionalBodyForFpiFailure)
                activeFpiSecondRetestExitNow := true
                activeSecondRetestConsumed := true
        activeTouchedLast := activeZoneTouch

    // A trade whose original entry authority was a BGOB cannot remain open after price
    // penetrates beyond that BGOB's 50% midpoint.
    bool bgobMidpointExitNow = false
    if recordedTradeOpen and recordedOriginKind == SOURCE_BGOB and not na(recordedOriginTop) and not na(recordedOriginBottom) and not na(recordedEntryBar) and bar_index > recordedEntryBar
        float originBgobMidpoint = (recordedOriginTop + recordedOriginBottom) / 2.0
        bgobMidpointExitNow := recordedTradeDirection == 1 ? low < originBgobMidpoint : high > originBgobMidpoint

    // Requalification uses the same strict FPI sequence: accept outside in the original
    // direction, then physically retest on a later bar and close outside again. A close
    // through the far edge confirms the opposing direction without an original-bias entry.
    bool fpiRequalificationSignalNow = false
    int fpiRequalificationSignalDirection = 0
    if fpiRequalificationWatch and not targetWindowLock and not recordedTradeOpen and strategy.position_size == 0 and not na(fpiRequalificationBar) and bar_index > fpiRequalificationBar
        bool requalificationZoneRetest = low <= fpiRequalificationTop and high >= fpiRequalificationBottom
        bool requalificationAcceptanceClose = fpiRequalificationDirection == 1 ? close > fpiRequalificationTop : close < fpiRequalificationBottom
        bool requalificationFarEdgeFailure = (fpiRequalificationDirection == 1 ? close < fpiRequalificationBottom : close > fpiRequalificationTop) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-fpiRequalificationDirection))
        if requalificationFarEdgeFailure
            fpiRequalificationSignalNow := true
            fpiRequalificationSignalDirection := -fpiRequalificationDirection
            fpiRequalificationAcceptanceConfirmed := false
            fpiRequalificationAcceptanceBar := na
        else if not fpiRequalificationAcceptanceConfirmed
            if requalificationAcceptanceClose
                fpiRequalificationAcceptanceConfirmed := true
                fpiRequalificationAcceptanceBar := bar_index
        else if not na(fpiRequalificationAcceptanceBar) and bar_index > fpiRequalificationAcceptanceBar and requalificationZoneRetest and requalificationAcceptanceClose
            fpiRequalificationSignalNow := true
            fpiRequalificationSignalDirection := fpiRequalificationDirection
            fpiRequalificationAcceptanceConfirmed := false
            fpiRequalificationAcceptanceBar := na

    // Opening confluence release is diagnostic/narrative only. It cannot directly enter.
    bool openingConfluenceReleaseSignalNow = openingFpiLockReleasedNow and sessionConfluenceBiasActive and not recordedTradeOpen and strategy.position_size == 0 and not na(sessionConfluenceMasterTop) and not na(sessionConfluenceMasterBottom) and (sessionAnchorDirection == 1 ? close > sessionConfluenceMasterTop : close < sessionConfluenceMasterBottom)

    // A previously delayed profitable-trade reversal fires only after a confirmed close
    // through the frozen last swing-close level from before the contradicting period began.
    bool delayedFpiSignalNow = delayedFpiReversal and not targetWindowLock and not na(delayedFpiArmedBar) and bar_index > delayedFpiArmedBar and not na(delayedFpiBreakLevel) and (delayedFpiDirection == 1 ? close > delayedFpiBreakLevel : close < delayedFpiBreakLevel)

    if sessionConfluenceBiasActive and delayedFpiReversal and delayedFpiDirection != sessionAnchorDirection
        delayedFpiReversal := false
        delayedFpiSignalNow := false
    else if macro950GateActive and delayedFpiReversal and delayedFpiDirection != macro950AuthorityDirection
        delayedFpiReversal := false
        delayedFpiSignalNow := false
    if sessionRegimeGateActive and delayedFpiReversal and delayedFpiDirection != sessionExpectedDirection
        delayedFpiReversal := false
        delayedFpiSignalNow := false

    // If a trade has already achieved more than 50 points and a later regular period FPI
    // contradicts it, arm the frozen swing-level watch. The special 9:50 authority is
    // deliberately exempt: its boundary change acts immediately, as marked in the review.
    int incomingFpiDirection = mainSignalDirection
    float incomingFpiTop = mainSignalTop
    float incomingFpiBottom = mainSignalBottom
    int incomingFpiWindow = mainSignalWindow
    bool incomingFpiSignalNow = mainSignalNow
    bool incomingFpiOpposesTrade = incomingFpiSignalNow and recordedTradeOpen and strategy.position_size != 0 and incomingFpiDirection != positionDirection()
    bool incomingFpiAlignsTrade = incomingFpiSignalNow and recordedTradeOpen and strategy.position_size != 0 and incomingFpiDirection == positionDirection()
    bool incomingFpiFromLaterWindow = recordedWindow >= 0 and currentWindow >= 0 and currentWindow != recordedWindow
    float incomingFrozenBreakLevel = incomingFpiDirection == 1 ? frozenPriorSwingHighClose : frozenPriorSwingLowClose
    bool incomingFpiAllowedByMacro950 = sessionConfluenceBiasActive ? incomingFpiDirection == sessionAnchorDirection : not macro950GateActive or incomingFpiDirection == macro950AuthorityDirection
    bool incomingFpiAllowedBySession = sessionConfluenceBiasActive ? incomingFpiDirection == sessionAnchorDirection : not sessionRegimeGateActive or incomingFpiDirection == sessionExpectedDirection
    bool sessionAlignmentAuthorityNow = sessionAlignmentProofNow or intervalFoundationSignalNow
    bool delayIncomingFpiNow = not sessionAlignmentAuthorityNow and not bgobSignalNow and incomingFpiAllowedByMacro950 and incomingFpiAllowedBySession and incomingFpiOpposesTrade and incomingFpiFromLaterWindow and recordedMaxProfitPoints > PROFITABLE_HOLD_THRESHOLD_POINTS and not na(incomingFrozenBreakLevel)

    if incomingFpiAlignsTrade and delayedFpiReversal
        delayedFpiReversal := false
        delayedFpiSignalNow := false

    if delayIncomingFpiNow
        delayedFpiReversal := true
        delayedFpiDirection := incomingFpiDirection
        delayedFpiTop := incomingFpiTop
        delayedFpiBottom := incomingFpiBottom
        delayedFpiBreakLevel := incomingFrozenBreakLevel
        delayedFpiWindow := incomingFpiWindow
        delayedFpiArmedBar := bar_index

    // An already-active FPI may reverse the trade once when its close-only boundary fails.
    // A successful BGOB retest has first priority, followed by a newly resolving period FPI.
    bool openingFoundationRecoveryNow = openingFpiWindowLock and currentWindow == openingFpiLockWindow and intervalFoundationSignalNow and intervalFoundationSignalDirection == sessionAnchorDirection
    if openingFoundationRecoveryNow
        openingFpiWindowLock := false
        openingFpiLockWindow := -1
        sessionFpiRegime := SESSION_REGIME_ALIGNED
        sessionAlignmentProvenByLaterFpi := true

    // An early counter-controller foundation becomes a campaign-quality hold only
    // after the opposing 9:50 Macro FPI far edge is reclaimed in AM. Outside AM, the
    // opposing phase-controller far edge performs the same upgrade.
    bool narrativeHoldUpgradeNow = stateManager.holdUpgradeConfirmed(
        recordedTradeOpen and strategy.position_size != 0,
        recordedTradeDirection,
        recordedEarlyReversal,
        recordedNarrativeHoldConfirmed,
        activeNyPhase == SESSION_PHASE_AM,
        macro950Found,
        macro950Direction,
        macro950Top,
        macro950Bottom,
        sessionAnchorFpiFound,
        sessionAnchorDirection,
        sessionAnchorTop,
        sessionAnchorBottom,
        close
    )
    if narrativeHoldUpgradeNow
        recordedNarrativeHoldConfirmed := true
        recordedEarlyReversal := false
        if cfg.showSequenceStateLabels
            label.new(x=bar_index, y=recordedTradeDirection == 1 ? low : high, text=recordedTradeDirection == 1 ? "BULL CAMPAIGN HOLD CONFIRMED" : "BEAR CAMPAIGN HOLD CONFIRMED", yloc=yloc.price, style=label.style_none, textcolor=recordedTradeDirection == 1 ? color.new(#2b8a3e, 0) : color.new(#c92a2a, 0), size=size.small, textalign=text.align_center)

    bool macro950BgobHoldUpgradeNow = macro950BgobSignalNow and recordedTradeOpen and strategy.position_size != 0 and recordedTradeDirection == macro950BgobSignalDirection
    if macro950BgobHoldUpgradeNow
        recordedNarrativeHoldConfirmed := true
        recordedEarlyReversal := false
        campaignLegNow := true
        campaignLegDirection := recordedTradeDirection
        campaignLegPrice := close
        if cfg.showSequenceStateLabels
            label.new(x=bar_index, y=recordedTradeDirection == 1 ? low : high, text=recordedTradeDirection == 1 ? "9:50 BGOB MMBM" : "9:50 BGOB MMSM", yloc=yloc.price, style=label.style_none, textcolor=recordedTradeDirection == 1 ? color.new(#2b8a3e, 0) : color.new(#c92a2a, 0), size=size.small, textalign=text.align_center)

    // A carried position ignores ordinary/opposite later FPI context. It exits only
    // when the first respected, aligned FPI from 10:00 onward is close-disrespected.
    if not reversalModeActive and sessionAnchorFpiFound and recordedTradeOpen and recordedTradeDirection == sessionAnchorDirection and not campaignHoldAnchorFound and not campaignAnchorSelectionConsumed and currentWindow > sessionAnchorWindow
        for anchorWindow = sessionAnchorWindow + 1 to LAST_WINDOW_ID
            bool eligibleAnchor = not campaignHoldAnchorFound and anchorWindow >= math.max(sessionAnchorWindow + 1, recordedWindow) and anchorWindow <= currentWindow and array.get(selectedByWindow, anchorWindow) and array.get(intervalFpiRespected, anchorWindow) and array.get(intervalFpiOriginalDirection, anchorWindow) == sessionAnchorDirection
            if eligibleAnchor
                campaignHoldAnchorFound := true
                campaignHoldAnchorWindow := anchorWindow
                campaignHoldAnchorTop := array.get(intervalFpiTop, anchorWindow)
                campaignHoldAnchorBottom := array.get(intervalFpiBottom, anchorWindow)
                campaignAnchorSelectionConsumed := true

    bool campaignHoldActive = not reversalModeActive and recordedTradeOpen and strategy.position_size != 0 and campaignHoldAnchorFound and recordedTradeDirection == sessionAnchorDirection
    bool campaignHoldAnchorDisrespectedNow = campaignHoldActive and (sessionAnchorDirection == 1 ? close < campaignHoldAnchorBottom : close > campaignHoldAnchorTop) and fpiFailureBodyConfirmed(recordedTradeDirection, cfg.requireDirectionalBodyForFpiFailure)
    bool reversalTransitionExitNow = recordedTradeOpen and strategy.position_size != 0 and ((reversalModeActivatedNow and recordedTradeDirection != reversalModeDirection) or (reversalModeReleasedNow and recordedTradeDirection != sessionAnchorDirection))
    bool activeBoundaryCloseFailed = activeTradeDirection == 1 ? close < activeInvalidation : close > activeInvalidation
    bool activeFailureBodyConfirmed = not isSoftFpiSource(activeSourceKind) or fpiFailureBodyConfirmed(activeTradeDirection, cfg.requireDirectionalBodyForFpiFailure)
    bool activeCloseDisrespectCandidate = activeHasFpi and activeFpiValid and activeProtectionEnabled and bar_index > activeFpiBar and strategy.position_size != 0 and activeBoundaryCloseFailed and activeFailureBodyConfirmed
    bool narrativeHoldActive = campaignHoldActive or priorIntervalHoldActive or sessionConfluenceHoldActive or recordedNarrativeHoldConfirmed
    bool campaignAuthorityExitNow = campaignHoldAnchorDisrespectedNow and not priorIntervalHoldActive and not sessionConfluenceHoldActive
    bool intervalAuthorityExitNow = priorIntervalAuthorityLostNow and not campaignHoldActive and not sessionConfluenceHoldActive
    bool ordinaryMandatoryExitNow = confluenceFoundationExitNow or activeFpiSecondRetestExitNow or bgobMidpointExitNow

    // The risk guard is additive. It does not replace the original FPI/OB/BGOB exits.
    // It closes only after independent warning families agree, then blocks every new entry
    // until a completed HH/LL close releases the lock. A fresh bot structure is still required.
    bool causalMacroFailure = recordedTradeOpen and not recordedEarlyReversal and activeNyPhase == SESSION_PHASE_AM and macro950Found and (recordedTradeDirection == 1 ? close < macro950Bottom : close > macro950Top) and fpiFailureBodyConfirmed(recordedTradeDirection, cfg.requireDirectionalBodyForFpiFailure)
    bool causalControllerFailure = recordedTradeOpen and not recordedEarlyReversal and sessionAnchorFpiFound and recordedTradeDirection == sessionAnchorDirection and (recordedTradeDirection == 1 ? close < sessionAnchorBottom : close > sessionAnchorTop) and fpiFailureBodyConfirmed(recordedTradeDirection, cfg.requireDirectionalBodyForFpiFailure)
    bool causalOpposingStructurePulse = recordedTradeOpen and ((reversalFoundationSignalNow and reversalFoundationSignalDirection == -recordedTradeDirection) or (intervalFoundationSignalNow and intervalFoundationSignalDirection == -recordedTradeDirection) or (mainSignalNow and mainSignalDirection == -recordedTradeDirection))
    bool causalFoundationStress = recordedTradeOpen and (activeFpiSecondRetestExitNow or campaignHoldAnchorDisrespectedNow or priorIntervalAuthorityLostNow)
    stateManager.EnigmaDecision enigmaDecision = stateManager.step(
        enigmaState,
        enigmaConfig,
        sessionStart,
        cfg.enableEnigmaManagement and recordedTradeOpen and strategy.position_size != 0,
        recordedTradeDirection,
        recordedEntry,
        recordedEntryBar,
        bar_index,
        high,
        low,
        close,
        close[1],
        causalMacroFailure,
        causalControllerFailure,
        causalOpposingStructurePulse,
        causalFoundationStress
    )
    // Failed expansion plus a single opposing pulse is a warning, not an automatic
    // campaign exit. A caution exit must include failure of Macro/controller authority
    // or stress at the governing structural foundation. Hard multi-confluence exits remain immediate.
    bool cautionAuthorityFailurePresent = causalMacroFailure or causalControllerFailure or causalFoundationStress
    bool enigmaCautionExitAllowed = not cfg.requireAuthorityFailureForCautionExit or cautionAuthorityFailurePresent
    bool enigmaExitNow = cfg.enableEnigmaManagement and (enigmaDecision.hardExit or (enigmaDecision.cautionExit and enigmaCautionExitAllowed))
    bool mandatoryStructureExitNow = profitableRecoveryFailureNow or reversalTransitionExitNow or openingFpiDisrespectNow or campaignAuthorityExitNow or intervalAuthorityExitNow or enigmaExitNow or (not narrativeHoldActive and ordinaryMandatoryExitNow)
    // A failed campaign anchor is consumed permanently. Another surviving authority
    // may keep the trade open, but the failed anchor cannot silently recover later.
    if campaignHoldAnchorDisrespectedNow and campaignHoldAnchorWindow >= 0
        array.set(intervalFpiRespected, campaignHoldAnchorWindow, false)
        array.set(intervalFpiDisrespected, campaignHoldAnchorWindow, true)
    if campaignHoldAnchorDisrespectedNow and (priorIntervalHoldActive or sessionConfluenceHoldActive)
        campaignHoldAnchorFound := false
        campaignHoldAnchorWindow := -1
        campaignHoldAnchorTop := na
        campaignHoldAnchorBottom := na
    bool activeFailureAllowedByMacro950 = not sessionConfluenceBiasActive and (not macro950GateActive or -activeTradeDirection == macro950AuthorityDirection)
    bool activeFailureAllowedBySession = not sessionConfluenceBiasActive and (not sessionRegimeGateActive or -activeTradeDirection == sessionExpectedDirection)
    bool activeFailureSignalNow = not narrativeHoldActive and activeFailureAllowedByMacro950 and activeFailureAllowedBySession and not mandatoryStructureExitNow and not delayedFpiReversal and not bgobSignalNow and not orderBlockSignalNow and not delayedFpiSignalNow and not fpiRequalificationSignalNow and not macro950SignalNow and not mainSignalNow and activeCloseDisrespectCandidate and activeCanReverse
    bool activeExitOnlyNow = not narrativeHoldActive and activeFailureAllowedByMacro950 and activeFailureAllowedBySession and not mandatoryStructureExitNow and not delayedFpiReversal and not bgobSignalNow and not orderBlockSignalNow and not delayedFpiSignalNow and not fpiRequalificationSignalNow and not macro950SignalNow and not mainSignalNow and activeCloseDisrespectCandidate and not activeCanReverse

    // A previously respected or later requalified FPI remains a live structural boundary after its own
    // 30-minute window. If an open trade is opposite that FPI, select the most
    // extreme surviving boundary: lowest bullish support for a short, or highest
    // bearish resistance for a long. A later physical overlap and close back outside
    // in the FPI direction is the confirmation candle. It closes and reverses the
    // opposite position on that same completed one-minute bar.
    bool priorRespectedFpiReversalSignalNow = false
    int priorRespectedFpiReversalDirection = 0
    float priorRespectedFpiReversalTop = na
    float priorRespectedFpiReversalBottom = na
    int priorRespectedFpiReversalWindow = -1

    // Persistent FPI lifecycle. Acceptance and the later retest may complete after the
    // source 30-minute window has ended. A failed FPI may also requalify later, but only
    // through a new acceptance close followed by a still-later physical retest and
    // directional confirmation. This is what allows a blue/armed 10:30 FPI to become
    // actionable during lunch rather than being forgotten at 11:00.
    if isOneMinute and inSession and barstate.isconfirmed
        for persistentFpiWindow = 0 to LAST_WINDOW_ID
            if array.get(selectedByWindow, persistentFpiWindow)
                int persistentDirection = array.get(intervalFpiOriginalDirection, persistentFpiWindow)
                float persistentTop = array.get(intervalFpiTop, persistentFpiWindow)
                float persistentBottom = array.get(intervalFpiBottom, persistentFpiWindow)
                int persistentFormationBar = array.get(intervalFpiFormationBar, persistentFpiWindow)
                if not na(persistentFormationBar) and bar_index > persistentFormationBar and not na(persistentTop) and not na(persistentBottom)
                    bool persistentFailure = (persistentDirection == 1 ? close < persistentBottom : close > persistentTop) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(-persistentDirection))
                    bool persistentAcceptanceClose = persistentDirection == 1 ? close > persistentTop : close < persistentBottom
                    bool persistentPhysicalRetest = low <= persistentTop and high >= persistentBottom
                    bool persistentAcceptanceSeen = array.get(intervalFpiPersistentAcceptanceSeen, persistentFpiWindow)
                    int persistentAcceptanceBar = array.get(intervalFpiPersistentAcceptanceBar, persistentFpiWindow)

                    if persistentFailure
                        array.set(intervalFpiDisrespected, persistentFpiWindow, true)
                        array.set(intervalFpiRespected, persistentFpiWindow, false)
                        array.set(intervalFpiPersistentAcceptanceSeen, persistentFpiWindow, false)
                        array.set(intervalFpiPersistentAcceptanceBar, persistentFpiWindow, na)
                    else if not persistentAcceptanceSeen
                        if persistentAcceptanceClose
                            array.set(intervalFpiPersistentAcceptanceSeen, persistentFpiWindow, true)
                            array.set(intervalFpiPersistentAcceptanceBar, persistentFpiWindow, bar_index)
                    else if not na(persistentAcceptanceBar) and bar_index > persistentAcceptanceBar and persistentPhysicalRetest and persistentAcceptanceClose
                        array.set(intervalFpiRespected, persistentFpiWindow, true)
                        array.set(intervalFpiDisrespected, persistentFpiWindow, false)

    if cfg.enablePriorRespectedFpiReversal and recordedTradeOpen and strategy.position_size != 0 and isOneMinute and inSession and barstate.isconfirmed and not na(recordedEntryBar) and bar_index > recordedEntryBar and currentWindow > 0
        int openTradeDirection = positionDirection()
        int desiredReversalDirection = -openTradeDirection
        int earliestPriorFpiWindow = activeNyPhase == SESSION_PHASE_PM ? phaseStartWindow(SESSION_PHASE_PM) : 0
        float selectedExtremeBoundary = na
        for priorFpiWindow = 0 to LAST_WINDOW_ID
            bool isEarlierWindow = priorFpiWindow >= earliestPriorFpiWindow and priorFpiWindow < currentWindow
            bool candidateAvailable = isEarlierWindow and array.get(selectedByWindow, priorFpiWindow) and array.get(intervalFpiRespected, priorFpiWindow) and not array.get(intervalFpiDisrespected, priorFpiWindow) and not array.get(intervalFpiReversalUsed, priorFpiWindow) and array.get(intervalFpiOriginalDirection, priorFpiWindow) == desiredReversalDirection
            if candidateAvailable
                float candidateTop = array.get(intervalFpiTop, priorFpiWindow)
                float candidateBottom = array.get(intervalFpiBottom, priorFpiWindow)
                float candidateBoundary = desiredReversalDirection == 1 ? candidateBottom : candidateTop
                bool isMoreExtreme = na(selectedExtremeBoundary) or (desiredReversalDirection == 1 ? candidateBoundary < selectedExtremeBoundary : candidateBoundary > selectedExtremeBoundary)
                if isMoreExtreme
                    selectedExtremeBoundary := candidateBoundary
                    priorRespectedFpiReversalWindow := priorFpiWindow
                    priorRespectedFpiReversalTop := candidateTop
                    priorRespectedFpiReversalBottom := candidateBottom

        if priorRespectedFpiReversalWindow >= 0 and not na(priorRespectedFpiReversalTop) and not na(priorRespectedFpiReversalBottom)
            bool priorFpiPhysicalRetest = low <= priorRespectedFpiReversalTop and high >= priorRespectedFpiReversalBottom
            bool priorFpiDirectionalConfirm = (desiredReversalDirection == 1 ? close > priorRespectedFpiReversalTop : close < priorRespectedFpiReversalBottom) and (not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(desiredReversalDirection))
            if priorFpiPhysicalRetest and priorFpiDirectionalConfirm
                priorRespectedFpiReversalSignalNow := true
                priorRespectedFpiReversalDirection := desiredReversalDirection

    // Resolve the one effective structural signal for this bar.
    bool rawEffectiveSignalNow = priorRespectedFpiReversalSignalNow or macro950BgobSignalNow or reversalFoundationSignalNow or intervalFoundationSignalNow
    bool effectiveCameFromIntervalFoundation = not priorRespectedFpiReversalSignalNow and not macro950BgobSignalNow and not reversalFoundationSignalNow and intervalFoundationSignalNow
    bool signalCameFromFailure = false
    int effectiveDirection = priorRespectedFpiReversalSignalNow ? priorRespectedFpiReversalDirection : macro950BgobSignalNow ? macro950BgobSignalDirection : reversalFoundationSignalNow ? reversalFoundationSignalDirection : intervalFoundationSignalNow ? intervalFoundationSignalDirection : sessionAnchorDirection
    float effectiveTop = priorRespectedFpiReversalSignalNow ? priorRespectedFpiReversalTop : macro950BgobSignalNow ? macro950BgobSignalTop : reversalFoundationSignalNow ? reversalFoundationSignalTop : intervalFoundationSignalNow ? intervalFoundationSignalTop : sessionConfluenceMasterTop
    float effectiveBottom = priorRespectedFpiReversalSignalNow ? priorRespectedFpiReversalBottom : macro950BgobSignalNow ? macro950BgobSignalBottom : reversalFoundationSignalNow ? reversalFoundationSignalBottom : intervalFoundationSignalNow ? intervalFoundationSignalBottom : sessionConfluenceMasterBottom
    int stopFpiWindow = priorRespectedFpiReversalSignalNow ? priorRespectedFpiReversalWindow : reversalFoundationSignalNow ? reversalFoundationSignalAgainstFpiWindow : currentWindow >= 0 and array.get(selectedByWindow, currentWindow) ? currentWindow : sessionAnchorWindow
    float intervalThreeCandleHigh = stopFpiWindow >= 0 ? array.get(intervalFpiThreeCandleHigh, stopFpiWindow) : na
    float intervalThreeCandleLow = stopFpiWindow >= 0 ? array.get(intervalFpiThreeCandleLow, stopFpiWindow) : na
    float macroBgobMidpointStop = macro950BgobSignalNow ? (macro950BgobSignalTop + macro950BgobSignalBottom) / 2.0 : na
    float effectiveSl = macro950BgobSignalNow ? macroBgobMidpointStop : reversalFoundationSignalNow ? (effectiveDirection == 1 ? effectiveBottom : effectiveTop) : effectiveDirection == 1 ? intervalThreeCandleLow : intervalThreeCandleHigh
    int effectiveWindow = priorRespectedFpiReversalSignalNow ? currentWindow : reversalFoundationSignalNow ? reversalFoundationSignalWindow : currentWindow
    int effectiveSourceKind = priorRespectedFpiReversalSignalNow ? SOURCE_PRIOR_FPI_RETEST : macro950BgobSignalNow ? SOURCE_BGOB : reversalFoundationSignalNow ? SOURCE_REVERSAL_FOUNDATION : intervalFoundationSignalNow ? intervalFoundationSignalKind : sessionConfluenceMasterKind
    bool effectiveInitialRetest = priorRespectedFpiReversalSignalNow or macro950BgobSignalNow or not reversalFoundationSignalNow
    box effectiveStructureBox = na
    bool effectiveCounterToController = sessionAnchorFpiFound and effectiveDirection != sessionAnchorDirection
    bool sequenceAlignedWithController = reversalFoundationSignalNow and sessionAnchorFpiFound and effectiveDirection == sessionAnchorDirection
    bool sequenceAlignedWithMacroOrigin = activeNyPhase != SESSION_PHASE_AM or not macro950Found or effectiveDirection == macro950Direction
    bool sequenceAlignedEarlyPermission = cfg.allowControllerAlignedFoundationEntry and sequenceAlignedWithController and sequenceAlignedWithMacroOrigin
    bool macroExpectedFoundationSignal = reversalFoundationSignalNow and ((effectiveDirection == 1 and bullishMacro950FoundationExpectation) or (effectiveDirection == -1 and bearishMacro950FoundationExpectation))
    bool earlyCounterControllerFoundationSignal = reversalFoundationSignalNow and reversalFoundationEarlyEntryNow
    bool effectiveMacroDirectionMatches = not macro950GateActive or effectiveDirection == macro950AuthorityDirection
    bool effectiveMacroTransitionConfirmed = not macro950GateActive or effectiveDirection == macro950Direction or macro950AuthorityRetestConfirmed
    // Core 1,008-case catalog audit. It is diagnostic by default. Enabling the strict
    // gate allows a fresh AM entry only when the catalog approves the same direction.
    bool catalogSessionRespected = sessionAnchorFpiFound and sessionAnchorWindow >= 0 and not catalogSessionDisrespectedLatched
    int catalogSweepEvent = catalog.macroRangeEvent(catalogRange)
    int catalogStructure = rawEffectiveSignalNow ? effectiveDirection : catalog.STRUCT_NONE
    catalog.CatalogDecision catalogDecision = catalog.resolveFromPrices(sessionAnchorDirection, macro950Direction, catalogSessionRespected, close, sessionAnchorBottom, sessionAnchorTop, macro950Bottom, macro950Top, catalogSweepEvent, catalogStructure)
    bool catalogAvailable = cfg.enableCatalogAudit and activeNyPhase == SESSION_PHASE_AM and catalogRange.locked and sessionAnchorFpiFound and macro950Found
    bool catalogDirectionAllowed = not cfg.enforceCatalogGate or not catalogAvailable or (effectiveDirection == 1 ? catalogDecision.terminalAction == catalog.ACTION_BUY_ELIGIBLE : effectiveDirection == -1 ? catalogDecision.terminalAction == catalog.ACTION_SELL_ELIGIBLE : true)
    string catalogSummary = catalogAvailable ? "CATALOG " + catalog.actionText(catalogDecision.terminalAction) + " | " + catalog.stateText(catalogDecision.resolvedState) + " | " + catalog.sweepText(catalogSweepEvent) + " | " + catalog.structureText(catalogStructure) : "CATALOG N/A"

    bool effectiveDirectionAllowedByMacro950 = priorRespectedFpiReversalSignalNow ? true : macro950BgobSignalNow ? true : earlyCounterControllerFoundationSignal ? true : macroExpectedFoundationSignal ? true : sequenceAlignedEarlyPermission ? true : reversalModeActive ? effectiveDirection == reversalModeDirection : effectiveMacroDirectionMatches and effectiveMacroTransitionConfirmed
    bool counterSessionBeyondAnchor = sessionAnchorDirection == 1 and effectiveDirection == -1 ? close < sessionAnchorBottom : sessionAnchorDirection == -1 and effectiveDirection == 1 ? close > sessionAnchorTop : false
    bool effectiveDirectionAllowedBySession = priorRespectedFpiReversalSignalNow ? true : macro950BgobSignalNow ? true : earlyCounterControllerFoundationSignal ? true : macroExpectedFoundationSignal ? true : sequenceAlignedEarlyPermission ? true : reversalModeActive ? effectiveDirection == reversalModeDirection : not sessionAnchorFpiFound or effectiveDirection == sessionAnchorDirection or counterSessionBeyondAnchor
    bool effectiveDirectionAllowedByConfluence = priorRespectedFpiReversalSignalNow or macro950BgobSignalNow or reversalFoundationSignalNow or (reversalModeActive ? effectiveDirection == reversalModeDirection : intervalFoundationSignalNow or not sessionConfluenceBiasActive or effectiveDirection == sessionAnchorDirection)
    // A fresh phase-extreme reversal foundation may replace an older ordinary campaign
    // anchor. It still cannot override a fully confirmed narrative hold without that
    // narrative first losing its governing authority.
    bool qualifiedEarlyFoundationAuthority = earlyCounterControllerFoundationSignal and reversalFoundationSignalNow
    bool campaignSignalCompatible = priorRespectedFpiReversalSignalNow or qualifiedEarlyFoundationAuthority or not campaignHoldActive or effectiveDirection == recordedTradeDirection
    bool intervalAuthoritySignalCompatible = priorRespectedFpiReversalSignalNow or qualifiedEarlyFoundationAuthority or not priorIntervalHoldActive or effectiveDirection == recordedTradeDirection
    bool confirmedNarrativeSignalCompatible = not recordedNarrativeHoldConfirmed or not recordedTradeOpen or effectiveDirection == recordedTradeDirection
    bool campaignReentryDirectionCompatible = priorRespectedFpiReversalSignalNow ? true : reversalModeActive ? effectiveDirection == reversalModeDirection : not campaignReentryAlignedOnly or effectiveDirection == sessionAnchorDirection
    bool reversalModeWindowSupports = priorRespectedFpiReversalSignalNow or macro950BgobSignalNow or reversalFoundationSignalNow or not reversalModeActive or (currentWindow >= 0 and array.get(selectedByWindow, currentWindow) and array.get(intervalFpiOriginalDirection, currentWindow) == reversalModeDirection)
    // The management lock is directional. A failed short may block another short,
    // but it must not suppress a fully confirmed bullish Macro-FPI + OB reversal.
    bool enigmaBlocksEffectiveDirection = cfg.enableEnigmaManagement and enigmaDecision.entriesBlocked and enigmaState.blockedDirection == effectiveDirection
    bool authoritativeMacroStructureSignal = macro950BgobSignalNow or macroExpectedFoundationSignal
    bool ordinaryWaitLocksClear = not failedRecoveryWait and not campaignReentryWait and not intervalReentryWait
    bool standardSignalLocksClear = (authoritativeMacroStructureSignal or qualifiedEarlyFoundationAuthority or ordinaryWaitLocksClear) and not mandatoryStructureExitNow and not targetWindowLock and not openingFpiWindowLock and not enigmaBlocksEffectiveDirection

    // Premium/discount gate from the active NY-phase dealing range.
    // The structure/retest zone determines location, not a later chased close.
    float activeDealingRangeHigh = sessionExtremeHigh
    float activeDealingRangeLow = sessionExtremeLow
    float activeDealingRangeEquilibrium = not na(activeDealingRangeHigh) and not na(activeDealingRangeLow) ? (activeDealingRangeHigh + activeDealingRangeLow) / 2.0 : na
    float effectiveLocationReference = not na(effectiveTop) and not na(effectiveBottom) ? (effectiveTop + effectiveBottom) / 2.0 : close
    bool effectiveDirectionAllowedByLocation = not cfg.enforcePremiumDiscountEntries or na(activeDealingRangeEquilibrium) or (effectiveDirection == 1 ? effectiveLocationReference <= activeDealingRangeEquilibrium : effectiveLocationReference >= activeDealingRangeEquilibrium)
    bool oppositeEffectiveSignalBodyConfirmed = not recordedTradeOpen or strategy.position_size == 0 or effectiveDirection == recordedTradeDirection or not cfg.requireDirectionalBodyForFpiFailure or directionalBodyFor(effectiveDirection)

    bool effectiveSignalNow = rawEffectiveSignalNow and (priorRespectedFpiReversalSignalNow or standardSignalLocksClear) and reversalModeWindowSupports and campaignSignalCompatible and intervalAuthoritySignalCompatible and confirmedNarrativeSignalCompatible and campaignReentryDirectionCompatible and effectiveDirectionAllowedByMacro950 and effectiveDirectionAllowedBySession and effectiveDirectionAllowedByConfluence and effectiveDirectionAllowedByLocation and oppositeEffectiveSignalBodyConfirmed and catalogDirectionAllowed

    bool positionChangedBySignal = false
    if effectiveSignalNow and cfg.enableBot and isOneMinute and entryTimeAllowed and barstate.isconfirmed
        int existingDirection = positionDirection()
        bool enteringFromFlat = existingDirection == 0
        bool oppositePosition = existingDirection != 0 and existingDirection != effectiveDirection
        bool sameDirectionPosition = existingDirection == effectiveDirection
        bool sendEntry = enteringFromFlat or oppositePosition

        if sendEntry
            // Any validated opposite bias is the prior trade's event-based TP and immediate reversal.
            if recordedTradeOpen
                strategy.cancel(PROTECTION_ID)
                if oppositePosition
                    recordedTp := close
                closedDirectionNow := existingDirection != 0 ? existingDirection : recordedTradeDirection
                float priorPoints = tradePoints(recordedTradeDirection, recordedEntry, close)
                sessionClosedPoints += priorPoints
                if recordedWindow >= 0 and recordedSlot >= 0
                    writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, priorPoints, false, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)
                drawExitTriangleNow := true
                drawExitTriangleDirection := recordedTradeDirection
                drawExitTrianglePrice := close
                drawClosedTradeEntryBar := recordedEntryBar
                drawClosedTradeEntryPrice := recordedEntry
                recordedTradeOpen := false
                recordedEarlyReversal := false
                recordedNarrativeHoldConfirmed := false
                exitNow := true

            strategy.cancel(PROTECTION_ID)
            if effectiveDirection == 1
                strategy.entry(ORDER_ID, strategy.long, qty=cfg.orderQuantity, comment="BUY")
                buyEntryNow := true
            else
                strategy.entry(ORDER_ID, strategy.short, qty=cfg.orderQuantity, comment="SELL")
                sellEntryNow := true

            // Consume an interval foundation only after TradingView receives the actual order.
            if effectiveCameFromIntervalFoundation and currentWindow >= 0
                if effectiveDirection == 1
                    array.set(intervalBullEntryUsed, currentWindow, true)
                else if effectiveDirection == -1
                    array.set(intervalBearEntryUsed, currentWindow, true)

            recordedTradeOpen := true
            recordedTradeDirection := effectiveDirection
            recordedEntry := close
            drawEntryTriangleNow := true
            drawEntryTriangleDirection := effectiveDirection
            drawEntryTrianglePrice := recordedEntry
            float foundationFallbackSl = effectiveDirection == 1 ? effectiveBottom : effectiveTop
            bool fpiStopIsProtective = effectiveDirection == 1 ? not na(effectiveSl) and effectiveSl < recordedEntry : not na(effectiveSl) and effectiveSl > recordedEntry
            bool foundationStopIsProtective = effectiveDirection == 1 ? not na(foundationFallbackSl) and foundationFallbackSl < recordedEntry : not na(foundationFallbackSl) and foundationFallbackSl > recordedEntry
            recordedSl := fpiStopIsProtective ? effectiveSl : foundationStopIsProtective ? foundationFallbackSl : na
            // The ledger belongs to the interval where the order actually executed.
            // activeSourceWindow below still retains the source structure interval.
            recordedWindow := currentWindow
            recordedTradePhaseStartWindow := phaseStartWindow(activeNyPhase)
            recordedEntryBar := bar_index
            recordedClosedTradesAtEntry := strategy.closedtrades
            recordedTarget := effectiveDirection == 1 ? recordedEntry + FIXED_TARGET_POINTS : recordedEntry - FIXED_TARGET_POINTS
            recordedTp := recordedTarget
            recordedMaxProfitPoints := 0.0
            recordedBreakEvenArmed := false
            recordedEarlyReversal := reversalFoundationSignalNow and reversalFoundationEarlyEntryNow
            recordedNarrativeHoldConfirmed := reversalFoundationSignalNow and reversalFoundationNarrativeConfirmedNow
            campaignHoldAnchorFound := false
            campaignHoldAnchorWindow := -1
            campaignHoldAnchorTop := na
            campaignHoldAnchorBottom := na
            campaignAnchorSelectionConsumed := false
            campaignReentryAlignedOnly := false
            recoveryTradeFpiWindow := stopFpiWindow
            recoveryTradeFpiTop := stopFpiWindow >= 0 ? array.get(intervalFpiTop, stopFpiWindow) : na
            recoveryTradeFpiBottom := stopFpiWindow >= 0 ? array.get(intervalFpiBottom, stopFpiWindow) : na
            int recoveryTradeFpiDirection = stopFpiWindow >= 0 ? array.get(intervalFpiOriginalDirection, stopFpiWindow) : 0
            recoveryTradeWatchEligible := recoveryTradeFpiDirection == effectiveDirection and not na(recoveryTradeFpiTop) and not na(recoveryTradeFpiBottom) and (effectiveDirection == 1 ? recordedEntry < recoveryTradeFpiBottom : recordedEntry > recoveryTradeFpiTop)
            recoveryTradeAcceptanceSeen := false
            recoveryTradeAcceptanceBar := na
            // A close-disrespect reversal is not a successful BGOB retest, even when
            // the failed active boundary happened to be a BGOB.
            recordedOriginKind := signalCameFromFailure ? SOURCE_NONE : effectiveSourceKind
            recordedOriginTop := effectiveTop
            recordedOriginBottom := effectiveBottom
            int ledgerCount = array.get(ledgerCountByWindow, recordedWindow)
            recordedSlot := math.min(ledgerCount, MAX_LEDGER_ROWS - 1)
            if ledgerCount < MAX_LEDGER_ROWS
                array.set(ledgerCountByWindow, recordedWindow, ledgerCount + 1)
            writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, na, true, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)

            activeHasFpi := true
            activeFpiValid := true
            activeProtectionEnabled := true
            activeTradeDirection := effectiveDirection
            activeTop := effectiveTop
            activeBottom := effectiveBottom
            activeInvalidation := recordedSl
            activeFpiBar := bar_index
            activeFpiBox := effectiveStructureBox
            activeCanReverse := not signalCameFromFailure and not recordedEarlyReversal
            activeSourceKind := signalCameFromFailure ? SOURCE_NONE : effectiveSourceKind
            activeSourceWindow := effectiveWindow
            activeRetestCount := effectiveSourceKind == SOURCE_BGOB or effectiveSourceKind == SOURCE_ORDER_BLOCK or effectiveSourceKind == SOURCE_REVERSAL_FOUNDATION ? 0 : (effectiveInitialRetest or delayedFpiSignalNow or fpiRequalificationSignalNow ? 1 : 0)
            activeTouchedLast := effectiveSourceKind != SOURCE_BGOB and effectiveSourceKind != SOURCE_ORDER_BLOCK and effectiveSourceKind != SOURCE_REVERSAL_FOUNDATION and effectiveInitialRetest
            activeSecondRetestConsumed := fpiRequalificationSignalNow
            delayedFpiReversal := false
            fpiRequalificationWatch := false
            fpiRequalificationAcceptanceConfirmed := false
            fpiRequalificationAcceptanceBar := na
            positionChangedBySignal := true
            if reversalFoundationSignalNow
                if effectiveDirection == 1
                    bullRevFoundationUsed := true
                else
                    bearRevFoundationUsed := true
            if priorRespectedFpiReversalSignalNow and priorRespectedFpiReversalWindow >= 0
                array.set(intervalFpiReversalUsed, priorRespectedFpiReversalWindow, true)

        else if sameDirectionPosition
            if reversalFoundationSignalNow and reversalFoundationNarrativeConfirmedNow
                recordedNarrativeHoldConfirmed := true
                recordedEarlyReversal := false
            if campaignHoldActive or priorIntervalHoldActive or recordedNarrativeHoldConfirmed
                campaignLegNow := true
                campaignLegDirection := recordedTradeDirection
                campaignLegPrice := close
                if reversalFoundationSignalNow
                    if effectiveDirection == 1
                        bullRevFoundationUsed := true
                    else
                        bearRevFoundationUsed := true
            // Every validated same-bias structure is retained as confluence. The newest
            // signal may remain the active touch counter, but it cannot erase the older
            // low-to-high / high-to-low foundation used by the economic trade.
            activeHasFpi := true
            activeFpiValid := true
            activeProtectionEnabled := true
            activeTradeDirection := effectiveDirection
            activeTop := effectiveTop
            activeBottom := effectiveBottom
            activeInvalidation := recordedSl
            activeFpiBar := bar_index
            activeFpiBox := effectiveStructureBox
            activeCanReverse := not recordedEarlyReversal
            activeSourceKind := effectiveSourceKind
            activeSourceWindow := effectiveWindow
            activeRetestCount := effectiveSourceKind == SOURCE_BGOB or effectiveSourceKind == SOURCE_ORDER_BLOCK or effectiveSourceKind == SOURCE_REVERSAL_FOUNDATION ? 0 : (effectiveInitialRetest ? 1 : 0)
            activeTouchedLast := effectiveSourceKind != SOURCE_BGOB and effectiveSourceKind != SOURCE_ORDER_BLOCK and effectiveSourceKind != SOURCE_REVERSAL_FOUNDATION and effectiveInitialRetest
            activeSecondRetestConsumed := false

            delayedFpiReversal := false
            if fpiRequalificationSignalNow
                fpiRequalificationWatch := false
                fpiRequalificationAcceptanceConfirmed := false
                fpiRequalificationAcceptanceBar := na

            if recordedTradeOpen
                // Later same-direction confluence cannot pull the original stop up to
                // entry. Only the explicit 80-point break-even rule may do that.
                recordedSl := recordedBreakEvenArmed ? recordedEntry : recordedSl
                if recordedWindow >= 0 and recordedSlot >= 0
                    writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, na, true, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)

    // Mandatory structure exits have priority over all entries and reversals on this bar.
    if not positionChangedBySignal and cfg.enableBot and isOneMinute and inSession and barstate.isconfirmed and strategy.position_size != 0 and mandatoryStructureExitNow
        int closingDirection = positionDirection()
        closedDirectionNow := closingDirection
        strategy.cancel(PROTECTION_ID)
        if enigmaExitNow
            // The library owns the post-exit HH/LL lock. Do not arm an automatic opposite reversal.
            failedRecoveryWait := false
            campaignReentryWait := false
            intervalReentryWait := false
            delayedFpiReversal := false
            fpiRequalificationWatch := false
            fpiRequalificationAcceptanceConfirmed := false
            fpiRequalificationAcceptanceBar := na
        else if profitableRecoveryFailureNow
            failedRecoveryWait := true
            failedRecoveryExitWindow := currentWindow
            recoveryTradeWatchEligible := false
            recoveryTradeAcceptanceSeen := false
            recoveryTradeAcceptanceBar := na
            campaignHoldAnchorFound := false
            campaignHoldAnchorWindow := -1
            campaignHoldAnchorTop := na
            campaignHoldAnchorBottom := na
            campaignReentryWait := false
            campaignReentryExitWindow := -1
            campaignReentryAlignedOnly := false
        else if reversalTransitionExitNow
            campaignHoldAnchorFound := false
            campaignHoldAnchorWindow := -1
            campaignHoldAnchorTop := na
            campaignHoldAnchorBottom := na
            campaignReentryWait := false
            campaignReentryExitWindow := -1
            campaignReentryAlignedOnly := false
        else if campaignHoldAnchorDisrespectedNow
            campaignReentryWait := true
            campaignReentryExitWindow := currentWindow
            campaignReentryAlignedOnly := false
            campaignHoldAnchorFound := false
            campaignHoldAnchorWindow := -1
            campaignHoldAnchorTop := na
            campaignHoldAnchorBottom := na
        else if intervalAuthorityExitNow
            intervalReentryWait := true
            intervalReentryExitWindow := currentWindow
            intervalReentryDirection := recordedTradeDirection
        else if activeFpiSecondRetestExitNow
            fpiRequalificationWatch := true
            fpiRequalificationDirection := activeTradeDirection
            fpiRequalificationTop := activeTop
            fpiRequalificationBottom := activeBottom
            fpiRequalificationWindow := activeSourceWindow
            fpiRequalificationBar := bar_index
            fpiRequalificationAcceptanceConfirmed := false
            fpiRequalificationAcceptanceBar := na
        else if confluenceFoundationExitNow and confluenceMasterKindBefore != SOURCE_BGOB
            // The foundation failure itself closes first. Beginning with the next
            // confirmed bar, an outside close may qualify the opposite direction.
            fpiRequalificationWatch := true
            fpiRequalificationDirection := sessionAnchorDirection
            fpiRequalificationTop := confluenceMasterTopBefore
            fpiRequalificationBottom := confluenceMasterBottomBefore
            fpiRequalificationWindow := currentWindow
            fpiRequalificationBar := bar_index
            fpiRequalificationAcceptanceConfirmed := false
            fpiRequalificationAcceptanceBar := na
        if recordedTradeOpen
            recordedTp := close
            float mandatoryExitPoints = tradePoints(recordedTradeDirection, recordedEntry, close)
            sessionClosedPoints += mandatoryExitPoints
            if recordedWindow >= 0 and recordedSlot >= 0
                writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, mandatoryExitPoints, false, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)
            drawExitTriangleNow := true
            drawExitTriangleDirection := recordedTradeDirection
            drawExitTrianglePrice := close
            drawClosedTradeEntryBar := recordedEntryBar
            drawClosedTradeEntryPrice := recordedEntry
            recordedTradeOpen := false
            recordedEarlyReversal := false
            recordedNarrativeHoldConfirmed := false
        string mandatoryExitComment = enigmaExitNow ? enigmaDecision.reason : closeSideText(closingDirection)
        strategy.close(ORDER_ID, comment=mandatoryExitComment)
        exitNow := true
        activeFpiValid := false
        activeSourceKind := SOURCE_NONE
        delayedFpiReversal := false

    // After one failure reversal, a second failure of that same FPI exits rather than recycling it.
    // Wicks are deliberately ignored in both cases.
    if not positionChangedBySignal and cfg.enableBot and isOneMinute and inSession and barstate.isconfirmed and strategy.position_size != 0 and activeExitOnlyNow
        int closingDirection = positionDirection()
        closedDirectionNow := closingDirection
        strategy.cancel(PROTECTION_ID)
        if recordedTradeOpen
            recordedTp := close
            float managedPoints = tradePoints(recordedTradeDirection, recordedEntry, close)
            sessionClosedPoints += managedPoints
            if recordedWindow >= 0 and recordedSlot >= 0
                writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, managedPoints, false, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)
            drawExitTriangleNow := true
            drawExitTriangleDirection := recordedTradeDirection
            drawExitTrianglePrice := close
            drawClosedTradeEntryBar := recordedEntryBar
            drawClosedTradeEntryPrice := recordedEntry
            recordedTradeOpen := false
            recordedEarlyReversal := false
            recordedNarrativeHoldConfirmed := false
        strategy.close(ORDER_ID, comment=closeSideText(closingDirection))
        exitNow := true
        activeFpiValid := false
        activeSourceKind := SOURCE_NONE
        delayedFpiReversal := false
        if not na(activeFpiBox)
            box.set_border_color(activeFpiBox, color.new(#f08c00, 0))
            box.set_border_width(activeFpiBox, 2)

    // The 4:49 bar close finalizes the economic trade so the account is flat by 4:50 PM New York.
    if cfg.forceFlatBy450 and finalTradableBar and barstate.isconfirmed and strategy.position_size != 0
        int closingDirection = positionDirection()
        closedDirectionNow := closingDirection
        strategy.cancel(PROTECTION_ID)
        if recordedTradeOpen
            recordedTp := close
            float sessionPoints = tradePoints(recordedTradeDirection, recordedEntry, close)
            sessionClosedPoints += sessionPoints
            if recordedWindow >= 0 and recordedSlot >= 0
                writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, sessionPoints, false, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)
            drawExitTriangleNow := true
            drawExitTriangleDirection := recordedTradeDirection
            drawExitTrianglePrice := close
            drawClosedTradeEntryBar := recordedEntryBar
            drawClosedTradeEntryPrice := recordedEntry
            recordedTradeOpen := false
            recordedEarlyReversal := false
            recordedNarrativeHoldConfirmed := false
        strategy.close_all(comment=closeSideText(closingDirection))
        exitNow := true
        activeFpiValid := false
        activeSourceKind := SOURCE_NONE
        delayedFpiReversal := false
        campaignHoldAnchorFound := false
        campaignHoldAnchorWindow := -1
        campaignHoldAnchorTop := na
        campaignHoldAnchorBottom := na
        fpiRequalificationWatch := false
        fpiRequalificationAcceptanceConfirmed := false
        fpiRequalificationAcceptanceBar := na

    // Defensive cutoff: no position may remain after 4:50 PM even if the exact 4:49
    // bar was unavailable or the script was attached after the cutoff.
    if cfg.forceFlatBy450 and inSession and nowMinute >= FORCE_FLAT_MINUTE and barstate.isconfirmed and strategy.position_size != 0
        int closingDirection = positionDirection()
        closedDirectionNow := closingDirection
        strategy.cancel(PROTECTION_ID)
        if recordedTradeOpen
            recordedTp := close
            float cutoffPoints = tradePoints(recordedTradeDirection, recordedEntry, close)
            sessionClosedPoints += cutoffPoints
            if recordedWindow >= 0 and recordedSlot >= 0
                writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, cutoffPoints, false, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)
            drawExitTriangleNow := true
            drawExitTriangleDirection := recordedTradeDirection
            drawExitTrianglePrice := close
            drawClosedTradeEntryBar := recordedEntryBar
            drawClosedTradeEntryPrice := recordedEntry
            recordedTradeOpen := false
            recordedEarlyReversal := false
            recordedNarrativeHoldConfirmed := false
        strategy.close_all(comment=closeSideText(closingDirection))
        exitNow := true
        activeFpiValid := false
        activeSourceKind := SOURCE_NONE
        delayedFpiReversal := false

    if cfg.forceFlatBy450 and sessionEnded and barstate.isconfirmed and strategy.position_size != 0
        int closingDirection = positionDirection()
        closedDirectionNow := closingDirection
        strategy.cancel(PROTECTION_ID)
        if recordedTradeOpen
            recordedTp := close
            float fallbackPoints = tradePoints(recordedTradeDirection, recordedEntry, close)
            sessionClosedPoints += fallbackPoints
            if recordedWindow >= 0 and recordedSlot >= 0
                writeLedgerRow(ledger, recordedWindow, recordedSlot, recordedTradeDirection, recordedEntry, recordedSl, recordedTp, fallbackPoints, false, recordedTradeOpen, recordedEntry, recordedSl, reversalModeActive, reversalModeDirection, sessionAnchorDirection)
            drawExitTriangleNow := true
            drawExitTriangleDirection := recordedTradeDirection
            drawExitTrianglePrice := close
            drawClosedTradeEntryBar := recordedEntryBar
            drawClosedTradeEntryPrice := recordedEntry
            recordedTradeOpen := false
            recordedEarlyReversal := false
            recordedNarrativeHoldConfirmed := false
        strategy.close_all(comment=closeSideText(closingDirection))
        exitNow := true
        activeFpiValid := false
        activeSourceKind := SOURCE_NONE
        delayedFpiReversal := false
        campaignHoldAnchorFound := false
        campaignHoldAnchorWindow := -1
        campaignHoldAnchorTop := na
        campaignHoldAnchorBottom := na
        fpiRequalificationWatch := false
        fpiRequalificationAcceptanceConfirmed := false
        fpiRequalificationAcceptanceBar := na

    // Resting protection: the full three-candle FPI extreme, fixed 500-point target,
    // and entry price only after 80 favorable points.
    if recordedTradeOpen and cfg.enableBot and isOneMinute and entryTimeAllowed and barstate.isconfirmed
        float protectiveStop = recordedBreakEvenArmed ? recordedEntry : recordedSl
        strategy.exit(PROTECTION_ID, from_entry=ORDER_ID, stop=protectiveStop, limit=recordedTarget, comment=recordedBreakEvenArmed ? "BREAK EVEN / 500 TP" : "FPI 3-CANDLE SL / 500 TP")

    // Centered session-wide confluence and result boxes remain beneath every ledger.
    // The confluence row reports the exact surviving stack in its economic order.
    if isOneMinute and not na(sessionPriceLow) and (inSession or sessionEnded)
        float confluenceBoxTop = sessionPriceLow - cfg.tradeTableGap - cfg.tradeTableHeight - cfg.tradeTableGap
        float confluenceBoxBottom = confluenceBoxTop - cfg.tradeTableHeight
        if drawConfluenceStatus and not na(confluenceStatusBox)
            box.set_top(confluenceStatusBox, confluenceBoxTop)
            box.set_bottom(confluenceStatusBox, confluenceBoxBottom)
            box.set_text(confluenceStatusBox, confluenceSummary(sessionAnchorDirection, sessionFpiRegime, sessionConfluenceValidCount, sessionConfluenceMasterBoundary, confluenceBoundary, confluenceValid, reversalModeActive, reversalModeDirection, validSupportIntervalCount, validResistanceIntervalCount))
            color confluenceStatusColor = reversalModeActive ? (reversalModeDirection == 1 ? color.new(#2b8a3e, 12) : color.new(#c92a2a, 12)) : sessionConfluenceHoldActive ? color.new(#0b7285, 12) : sessionFpiRegime == SESSION_REGIME_ALIGNED ? color.new(#2b8a3e, 12) : sessionFpiRegime == SESSION_REGIME_JUDAS ? color.new(#c92a2a, 12) : color.new(#495057, 12)
            box.set_bgcolor(confluenceStatusBox, confluenceStatusColor)
        if drawSessionResults and not na(sessionResultLabel)
            float openTradePoints = recordedTradeOpen and strategy.position_size != 0 ? tradePoints(recordedTradeDirection, recordedEntry, close) : 0.0
            float sessionNetPoints = sessionClosedPoints + openTradePoints
            int totalDailyTrades = dailyTradeCount(ledger)
            string sessionState = inSession ? "LIVE" : "FINAL"
            string sessionResultText = "NY SESSION  |  " + sessionState + "\nNET  " + signedPointNumber(sessionNetPoints) + " PTS  •  " + str.tostring(totalDailyTrades) + " TRADES"
            float liveSessionRange = math.max(sessionExtremeHigh - sessionExtremeLow, syminfo.mintick * 20.0)
            float liveSessionResultY = sessionExtremeHigh + liveSessionRange * 0.04
            label.set_x(sessionResultLabel, bar_index)
            label.set_y(sessionResultLabel, liveSessionResultY)
            label.set_text(sessionResultLabel, sessionResultText)
            label.set_color(sessionResultLabel, resultColor(sessionNetPoints))
        if drawSessionResults and not na(dailyTradeLogBox)
            int totalDailyTradesForLog = dailyTradeCount(ledger)
            float dailyLogTop = drawConfluenceStatus ? confluenceBoxBottom - cfg.tradeTableGap : confluenceBoxTop - cfg.tradeTableGap
            float dailyLogHeight = cfg.tradeTableHeight * math.max(2.0, 1.0 + totalDailyTradesForLog * 0.55)
            box.set_top(dailyTradeLogBox, dailyLogTop)
            box.set_bottom(dailyTradeLogBox, dailyLogTop - dailyLogHeight)
            box.set_text(dailyTradeLogBox, dailyTradeLogText(ledger))

    // -----------------------------------------------------------------------------------------------------
    // Clean execution text. Native TradingView quantity markers must be disabled in the strategy Style UI.
    // -----------------------------------------------------------------------------------------------------
    float executionTextGap = math.max((high - low) * 0.35, syminfo.mintick * 8.0)
    if cfg.showCleanTradeText and exitNow and closedDirectionNow != 0
        bool closedBuy = closedDirectionNow == 1
        label.new(x=bar_index, y=closedBuy ? high + executionTextGap : low - executionTextGap, text=closeSideText(closedDirectionNow), yloc=yloc.price, style=label.style_none, textcolor=color.new(color.black, 0), size=size.large, textalign=text.align_center)
    if cfg.showCleanTradeText and buyEntryNow
        label.new(x=bar_index, y=low - executionTextGap * (exitNow ? 2.0 : 1.0), text="BUY", yloc=yloc.price, style=label.style_none, textcolor=color.new(#2b8a3e, 0), size=size.huge, textalign=text.align_center)
    if cfg.showCleanTradeText and sellEntryNow
        label.new(x=bar_index, y=high + executionTextGap * (exitNow ? 2.0 : 1.0), text="SELL", yloc=yloc.price, style=label.style_none, textcolor=color.new(#c92a2a, 0), size=size.huge, textalign=text.align_center)
    if cfg.showCleanTradeText and campaignLegNow and not na(campaignLegPrice)
        label.new(x=bar_index, y=campaignLegPrice, text=campaignLegDirection == 1 ? "MMBM LEG" : "MMSM LEG", yloc=yloc.price, style=label.style_none, textcolor=campaignLegDirection == 1 ? color.new(#2b8a3e, 0) : color.new(#c92a2a, 0), size=size.large, textalign=text.align_center)

    if drawExecutionTriangles and drawEntryTriangleNow and drawEntryTriangleDirection != 0 and not na(drawEntryTrianglePrice)
        color entryColor = drawEntryTriangleDirection == 1 ? color.new(#2b8a3e, 0) : color.new(#c92a2a, 0)
        float entryTriangleHeight = math.max(syminfo.mintick * 12.0, math.max(high - low, syminfo.mintick * 4.0) * 0.45)
        float entryTriangleBase = drawEntryTriangleDirection == 1 ? drawEntryTrianglePrice - entryTriangleHeight : drawEntryTrianglePrice + entryTriangleHeight
        // For a buy, the upper tip is exactly the entry price. For a sell, the lower tip is exact.
        line.new(x1=bar_index - 1, y1=entryTriangleBase, x2=bar_index, y2=drawEntryTrianglePrice, xloc=xloc.bar_index, extend=extend.none, color=entryColor, width=3)
        line.new(x1=bar_index, y1=drawEntryTrianglePrice, x2=bar_index + 1, y2=entryTriangleBase, xloc=xloc.bar_index, extend=extend.none, color=entryColor, width=3)
        line.new(x1=bar_index - 1, y1=entryTriangleBase, x2=bar_index + 1, y2=entryTriangleBase, xloc=xloc.bar_index, extend=extend.none, color=entryColor, width=3)
        string entryText = (drawEntryTriangleDirection == 1 ? "BUY " : "SELL ") + priceText(drawEntryTrianglePrice)
        label.new(x=bar_index, y=drawEntryTriangleDirection == 1 ? entryTriangleBase - entryTriangleHeight * 0.20 : entryTriangleBase + entryTriangleHeight * 0.20, text=entryText, yloc=yloc.price, style=label.style_none, textcolor=entryColor, size=size.small, textalign=text.align_center)

    if drawExecutionTriangles and drawExitTriangleNow and drawExitTriangleDirection != 0 and not na(drawExitTrianglePrice)
        color exitColor = color.new(color.black, 0)
        float exitTriangleHeight = math.max(syminfo.mintick * 12.0, math.max(high - low, syminfo.mintick * 4.0) * 0.45)
        // Close-buy points down; close-sell points up. The pointed tip is the exact exit price.
        bool exitPointsUp = drawExitTriangleDirection == -1
        float exitTriangleBase = exitPointsUp ? drawExitTrianglePrice - exitTriangleHeight : drawExitTrianglePrice + exitTriangleHeight
        line.new(x1=bar_index - 1, y1=exitTriangleBase, x2=bar_index, y2=drawExitTrianglePrice, xloc=xloc.bar_index, extend=extend.none, color=exitColor, width=3)
        line.new(x1=bar_index, y1=drawExitTrianglePrice, x2=bar_index + 1, y2=exitTriangleBase, xloc=xloc.bar_index, extend=extend.none, color=exitColor, width=3)
        line.new(x1=bar_index - 1, y1=exitTriangleBase, x2=bar_index + 1, y2=exitTriangleBase, xloc=xloc.bar_index, extend=extend.none, color=exitColor, width=3)
        string exitText = (drawExitTriangleDirection == 1 ? "CLOSE BUY " : "CLOSE SELL ") + priceText(drawExitTrianglePrice)
        label.new(x=bar_index, y=exitPointsUp ? exitTriangleBase - exitTriangleHeight * 0.20 : exitTriangleBase + exitTriangleHeight * 0.20, text=exitText, yloc=yloc.price, style=label.style_none, textcolor=exitColor, size=size.small, textalign=text.align_center)

    if drawClosedTradeLines and drawExitTriangleNow and drawExitTriangleDirection != 0 and not na(drawClosedTradeEntryPrice) and not na(drawExitTrianglePrice) and not na(drawClosedTradeEntryBar)
        color pathColor = drawExitTriangleDirection == 1 ? color.new(#2b8a3e, 0) : color.new(#c92a2a, 0)
        line.new(x1=drawClosedTradeEntryBar, y1=drawClosedTradeEntryPrice, x2=bar_index, y2=drawExitTrianglePrice, xloc=xloc.bar_index, extend=extend.none, color=pathColor, style=line.style_dashed, width=2)

    if cfg.showCatalogAuditLabel and barstate.islast
        if not na(catalogAuditLabel)
            label.delete(catalogAuditLabel)
        color catalogLabelColor = not catalogAvailable ? color.new(#495057, 15) : catalogDirectionAllowed ? color.new(#2b8a3e, 10) : color.new(#c92a2a, 10)
        catalogAuditLabel := label.new(x=bar_index, y=high + math.max(high - low, syminfo.mintick * 12.0), text=catalogSummary, yloc=yloc.price, style=label.style_label_down, color=catalogLabelColor, textcolor=color.white, size=size.small)
    else if not cfg.showCatalogAuditLabel and not na(catalogAuditLabel)
        label.delete(catalogAuditLabel)
        catalogAuditLabel := na

    // Update after signal evaluation so a breakout means a confirmed close beyond
    // the session extreme that existed before this candle.
    if inSession and barstate.isconfirmed
        sessionExtremeHigh := na(sessionExtremeHigh) ? high : math.max(sessionExtremeHigh, high)
        sessionExtremeLow := na(sessionExtremeLow) ? low : math.min(sessionExtremeLow, low)

    EnigmaOutput.new(
        buyEntryNow,
        sellEntryNow,
        exitNow,
        closedDirectionNow,
        catalogAvailable,
        catalogDirectionAllowed,
        catalogDecision.approvedBias,
        catalogDecision.resolvedState,
        catalogDecision.terminalAction,
        catalogSweepEvent,
        catalogStructure,
        catalogSummary
    )
